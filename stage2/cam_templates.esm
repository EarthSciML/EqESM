                1
               ]
              },
              "pver"
             ]
            }
           ]
          },
          "md": {
           "op": "index",
           "args": [
            "md",
            {
             "op": "min",
             "args": [
              {
               "op": "+",
               "args": [
                "k",
                1
               ]
              },
              "pver"
             ]
            }
           ]
          },
          "xd": {
           "op": "index",
           "args": [
