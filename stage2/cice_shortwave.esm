  "aerosol_3bd": {
   "description": "Bulk-aerosol IOPs for the three aerosol species of this run: kaer_3bd mass extinction cross-section (m2/kg), waer_3bd single-scatter albedo, gaer_3bd asymmetry parameter, per spectral band (icepack_shortwave_data.F90:331-353, arrays (nspint_3bd, max_aero) column-major, species 1-3 of 6; only species 1..n_aero = 3 are referenced by the aerosol loop of compute_dEdd_3bd F90:2451-2547, 2605-2717).",
   "axes": [
    {
     "name": "band",
     "values": [1, 2, 3]
    },
    {
     "name": "aero",
     "values": [1, 2, 3]
    }
   ],
   "interpolation": "bilinear",
   "out_of_bounds": "clamp",
   "outputs": ["kaer", "waer", "gaer"],
