            { "op": "index", "args": ["rupdif", "b", { "op": "-", "args": ["k", 1] }] }
           ] }
          ] },
          { "op": "apply_expression_template", "args": [], "name": "dEdd_interface_refk", "bindings": {
           "rdndif": { "op": "index", "args": ["m_rdif_b", "b", { "op": "-", "args": [{ "op": "+", "args": ["klevp", 1] }, "k"] }] },
           "rupdif": { "op": "index", "args": ["rupdif", "b", { "op": "-", "args": ["k", 1] }] }
          } },
          { "op": "index", "args": ["m_tdif_b", "b", { "op": "-", "args": [{ "op": "+", "args": ["klevp", 1] }, "k"] }] }
         ] }
        ] }
       ]
      },
      "args": ["albodr", "m_rdir", "m_trnlay", "m_tdir", "rupdif", "m_rdif_b", "m_tdif_b"]
     }
    },
    {
     "lhs": "dfdir",
     "rhs": {
      "op": "faq",
      "output_idx": ["b", "k"],
      "ranges": { "b": { "from": "band" }, "k": { "from": "iface" } },
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "dEdd_dfdir",
       "bindings": {
        "trndir": { "op": "index", "args": ["trndir", "b", "k"] },
        "trntdr": { "op": "index", "args": ["trntdr", "b", "k"] },
        "rupdif": { "op": "index", "args": ["rupdif", "b", { "op": "-", "args": [{ "op": "+", "args": ["klevp", 1] }, "k"] }] },
        "rupdir": { "op": "index", "args": ["rupdir", "b", { "op": "-", "args": [{ "op": "+", "args": ["klevp", 1] }, "k"] }] },
        "rdndif": { "op": "index", "args": ["rdndif", "b", "k"] }
       }
      },
      "args": ["trndir", "trntdr", "rupdif", "rupdir", "rdndif", "klevp"]
     }
    },
    {
     "lhs": "dfdif",
     "rhs": {
      "op": "faq",
      "output_idx": ["b", "k"],
      "ranges": { "b": { "from": "band" }, "k": { "from": "iface" } },
      "expr": {
       "op": "apply_expression_template",
       "args": [],
       "name": "dEdd_dfdif",
       "bindings": {
        "trndif": { "op": "index", "args": ["trndif", "b", "k"] },
        "rupdif": { "op": "index", "args": ["rupdif", "b", { "op": "-", "args": [{ "op": "+", "args": ["klevp", 1] }, "k"] }] },
        "rdndif": { "op": "index", "args": ["rdndif", "b", "k"] }
       }
      },
      "args": ["trndif", "rupdif", "rdndif", "klevp"]
     }
    },
    {
     "lhs": "w2",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "dEdd_nir_band_weight_2",
      "bindings": { "fnidr": "fnidr" }
     }
    },
    {
     "lhs": "wght",
     "rhs": {
      "op": "faq",
      "output_idx": ["b"],
      "ranges": { "b": { "from": "band" } },
      "expr": {
       "op": "ifelse",
       "args": [
        { "op": "==", "args": ["b", 1] },
        1.0,
        { "op": "ifelse", "args": [
         { "op": "==", "args": ["b", 2] },
         "w2",
         { "op": "-", "args": [1.0, "w2"] }
        ] }
       ]
      },
      "args": ["w2"]
     }
    },
    {
     "lhs": "swdr",
     "rhs": {
      "op": "faq",
      "output_idx": ["b"],
      "ranges": { "b": { "from": "band" } },
      "expr": {
       "op": "ifelse",
       "args": [
        { "op": "==", "args": ["b", 1] },
        "swvdr",
        "swidr"
       ]
      },
      "args": ["swvdr", "swidr"]
     }
    },
    {
     "lhs": "swdf",
     "rhs": {
      "op": "faq",
      "output_idx": ["b"],
      "ranges": { "b": { "from": "band" } },
      "expr": {
       "op": "ifelse",
       "args": [
        { "op": "==", "args": ["b", 1] },
        "swvdf",
        "swidf"
       ]
      },
      "args": ["swvdf", "swidf"]
     }
    },
    {
     "lhs": "flux",
     "rhs": {
      "op": "faq",
      "output_idx": ["b", "k"],
      "ranges": { "b": { "from": "band" }, "k": { "from": "iface" } },
      "expr": {
       "op": "+",
       "args": [
        { "op": "*", "args": [
         { "op": "index", "args": ["dfdir", "b", "k"] },
         { "op": "index", "args": ["swdr", "b"] }
        ] },
        { "op": "*", "args": [
         { "op": "index", "args": ["dfdif", "b", "k"] },
         { "op": "index", "args": ["swdf", "b"] }
        ] }
       ]
      },
      "args": ["dfdir", "swdr", "dfdif", "swdf"]
     }
    },
    {
     "lhs": "ksrf",
     "rhs": { "op": "ifelse", "args": [{ "op": "==", "args": ["srftyp", 1] }, 2, { "op": "+", "args": ["N_SLYR", 3] }] }
    },
    {
     "lhs": "klevp",
     "rhs": { "op": "+", "args": ["N_SLYR", "N_ILYR", 3] }
    },
    {
     "lhs": "avdr",
     "rhs": { "op": "index", "args": ["rupdir", 1, "klevp"] }
    },
    {
     "lhs": "avdf",
     "rhs": { "op": "index", "args": ["rupdif", 1, "klevp"] }
    },
    {
     "lhs": "aidr",
     "rhs": {
      "op": "faq",
      "output_idx": [],
      "ranges": { "b": { "from": "band" } },
      "reduce": "+",
      "filter": { "op": ">=", "args": ["b", 2] },
      "expr": {
       "op": "*",
       "args": [
        { "op": "index", "args": ["rupdir", "b", "klevp"] },
        { "op": "index", "args": ["wght", "b"] }
       ]
      },
      "args": ["rupdir", "wght", "klevp"]
     }
    },
    {
     "lhs": "aidf",
     "rhs": {
      "op": "faq",
      "output_idx": [],
      "ranges": { "b": { "from": "band" } },
      "reduce": "+",
      "filter": { "op": ">=", "args": ["b", 2] },
      "expr": {
       "op": "*",
       "args": [
        { "op": "index", "args": ["rupdif", "b", "klevp"] },
        { "op": "index", "args": ["wght", "b"] }
       ]
      },
      "args": ["rupdif", "wght", "klevp"]
     }
    },
    {
     "lhs": "fthruvdr",
     "rhs": { "op": "*", "args": [{ "op": "index", "args": ["dfdir", 1, "klevp"] }, "swvdr"] }
    },
    {
     "lhs": "fthruvdf",
     "rhs": { "op": "*", "args": [{ "op": "index", "args": ["dfdif", 1, "klevp"] }, "swvdf"] }
    },
    {
     "lhs": "fthruidr",
     "rhs": {
      "op": "faq",
      "output_idx": [],
      "ranges": { "b": { "from": "band" } },
      "reduce": "+",
      "filter": { "op": ">=", "args": ["b", 2] },
      "expr": {
       "op": "*",
       "args": [
        { "op": "index", "args": ["dfdir", "b", "klevp"] },
        "swidr",
        { "op": "index", "args": ["wght", "b"] }
       ]
      },
      "args": ["dfdir", "swidr", "wght"]
     }
    },
    {
     "lhs": "fthruidf",
     "rhs": {
      "op": "faq",
      "output_idx": [],
      "ranges": { "b": { "from": "band" } },
      "reduce": "+",
      "filter": { "op": ">=", "args": ["b", 2] },
      "expr": {
       "op": "*",
       "args": [
        { "op": "index", "args": ["dfdif", "b", "klevp"] },
        "swidf",
        { "op": "index", "args": ["wght", "b"] }
       ]
      },
      "args": ["dfdif", "swidf", "wght"]
     }
    },
    {
     "lhs": "fsfc",
     "rhs": {
      "op": "faq",
      "output_idx": [],
      "ranges": { "b": { "from": "band" } },
      "reduce": "+",
      "expr": {
       "op": "*",
       "args": [
        { "op": "-", "args": [
         { "op": "index", "args": ["flux", "b", 1] },
         { "op": "index", "args": ["flux", "b", "ksrf"] }
        ] },
        { "op": "index", "args": ["wght", "b"] }
       ]
      },
      "args": ["flux", "ksrf", "wght"]
     }
    },
    {
     "lhs": "fint",
     "rhs": {
      "op": "faq",
      "output_idx": [],
      "ranges": { "b": { "from": "band" } },
      "reduce": "+",
      "expr": {
       "op": "*",
       "args": [
        { "op": "-", "args": [
         { "op": "index", "args": ["flux", "b", "ksrf"] },
         { "op": "index", "args": ["flux", "b", "klevp"] }
        ] },
        { "op": "index", "args": ["wght", "b"] }
       ]
      },
      "args": ["flux", "ksrf", "klevp", "wght"]
     }
    },
    {
     "lhs": "fthru",
     "rhs": {
      "op": "faq",
      "output_idx": [],
      "ranges": { "b": { "from": "band" } },
      "reduce": "+",
      "expr": {
       "op": "*",
       "args": [
        { "op": "index", "args": ["flux", "b", "klevp"] },
        { "op": "index", "args": ["wght", "b"] }
       ]
      },
      "args": ["flux", "klevp", "wght"]
     }
    },
    {
     "lhs": "Sabs",
     "rhs": {
      "op": "faq",
      "output_idx": ["sl"],
      "ranges": { "sl": { "from": "snow_layer" }, "b": { "from": "band" } },
      "reduce": "+",
      "expr": {
       "op": "*",
       "args": [
        { "op": "ifelse", "args": [
         { "op": "==", "args": ["srftyp", 1] },
         { "op": "-", "args": [
          { "op": "index", "args": ["flux", "b", { "op": "+", "args": ["sl", 1] }] },
          { "op": "index", "args": ["flux", "b", { "op": "+", "args": ["sl", 2] }] }
         ] },
         0.0
        ] },
        { "op": "index", "args": ["wght", "b"] }
       ]
      },
      "args": ["flux", "wght"]
     }
    },
    {
     "lhs": "Iabs",
     "rhs": {
      "op": "faq",
      "output_idx": ["il"],
      "ranges": { "il": { "from": "ice_layer" }, "b": { "from": "band" } },
      "reduce": "+",
      "expr": {
       "op": "*",
       "args": [
        { "op": "-", "args": [
         { "op": "index", "args": ["flux", "b", { "op": "ifelse", "args": [
          { "op": "and", "args": [
           { "op": "==", "args": ["srftyp", 1] },
           { "op": "==", "args": ["il", 1] }
          ] },
          { "op": "+", "args": ["N_SLYR", 2] },
          { "op": "+", "args": ["N_SLYR", 2, "il"] }
         ] }] },
         { "op": "index", "args": ["flux", "b", { "op": "ifelse", "args": [
          { "op": "and", "args": [
           { "op": "==", "args": ["srftyp", 1] },
           { "op": "==", "args": ["il", 1] }
          ] },
          { "op": "+", "args": ["N_SLYR", 4] },
          { "op": "+", "args": ["N_SLYR", 3, "il"] }
         ] }] }
        ] },
        { "op": "index", "args": ["wght", "b"] }
       ]
      },
      "args": ["flux", "wght"]
     }
    },
    {
     "lhs": "fthrul",
     "rhs": {
      "op": "faq",
      "output_idx": ["pl"],
      "ranges": { "pl": { "from": "pen_level" } },
      "expr": {
       "op": "+",
       "args": [
        { "op": "*", "args": [
         { "op": "index", "args": ["dfdir", 1, { "op": "+", "args": ["N_SLYR", 2, "pl"] }] },
         "swvdr"
        ] },
        { "op": "*", "args": [
         { "op": "index", "args": ["dfdif", 1, { "op": "+", "args": ["N_SLYR", 2, "pl"] }] },
         "swvdf"
        ] }
       ]
      },
      "args": ["dfdir", "dfdif", "swvdr", "swvdf"]
     }
    }
   ],
   "tests": [
     {
      "id": "cice_shortwave_snow",
      "description": "Snow-covered category (step 1, i=2, j=4, ncat 2, srftyp 1): hs = 0.15364 m, hi = 1.2089 m, frsnw = 290.36 um and aerosols in all four slots, so every band runs the full snow/ice column with the SNICAR snow IOPs, the chlorophyll absorption and the bulk aerosol mixing; band 3 truncates at the interface below the snow SSL (trntdr < trmin = 1e-3 there), so the layer props of layers 2..13 are guard-zeroed and feed the upward recurrence as zeros. The pins cover the layer geometry dzk and the grain-radius adjustment frsnw, the snow-table IOPs at the SSL and the bottom snow layer, the mixed tau/w0/g at the sea-ice delta layer (the kfrsnl fresnel layer), the delta-Eddington layer props at one active layer per band (including the band-3 truncated-column top layer), the downward interface chain at the top and bottom of band 1 plus the first guarded interface of bands 2 and 3 (expected 0, exercising the trmin guard), the upward chain at the top of the column (the ocean-interface values equal the band albodr constant and are not pinned), the dfdir/dfdif flux fractions, the band-weighted scalar accumulations and the Sabs/Iabs/fthrul layer absorptions. Tolerances: rel 1e-9 on the interface quantities (round-off amplification of the near-pole band-3 algebra, see README-cice-shortwave.md), rel 1e-12 elsewhere.",
