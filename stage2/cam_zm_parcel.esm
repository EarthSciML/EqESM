     "description": "parcel total water qtot at level k = the parcel_dilute new_q, the ientropy-solve rainout output (F90:1232, 1452; 0 below msg+1 = 6 where the parcel never runs; at the launch level maxi the launch total water qtp0 = q(maxi), F90:1348-1353), DUMPED (cam_zm_parcel.csv column qtot); defaults to the step-18 profile (the step-18 test runs on the defaults), [kg/kg]"
    },
    "tpert": {
     "type": "parameter",
     "units": "K",
     "default": 0.0,
     "description": "PBL temperature perturbation tpert (thermal excess, convective_departure), 0 K in this lane; dump column tpert of cam_zm_scal.csv"
    },
    "maxi": {
     "type": "parameter",
     "units": "1",
     "default": 32.0,
     "description": "launch level maxi = argmax of hmn over k >= pblt (F90:1018-1020); not expressible (argmax unevaluable in the CLI), carried as a parameter; dump column maxi (= 32 on all 15 active rows)"
    },
    "msg": {
     "type": "parameter",
     "units": "1",
     "default": 5.0,
     "description": "convection top index msg = limcnv - 1 (F90:952); the parcel loops run k = pver..msg+1 (F90:1143, 1346), so msg+1 = 6 is the lower bound of the tpv/buoy laws (below it tpv = tv and buoy = 0, the F90:1004-1007 initializations); dump column msg (= 5 on all 15 active rows)"
    },
    "lel": {
     "type": "parameter",
     "units": "1",
     "default": 15.0,
     "description": "equilibrium level lel = lelten(1) under num_cin = 1 (F90:1111-1112, 1136-1140; the first k < lcl with buoy(k+1) > 0 and buoy(k) <= 0, a min-selection over the untestable buoy); carried as a parameter; dump column lel (15, or 14 on step 40)"
    },
    "z_sfc": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "dummy lower bound of the whole-column integral rule (the CAPE integral is over d(ln p), not height; the rule's z_sfc/z_top bounds carry no weight)"
    },
    "z_top": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "dummy upper bound of the whole-column integral rule (see z_sfc)"
    },
    "cpres": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 1004.64,
     "description": "specific heat of dry air cp at constant pressure, SHR_CONST_CPDAIR, passed to zm_convr_run; dump column cpres"
    },
    "rl": {
     "type": "parameter",
     "units": "J/kg",
     "default": 2501000.0,
     "description": "latent heat of vaporization rl = LATVAP, passed to zm_convr_run; dump column rl"
    },
    "rgas": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 287.0423113650487,
     "description": "dry-air gas constant rd = RDAIR, passed to zm_convr_run (the rd of the CAPE integral, F90:1124); dump column rgas"
    },
    "eps1": {
     "type": "parameter",
     "units": "1",
     "default": 0.6219705862045155,
     "description": "molecular weight ratio MWWV/MWDAIR = eps1, passed to zm_convr_run; dump column eps1"
    },
    "tfreez": {
     "type": "parameter",
     "units": "K",
     "default": 273.15,
     "description": "freezing temperature tfreez = TKFRZ, passed to zm_convr_run; dump column tfreez"
    },
    "grav": {
     "type": "parameter",
     "units": "m/s^2",
     "default": 9.80616,
     "description": "gravitational acceleration grav, passed to zm_convr_run; dump column grav"
    },
    "cpliq": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 4188.0,
     "description": "specific heat of liquid water cpliq, passed to zm_convr_run; dump column cpliq"
    },
    "cpwv": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 1810.0,
     "description": "specific heat of water vapor cpwv, passed to zm_convr_run; dump column cpwv"
    },
    "rh2o": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 461.5046398201599,
     "description": "gas constant of water vapor rh2o = RWV, passed to zm_convr_run; dump column rh2o"
    },
    "tiedke_add": {
     "type": "parameter",
     "units": "K",
     "default": 0.5,
     "description": "parcel buoyancy offset tiedke_add = zmconv_tiedtke_add, +0.5 K (F90:1089); dump column tiedke_add"
    },
    "qst": {
     "type": "unknown",
     "units": "kg/kg",
     "shape": ["lev"],
     "description": "environment saturation specific humidity at level k, qst = zm_qsat_hPa(t, p) (qsat_hPa, F90:2634-2649), [kg/kg]; pinned to the dumped cam_zm.csv qs column at lev {25,32} and indirectly everywhere through hsat"
    },
    "hmn": {
     "type": "unknown",
     "units": "J/kg",
     "shape": ["lev"],
     "description": "moist static energy hmn = cpres t + grav z + rl q (cldprp, F90:1829; also hmn_lev of buoyan_dilute, F90:979,1018), [J/kg]; pinned against the dumped hmn"
    },
    "hsat": {
     "type": "unknown",
     "units": "J/kg",
     "shape": ["lev"],
     "description": "saturated moist static energy hsat = cpres t + grav z + rl qst (cldprp, F90:1830), [J/kg]; pinned against the dumped hsat"
    },
    "tv": {
     "type": "unknown",
     "units": "K",
     "shape": ["lev"],
     "description": "environmental virtual temperature tv = t (1 + 1.608 q)/(1 + q) (F90:1005-1006, 1088), [K]; derived-pinned at five states (not a dump column)"
    },
    "tpv": {
     "type": "unknown",
     "units": "K",
     "shape": ["lev"],
     "description": "parcel virtual temperature tpv = (tp + tpert) (1 + 1.608 qstp)/(1 + qtot) for msg+1 <= k <= maxi, else the environmental tv (F90:1415 launch, 1476 ascent, 1004-1007 init; the mask lives in the zm_parcel_virtual_temperature template body), [K]; pinned at lev {25,32} against the dumped cam_zm_parcel.csv column"
    },
    "buoy": {
     "type": "unknown",
     "units": "K",
     "shape": ["lev"],
     "description": "parcel buoyancy buoy = tpv - tv + tiedke_add for msg+1 <= k <= maxi, else 0 (F90:1088-1089; below msg+1 buoy keeps its zero initialization, F90:1006-1007; the plge600 gate of F90:1079-1080 is omitted - pl is dumped and >= 600 mb on all active rows), [K]; pinned at lev {15,18,25} against the dumped cam_zm_parcel.csv column"
    },
    "integrand": {
     "type": "unknown",
     "units": "J/kg",
     "shape": ["lev"],
     "description": "CAPE integrand rd buoy, zeroed outside lel < k <= maxi (F90:1124 with num_cin = 1 so lelten(1) = lel), [J/kg]; the lel < k bound makes the msg+1 lower bound of buoy redundant (lel >= 14)"
    },
    "dz": {
     "type": "unknown",
     "units": "1",
     "shape": ["lev"],
     "description": "free-name layer measure of the CAPE integral: d(ln p) = log(pf_hi/pf_lo) per level, dimensionless (the Fortran log(pf(k+1)/pf(k)) of F90:1124)"
    },
    "cape": {
     "type": "unknown",
     "units": "J/kg",
     "description": "convective available potential energy cape = max(0, integral of rd buoy over d(ln p) for lel < k <= maxi) (F90:1124, 1146), [J/kg]; pinned against the dumped cape (cam_zm_scal.csv), == capeten_1 of cam_zm_parcel_scal.csv under num_cin = 1 (verified)"
    },
    "ent": {
     "type": "unknown",
     "units": "J/(kg*K)",
     "shape": ["lev"],
