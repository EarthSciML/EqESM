   }
  },
  "wright_rho": {
   "description": "The Wright 1997 full-range in-situ density rho(T, S, p) in ONE application: composes the four wright_alpha0/wright_p0/wright_lambda/wright_density templates exactly as density_elem_Wright_full does (MOM_EOS_Wright_full.F90:86-89) — al0/p0/lambda are the three polynomials evaluated at the same (T, S), then rho = (p + p0)/(lambda + al0*(p + p0)) with the Fortran's operation order. The 15 fit coefficients a0..c5 are bound internally from the wright_coeff_a0..c5 constant fragments (F90:23-37), so a consuming component applies wright_rho with only its (T, S, p) triple and never redeclares the coefficients (the WrightEOS model of mom6_eos.esm declares the same values as parameters; the fragments are the single source shared by reference). Applied once per state by the KPPBLD model (surface-layer mean, layer value, and layer-1 value, all at the layer-top pressure pRef) and usable by any other in-situ-density consumer.",
   "params": [
    "T",
    "S",
    "p"
   ],
   "body": {
    "op": "apply_expression_template",
    "args": [],
    "name": "wright_density",
    "bindings": {
     "p": "p",
     "p0": {
      "op": "apply_expression_template",
      "args": [],
      "name": "wright_p0",
      "bindings": {
       "b0": {
        "op": "apply_expression_template",
        "args": [],
        "name": "wright_coeff_b0",
        "bindings": {}
       },
       "b1": {
        "op": "apply_expression_template",
        "args": [],
        "name": "wright_coeff_b1",
        "bindings": {}
       },
       "b2": {
        "op": "apply_expression_template",
        "args": [],
        "name": "wright_coeff_b2",
        "bindings": {}
       },
       "b3": {
        "op": "apply_expression_template",
        "args": [],
        "name": "wright_coeff_b3",
        "bindings": {}
       },
       "b4": {
        "op": "apply_expression_template",
        "args": [],
        "name": "wright_coeff_b4",
        "bindings": {}
       },
       "b5": {
        "op": "apply_expression_template",
        "args": [],
        "name": "wright_coeff_b5",
        "bindings": {}
       },
       "T": "T",
       "S": "S"
      }
     },
     "al0": {
      "op": "apply_expression_template",
      "args": [],
      "name": "wright_alpha0",
      "bindings": {
       "a0": {
        "op": "apply_expression_template",
        "args": [],
        "name": "wright_coeff_a0",
        "bindings": {}
       },
       "a1": {
        "op": "apply_expression_template",
