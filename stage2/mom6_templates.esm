   }
  },
  "wright_coeff_b5": {
   "description": "The Wright EOS fit parameter b5 = -8.389457e3 Pa degC-1 PSU-1 (MOM_EOS_Wright_full.F90:31). Shared by reference with mom6_eos.esm's WrightEOS (see wright_coeff_a0).",
   "params": [],
   "body": {
    "op": "const",
    "args": [],
    "value": -8389.457,
    "units": "Pa/degC/ppt"
   }
  },
  "wright_coeff_c0": {
