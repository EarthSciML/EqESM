    "args": [],
    "value": 166.0557,
    "units": "Pa/degC^3"
   }
  },
  "wright_coeff_b4": {
   "description": "The Wright EOS fit parameter b4 = 6.844158e5 Pa PSU-1 (MOM_EOS_Wright_full.F90:30). Shared by reference with mom6_eos.esm's WrightEOS (see wright_coeff_a0).",
   "params": [],
