     "description": "Snow-production heating tend_s_snwprd = rprd work2 latice (F90:214), [J/kg/s]; dump column tend_snwprd"
    },
    "tend_s_snwevmlt": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "J/(kg*s)",
     "default": 0.0,
     "description": "Snow evaporation/melt heating tend_s_snwevmlt = -(evpsnow + snowmlt) latice (F90:215), [J/kg/s]; dump column tend_snwevmlt"
    },
    "prec_gen": {
     "type": "unknown",
     "units": "kg/(m^2*s)",
     "default": 0.0,
