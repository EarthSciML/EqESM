 "models": {
  "ZMevap": {
   "expression_template_imports": [
    {
     "ref": "./cam_templates.esm"
    }
   ],
   "variables": {
    "t1": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "K",
     "default": 0.0,
     "description": "Entry temperature of the evap step, the convr-updated state t passed to zm_conv_evap_run (zm_conv_intr.F90:671-679), [K]; dump column t1"
    },
    "q1": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "kg/kg",
     "default": 0.0,
     "description": "Entry specific humidity of the evap step, [kg/kg]; dump column q1"
    },
    "pmid": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "Pa",
     "default": 0.0,
     "description": "Layer midpoint pressure, [Pa]; dump column pmid"
    },
    "pdel": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "Pa",
     "default": 0.0,
     "description": "Layer pressure thickness, [Pa]; dump column pdel"
    },
    "cldfrc": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "1",
     "default": 0.0,
     "description": "Layer cloud fraction (F90:164), [1]; dump column cldfrc"
    },
    "fsnow_conv": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "1",
     "default": 0.0,
     "description": "Convective snow-production fraction of the layer, the lower bound of the net-snow-production phase fraction work2 = max(fsnow_conv, work1) (F90:211), [1]; dump column fsnow_conv"
    },
    "rprd": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Net precipitation production of cldprp, the prdprec_gen input of F90:198 and F90:213, [kg/kg/s]; dump column rprd"
    },
    "flxprec_lo": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "kg/(m^2*s)",
     "default": 0.0,
     "description": "Precipitation flux entering the layer from above, the top-of-layer flxprec(i,k) of the per-level loop (zeroed at the top boundary, F90:118-120, updated at F90:219-224), [kg/m2/s]; dump column flxprec_lo. The recurrence boundary of the pinned per-level step (see the file description)."
    },
    "flxsnow_lo": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "kg/(m^2*s)",
     "default": 0.0,
     "description": "Snow flux entering the layer from above, the top-of-layer flxsnow(i,k) (F90:118-120, 220-224), [kg/m2/s]; dump column flxsnow_lo"
    },
    "evpvint": {
     "type": "parameter",
     "shape": [
      "lev"
     ],
     "units": "kg/(m^2*s)",
     "default": 0.0,
     "description": "Vertically integrated evaporation above the layer, the Fortran running accumulator evpvint(i) at the top of layer k (zeroed at F90:120, updated at F90:195), [kg/m2/s]. Not a dump column: derived from the dumped rprd and ntprprd columns as evpvint(k) = sum_{j<k} (rprd(j) - ntprprd(j)) pdel(j)/gravit - each increment equals evpprec(j) pdel(j)/gravit of F90:195 because ntprprd = rprd - evpprec (F90:198). Supplied as an input because the CLI rejects the coupled top-down recurrence of the flux integral (see the file description and README-cam-zm-evap.md)."
    },
    "prec_convr": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "Input precipitation rate prec (m/s) passed to zm_conv_evap_run (zm_conv_intr.F90:671-679), converted to flux units prec_gen = prec density_fresh_water at F90:111, [m/s]; dump column prec_convr"
    },
    "gravit": {
     "type": "parameter",
     "units": "m/s^2",
     "default": 9.80616,
     "description": "Gravity gravit = SHR_CONST_G (shr_const_mod.F90:21), [m/s^2]; dump constant grav"
    },
    "latvap": {
     "type": "parameter",
     "units": "J/kg",
     "default": 2501000.0,
     "description": "Latent heat of vaporization latvap = SHR_CONST_LATVAP (shr_const_mod.F90:31), [J/kg]; dump constant rl"
    },
    "latice": {
     "type": "parameter",
     "units": "J/kg",
     "default": 333700.0,
     "description": "Latent heat of fusion latice = SHR_CONST_LATICE (shr_const_mod.F90:34), [J/kg]; dump constant latice"
    },
    "tmelt": {
     "type": "parameter",
     "units": "K",
     "default": 273.15,
     "description": "Freezing temperature tmelt = tfreez = SHR_CONST_TKFRZ (shr_const_mod.F90:41), passed by zm_conv_intr.F90:671-679, [K]; dump constant tfreez"
    },
    "cpres": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 1004.64,
     "description": "Dry-air heat capacity cpres = SHR_CONST_CPDAIR (shr_const_mod.F90:36), [J/(kg*K)]; dump constant cpres"
    },
    "ke": {
     "type": "parameter",
     "units": "m/(kg^(1/2)*s^(1/2))",
     "default": 5e-06,
     "description": "The ZM evaporation coefficient ke = zmconv_ke, used as kemask = ke unconditionally (F90:160; the ke_lnd argument and landfrac are unused in this CAM version - see bugs.md), [m kg^-1/2 s^-1/2] - the effective units that make evpprec_raw = ke (1 - cldfrc) evplimit_rh sqrt(flxprec_lo) a kg/kg/s rate; the dump constant ke = 5e-6"
    },
    "deltat": {
     "type": "parameter",
     "units": "s",
     "default": 1800.0,
     "description": "Physics timestep deltat = ztodt (F90:168-170), [s]; dump constant ztodt"
    },
    "density_fresh_water": {
     "type": "parameter",
     "units": "kg/m^3",
     "default": 1000.0,
     "description": "Fresh-water density density_fresh_water = 1000 kg/m3, the kg m-2 s-1 to m s-1 conversion of F90:72 and F90:234-236, [kg/m^3]"
    },
    "es0": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "Pa",
     "default": 0.0,
     "description": "Saturation vapor pressure es0 = estblf(t1), the linear interpolation of the estbl table with the estblf clamps (wv_saturation.F90:191-254), [Pa]"
    },
    "qs": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/kg",
     "default": 0.0,
     "description": "Saturation mixing ratio qs = eps es0/(p - omeps es0) (the svp_to_qsat law of cam_templates.esm; wv_saturation.F90:264-274), [kg/kg]"
    },
    "evplimit_rh": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "1",
     "default": 0.0,
     "description": "Relative-humidity depression max(1 - q/qs, 0) of F90:158, [1]"
    },
    "evpprec_raw": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Sundqvist evaporation rate ke (1 - cldfrc) evplimit_rh sqrt(flxprec_lo) of F90:160-164, [kg/kg/s]"
    },
    "evplimit_dt": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Saturation upper bound max(0, (qs - q)/deltat) of F90:168, [kg/kg/s]"
    },
    "evplimit_flx": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Falling-flux upper bound flxprec_lo gravit/pdel of F90:173, [kg/kg/s]"
    },
    "evplimit_avail": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Remaining-precipitation upper bound (prec_gen - evpvint) gravit/pdel of F90:176, [kg/kg/s]"
    },
    "evpprec": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Layer evaporation evpprec = min(min(min(evplimit_dt, evplimit_flx), evplimit_avail), evpprec_raw) in the Fortran's nesting (F90:178), [kg/kg/s]"
    },
    "flxsntm": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(m^2*s)",
     "default": 0.0,
     "description": "Snow flux into the layer after melting: 0 where t1 > tmelt (all snow melted), flxsnow_lo otherwise (F90:128-134, old_snow = .true. at F90:108), [kg/m2/s]"
    },
    "snowmlt": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Snow melt rate flxsnow_lo gravit/pdel where t1 > tmelt, 0 otherwise (F90:128-134), [kg/kg/s]"
    },
    "work1": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "1",
     "default": 0.0,
     "description": "Snow share of the evaporated rain, work1 = min(max(0, flxsntm/flxprec_lo), 1) when flxprec_lo > 0 else 0 (F90:186-192), [1]"
    },
    "evpsnow": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
