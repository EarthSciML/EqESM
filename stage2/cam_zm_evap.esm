     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Net precipitation production ntprprd = rprd - evpprec (F90:198), [kg/kg/s]; dump column ntprprd"
    },
    "work1b": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "1",
     "default": 0.0,
     "description": "Snow fraction of the precipitation entering the layer, work1 = min(max(0, flxsnow_lo/flxprec_lo), 1) when flxprec_lo > 0 else 0 (F90:206-208), [1]"
    },
    "work2": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "1",
     "default": 0.0,
     "description": "Net-snow-production phase fraction work2 = max(fsnow_conv, work1b), zeroed when snowmlt > 0 (F90:211-212), [1]"
    },
    "ntsnprd": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Net snow production ntsnprd = rprd work2 - evpsnow - snowmlt (F90:213), [kg/kg/s]; dump column ntsnprd"
    },
    "flxprec_hi": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(m^2*s)",
     "default": 0.0,
     "description": "Precipitation flux leaving the layer, flxprec_hi = max(flxprec_lo + ntprprd pdel/gravit, 0) - the per-level step of the top-down flux integral with the roundoff guard of F90:219-224, [kg/m2/s]; dump column flxprec_hi"
    },
    "flxsnow_hi": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(m^2*s)",
     "default": 0.0,
     "description": "Snow flux leaving the layer, flxsnow_hi = max(flxsnow_lo + ntsnprd pdel/gravit, 0) (F90:220-224), [kg/m2/s]; dump column flxsnow_hi"
    },
    "tend_s": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "J/(kg*s)",
     "default": 0.0,
     "description": "Temperature tendency tend_s = -evpprec latvap + ntsnprd latice (F90:228), [J/kg/s]; dump column tend_s"
    },
    "tend_q": {
     "type": "unknown",
     "shape": [
      "lev"
     ],
     "units": "kg/(kg*s)",
     "default": 0.0,
     "description": "Moisture tendency tend_q = evpprec (F90:231), [kg/kg/s]; dump column tend_q"
