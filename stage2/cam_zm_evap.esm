    },
    "prec_evap": {
     "type": "unknown",
     "units": "m/s",
     "default": 0.0,
     "description": "Surface precipitation rate prec_evap = flxprec_hi(lev 32)/density_fresh_water, the bottom-interface flux of F90:235 converted at F90:234-236, [m/s]; dump column prec_evap"
    },
    "snow_evap": {
     "type": "unknown",
     "units": "m/s",
     "default": 0.0,
