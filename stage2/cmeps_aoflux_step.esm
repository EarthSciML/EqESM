{
 "esm": "1.3.0",
 "metadata": {
  "name": "cmeps_aoflux_step",
  "description": "One-step update of the CMEPS atmosphere-ocean stability iteration (stage 2 of the EqESM project): a single pass of the do-while of flux_atmOcn_large in cesm/flux_atmocn/flux_atmocn_Large.F90:242-290 (the Large & Pond / Large & Yeager scheme of the CESM mediator, cesm3.0-alphabranch checkout), transcribed exactly and mounted five times by reference in cmeps_aoflux.esm (top-level models.step1..step5, esm-spec section 4.7) so the 16-equation update law is authored once and the unrolled iteration is composed. Inputs are the update-invariant pointwise fields vmag/delt/delq/alz/zbot/thbot/qbot (the wind magnitude, the temperature and humidity differences, the height logarithm ln(zbot/10) and the Monin-Obukhov inputs of F90:252-254) and the water coefficient ren = 0.0346 (constant across the iteration, F90:277), the previous update's state (ustar_prev/tstar_prev/qstar_prev feeding the stability parameter and the convergence test |(ustar - ustar_prev)/ustar| <= flux_convergence = 0.01 of F90:286-287, and rdn_prev, the pre-update neutral drag used by the clamped wind shift rdw of F90:272; the heat coefficient rhn is recomputed from this update's stability each pass, F90:278, so no rhn_prev is needed), the previous convergence flag conv_prev, and the 15 previous frozen-state fields. Outputs are the 16 update states (hol, stable, xsq, xqq, psimh, psixh, rdw, u10n, rdn, rhn, rd, rh, re, ustar, tstar, qstar), this update's own convergence flag conv, and 15 frozen-state fields that pin the first-converged state (frozen_state_select: once conv_prev = 1 the frozen fields stop updating, so the 5th mount's frozen outputs are exactly the state the Fortran leaves in the iteration variables when the do-while exits, and the all-5-iterations case leaves the fresh 5th-update values). The frozen threading is required because the iteration states do not repeat after convergence (ustar_2 differs from ustar_4 at the 1.8e-4 level on the pinned rows) while the dump pins the first-converged state. The expression templates of ./cmeps_templates.esm are imported by reference."
 },
 "models": {
  "AoFluxStep": {
   "expression_template_imports": [
    { "ref": "./cmeps_templates.esm" }
   ],
   "variables": {
    "vmag": {
     "type": "parameter",
     "units": "m/s",
     "default": 2.7173990384428897,
     "description": "wind magnitude used in the update (F90:193-196), coupled from the parent for every mount, [m/s]"
    },
    "delt": {
     "type": "parameter",
     "units": "K",
     "default": -3.3865700201501454,
     "description": "potential temperature difference thbot - ts (F90:223), coupled from the parent for every mount, [K]"
    },
    "delq": {
     "type": "parameter",
     "units": "kg/kg",
     "default": -0.0022648194698895925,
     "description": "specific humidity difference qbot - ssq (F90:224), coupled from the parent for every mount, [kg/kg]"
    },
    "alz": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "ln(zbot/zref) with zref = 10 m (F90:225), coupled from the parent for every mount, [-]"
    },
    "zbot": {
     "type": "parameter",
     "units": "m",
     "default": 10.0,
     "description": "height of the lowest atmosphere model level (F90:56), used by the Monin-Obukhov stability parameter of F90:252-254, coupled from the parent for every mount, [m]"
    },
    "thbot": {
     "type": "parameter",
     "units": "K",
     "default": 271.666139623882,
     "description": "potential temperature at zbot (F90:59), used by the Monin-Obukhov stability parameter, coupled from the parent for every mount, [K]"
    },
    "qbot": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.0020241880033025007,
     "description": "specific humidity at zbot (F90:60), used by the Monin-Obukhov stability parameter, coupled from the parent for every mount, [kg/kg]"
    },
    "ren": {
     "type": "parameter",
     "units": "1",
     "default": 0.0346,
     "description": "neutral 10-m sqrt water exchange coefficient = 0.0346, constant across the iteration (F90:277), not coupled (the parent carries the same constant), [-]"
    },
    "ustar_prev": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.09959207536705793,
     "description": "previous update's friction velocity (ustar0 for the 1st mount, ustar_{k-1} for the k-th): input of the stability parameter and of the convergence test |(ustar - ustar_prev)/ustar| <= 0.01 (F90:286-287), [m/s]"
    },
