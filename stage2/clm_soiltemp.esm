 "SoilTemperature": {
  "expression_template_imports": [
   {
    "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/grid.esm",
    "bindings": {
     "NLEV": "NLEV"
    }
   },
   {
    "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/rules/varcoeff_face_laplacian_lev_flux_bc.esm",
    "bindings": {
     "NLEV": "NLEV"
    }
   }
  ],
  "variables": {
   "t_entry": {
    "type": "parameter",
    "units": "K",
    "description": "layer temperature at the ENTRY stage, the state ComputeHeatDiffFluxAndFactor, SetRHSVec_* and SetMatrix_* consume (dump column t_soisno, entry stage), reversed to the ESD lev order (ESD lev n = CLM j = 26 - n; lev 1 = the deepest soil layer j = 25, lev 34 = the top snow layer j = -8), [K]",
    "shape": [
     "lev"
    ],
    "default": 0.0
   },
   "t_exit": {
    "type": "parameter",
    "units": "K",
    "description": "layer temperature at the EXIT stage, the converged solution of the CLM tridiagonal solve (dump column t_soisno, exit stage), reversed to lev order, [K]",
    "shape": [
     "lev"
    ],
    "default": 0.0
   },
   "cv": {
    "type": "parameter",
    "units": "J/m^2/K",
    "description": "layer heat capacity per unit ground area, the SoilThermProp output (dump column cv, exit stage), reversed to lev order, [J/m2/K]",
    "shape": [
     "lev"
    ],
    "default": 0.0
   },
   "K": {
    "type": "parameter",
    "units": "W/m/K",
    "description": "interface thermal conductivity on the lev_nodes axis: K[n] = tk(26 - n) (the SoilThermProp output, dump column tk; node n is the interface between ESD layers n - 1 and n, the CLM interface zi(26 - n) below layer j = 26 - n), with K[1] = tk(25) = 0 the zero bottom boundary of SoilThermProp and K[NLEV+1] = 0 a dummy that the flux stencil never reads (the rule's face closures use the prescribed kdudz fluxes instead), [W/m/K]",
    "shape": [
     "lev_nodes"
    ],
    "default": 0.0
   },
   "ze": {
    "type": "parameter",
    "units": "m",
    "description": "interface coordinates on lev_nodes, the negated CLM interface depths below ground: ze[n] = -zi(26 - n), ze[1] = -zi(25) = -49.556 m the column bottom and ze[NLEV+1] = -zi(-8) = +22.132 m the snow surface, monotone increasing with lev as the grid requires (lev 1 = the bottom), [m]",
    "shape": [
     "lev_nodes"
    ],
    "default": 0.0
   },
   "dz": {
    "type": "parameter",
    "units": "m",
    "description": "layer thickness on lev, the dumped CLM dz(j) reversed. Supplied as a parameter rather than derived from ze on purpose: the top snow layer's (z, dz, zi) triple is internally inconsistent in the dump (bugs.md #32) and the CLM rows use the dumped dz, so the rule's finite-volume measure is fed the CLM values (deriving dz from ze would shift the top-layer L by ~0.2 W/m3 and break the row reproduction), [m]",
    "shape": [
     "lev"
    ],
    "default": 0.0
   },
   "sabg": {
    "type": "parameter",
    "units": "W/m^2",
    "description": "solar radiation absorbed in the layer (dump column sabg_lyr_col, exit stage; the NaN soil rows are read as 0). The traced run deposits solar radiation only in ESD layers 30..33 (CLM j = -4..-7); the top snow layer's absorption is inside hs_top_snow (SetRHSVec_Snow adds no sabg term to the top row), [W/m2]",
    "shape": [
     "lev"
    ],
    "default": 0.0
   },
   "hs_top_snow": {
    "type": "parameter",
    "units": "W/m^2",
    "description": "heat flux into the snow pack at the snow surface (dump column hs_top_snow, exit stage), the constant part of the top boundary flux, [W/m2]",
    "default": 0.0
   },
   "dhsdT": {
    "type": "parameter",
    "units": "W/m^2/K",
    "description": "temperature derivative of the surface heat flux (dump column dhsdT), the linear part of the top boundary flux, [W/m2/K]",
    "default": 0.0
   },
   "eflx_bot": {
    "type": "parameter",
    "units": "W/m^2",
    "description": "heat flux from beneath the soil column (dump column eflx_bot = 0 in the traced run: the CLM bottom boundary carries no geothermal flux), fn(nlevgrnd) = eflx_bot and the rule's kdudz_bot, [W/m2]",
    "default": 0.0
   },
   "cnfac": {
    "type": "parameter",
    "units": "1",
    "description": "Crank-Nicolson weighting of the CLM implicit solve (clm_varcon.F90:88; the traced run uses cnfac = 0.5), [-]",
    "default": 0.5
   },
   "capr": {
    "type": "parameter",
    "units": "1",
    "description": "top snow layer surface-flux weighting capr = 0.34 (SoilTemperatureMod.F90:86), [-]",
    "default": 0.34
   },
   "dt": {
    "type": "parameter",
    "units": "s",
    "description": "land-model time step dtime = 1800 s of the traced run, [s]",
    "default": 1800.0
   },
   "u_cn": {
    "type": "unknown",
    "units": "K",
    "description": "Crank-Nicolson weighted layer temperature u_cn = cnfac*t_entry + (1 - cnfac)*t_exit, the implicit-average state of the CLM solve; because the fluxes are linear in temperature, evaluating every interface flux at u_cn reproduces the CLM row system exactly (the identity cnfac*fn(entry) + (1 - cnfac)*fn(exit) = fn(u_cn), SetRHSVec_Soil/SetRHSVec_Snow with SetMatrix_Soil/SetMatrix_Snow), [K]",
    "shape": [
     "lev"
    ]
   },
   "du": {
    "type": "unknown",
    "units": "K",
    "description": "u_cn - t_entry, the Crank-Nicolson temperature change from the entry state, [K]",
    "shape": [
     "lev"
    ]
   },
   "zc": {
    "type": "unknown",
    "units": "m",
    "description": "layer centres, grid-derived from ze by the column_nonuniform_1d column_cell_center template: zc[n] = (ze[n] + ze[n+1])/2 = -z(26 - n) exactly (the dumped layer centre is the arithmetic mean of its interface depths), [m]",
    "shape": [
     "lev"
    ]
   },
   "A_capr": {
    "type": "unknown",
    "units": "1",
    "description": "top snow layer surface-flux weight A = 0.5*((ze[NLEV+1] - zc[NLEV]) + capr*(ze[NLEV+1] - zc[NLEV-1]))/dz[NLEV] of the CLM top-row factor, fact(-8) = dtime/cv/A (ComputeHeatDiffFluxAndFactor :1927-1928, 0.5*(z(j) - zi(j-1) + capr*(z(j+1) - zi(j-1)))/dz(j) measured from the snow surface), the capr-weighted distance of the top-layer centre from the snow surface in units of the top-layer thickness, [-]"
   },
   "L_cn": {
    "type": "unknown",
    "units": "W/m^3",
    "description": "the diffusion operator D(K*D(u_cn, lev), lev) lowered by the EarthSciDiscretizations rule varcoeff_face_laplacian_lev_flux_bc to the CLM row flux differences: L u[n] = (G[n+1] - G[n])/dz[n] with the interface fluxes G[n] = K[n]*(u[n] - u[n-1])/(zc[n] - zc[n-1]) and the prescribed face fluxes kdudz_top/kdudz_bot, so dz[n]*L_cn[n] = fn_cn(26 - n) - fn_cn(27 - n) with fn_cn the CLM interface fluxes evaluated at u_cn, [W/m3]",
    "shape": [
     "lev"
    ]
   },
   "fn_esd": {
    "type": "unknown",
    "units": "W/m^2",
    "description": "the CLM interface heat fluxes fn(j) at the ENTRY state (the dump's fn column, computed in ComputeHeatDiffFluxAndFactor :1875-1926 at t_soisno = entry: fn(j) = tk(j)*(t(j+1) - t(j))/(z(j+1) - z(j)) with fn(nlevgrnd) = eflx_bot), reversed to lev order and written fn_esd[n] = -G(t_entry, n) with G the ESD +lev-positive interface flux (the CLM fn is positive downward), [W/m2]",
    "shape": [
     "lev"
    ]
   },
   "fact_esd": {
    "type": "unknown",
    "units": "K*m^2/W",
    "description": "the CLM tridiagonal factor fact(j) = dtime/cv(j) with the top snow layer's capr-weighted factor dtime/(cv*A) (ComputeHeatDiffFluxAndFactor :1925-1928), reversed to lev order, [K m2/W]",
    "shape": [
     "lev"
    ]
   },
   "kdudz_top": {
    "type": "unknown",
    "units": "W/m^2",
    "description": "the rule's prescribed K du/dz on the snow-surface face ze[NLEV+1], positive in the +lev (upward) direction: the CLM surface flux evaluated at the CN temperature, hs_top_snow + dhsdT*(u_cn[NLEV] - t_entry[NLEV]). The top-layer residual's (1/(2A)) weighting doubles the dhsdT term and restores the CLM top row's FULLY IMPLICIT surface flux dhsdT*(t_exit - t_entry) (SetMatrix_Snow's -fact*dhsdT coefficient, not (1 - cnfac)*fact*dhsdT), [W/m2]"
   },
   "kdudz_bot": {
    "type": "unknown",
    "units": "W/m^2",
    "description": "the rule's prescribed K du/dz on the column-bottom face ze[1], positive in the +lev (upward) direction: the CLM bottom boundary flux eflx_bot (zero in the traced run), [W/m2]"
   },
   "cv_dudt": {
    "type": "unknown",
    "units": "W/m^2",
    "description": "cv*(u_cn - t_entry)/dt, the CLM row's heat-storage term at the CN temperature, [W/m2]",
    "shape": [
     "lev"
    ]
   },
   "resid": {
    "type": "unknown",
    "units": "W/m^2",
    "description": "the per-row residual of the CLM energy-balance system, in the residual form cv*du/dt - 0.5*(dz*L_cn + sabg) = 0: with the dumped entry/exit states it evaluates to round-off (max |resid| = 3.2e-10 W/m2), pinning that the dumped t_exit solves the CLM tridiagonal system exactly. Interior rows (lev 2..NLEV-1): cv*du/dt = 0.5*(dz*L_cn + sabg); the bottom row adds -eflx_bot, which combined with the eflx_bot already inside dz*L_cn[1] (through kdudz_bot) restores the row's eflx_bot; the top row is the capr-weighted surface-flux balance cv*du/dt = (1/(2A))*(dhsdT*du + dz*L_cn) with no sabg (the top-layer solar absorption is inside hs_top_snow), [W/m2]",
    "shape": [
     "lev"
    ]
   }
  },
  "equations": [
   {
    "lhs": "u_cn",
