],
     "description": "detrainment from the updraft du at level k, NORMALIZED per unit cloud-base mass flux (1/hPa; the dumped du is 1/s = du_norm*mb)"
    },
    "cape": {
     "type": "parameter",
     "units": "J/kg",
     "default": 94.22690027285716,
     "description": "parcel CAPE from buoyan_dilute, [J/kg]; dump column cape"
    },
    "tl": {
     "type": "parameter",
     "units": "K",
     "default": 286.2533464577849,
     "description": "LCL temperature tl from parcel_dilute, [K]; dump column tl"
    },
    "lel": {
     "type": "parameter",
     "units": "1",
     "default": 15.0,
     "description": "equilibrium level lel, [1]; dump column lel"
    },
    "lcl": {
     "type": "parameter",
     "units": "1",
     "default": 25.0,
     "description": "lifting condensation level lcl, [1]; dump column lcl"
    },
    "jt": {
     "type": "parameter",
     "units": "1",
     "default": 15.0,
     "description": "top of the updraft jt, [1]; dump column jt"
    },
    "mx": {
     "type": "parameter",
     "units": "1",
     "default": 32.0,
     "description": "base of the updraft (launch level) mx, [1]; dump column maxg"
    },
    "z_sfc": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "dummy lower bound of the whole-column integral rule (dadt integrates over the layer thickness measure dz; the rule's z_sfc/z_top bounds carry no weight)"
    },
    "z_top": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "dummy upper bound of the whole-column integral rule (see z_sfc)"
    },
    "eps1": {
     "type": "parameter",
     "units": "1",
     "default": 0.6219705862045155,
     "description": "molecular weight ratio MWWV/MWDAIR, passed to closure; dump column eps1"
    },
    "rgas": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 287.0423113650487,
     "description": "dry-air gas constant rd, passed to closure; dump column rgas"
    },
    "grav": {
     "type": "parameter",
     "units": "m/s^2",
     "default": 9.80616,
     "description": "gravitational acceleration grav, passed to closure; dump column grav"
    },
    "cpres": {
     "type": "parameter",
     "units": "J/(kg*K)",
     "default": 1004.64,
     "description": "specific heat of dry air cp, passed to closure; dump column cpres"
    },
    "rl": {
     "type": "parameter",
     "units": "J/kg",
     "default": 2501000.0,
     "description": "latent heat of vaporization rl, passed to closure; dump column rl"
    },
    "capelmt": {
     "type": "parameter",
     "units": "J/kg",
     "default": 70.0,
     "description": "CAPE threshold capelmt of the closure (the mb = 0 branch fires below it); dump column capelmt"
    },
    "tau": {
     "type": "parameter",
     "units": "s",
     "default": 3600.0,
     "description": "closure timescale tau; dump column tau"
    },
    "dp": {
     "type": "unknown",
     "units": "hPa",
     "shape": ["lev"],
     "description": "layer pressure thickness dp = 0.01*pdel (mb), the README-cam-zm working identity dp = 0.01*pdel (pdel dumped in Pa), [hPa]"
    },
    "dp_subcld": {
     "type": "unknown",
     "units": "hPa",
     "shape": ["lev"],
     "description": "masked subcloud-layer pressure thickness dp_subcld = dp for k >= mx, else 0 (the F90:597-603 dsubcld summand), [hPa]"
    },
    "dsubcld": {
     "type": "unknown",
     "units": "hPa",
     "description": "subcloud-layer pressure thickness dsubcld = sum of dp over k >= mx (F90:597-603), [hPa]; carried as the whole-column integral of dp_subcld under the trivial measure dz = 1; pinned against the dumped column (exact on all 15 rows; with mx = 32 = pver the sum collapses to dp(32))"
    },
    "t_mx": {
     "type": "unknown",
     "units": "K",
     "description": "launch-level temperature t(mx) = tg at k = mx, [K]; the t(i,mx(i)) of the closure"
    },
    "q_mx": {
     "type": "unknown",
     "units": "kg/kg",
     "description": "launch-level specific humidity q(mx) = qg at k = mx, [kg/kg]; the q(i,mx(i)) of the closure"
    },
    "p_mx": {
     "type": "unknown",
     "units": "hPa",
     "description": "launch-level pressure p(mx) = pg at k = mx, [hPa]; the p(i,mx(i)) of the closure"
    },
    "eb": {
     "type": "unknown",
     "units": "hPa",
     "description": "launch-level vapor pressure eb = p(mx) q(mx)/(eps1 + q(mx)) (F90:2401), [hPa]"
    },
    "dtbdt": {
     "type": "unknown",
     "units": "K/hPa",
     "description": "subcloud-layer temperature change dtbdt = (mu(mx) (shat(mx) - su(mx)) + md(mx) (shat(mx) - sd(mx)))/dsubcld (F90:2402-2403), per unit cloud-base mass flux, [K/hPa]"
    },
    "dqbdt": {
     "type": "unknown",
     "units": "1/hPa",
     "description": "subcloud-layer humidity change dqbdt = (mu(mx) (qhat(mx) - qu(mx)) + md(mx) (qhat(mx) - qd(mx)))/dsubcld (F90:2404-2405), per unit cloud-base mass flux, [1/hPa]"
    },
    "debdt": {
     "type": "unknown",
     "units": "1",
     "description": "subcloud-layer vapor-pressure change debdt = eps1 p(mx)/(eps1 + q(mx))^2 dqbdt (F90:2406), [1]"
    },
    "dtldt": {
     "type": "unknown",
     "units": "K/hPa",
     "description": "LCL temperature change dtldt = -2840 (3.5/t(mx) dtbdt - debdt/eb)/(3.5 log(t(mx)) - log(eb) - 4.805)^2 (F90:2407-2410), per unit cloud-base mass flux, [K/hPa]; the logs are of the dimensionless ratios t(mx)/1K and eb/1hPa"
    },
    "dtmdt_jt": {
     "type": "unknown",
     "units": "K/hPa",
     "shape": ["lev"],
     "description": "cumulus heating at the updraft top dtmdt at k = jt from the interface fluxes (F90:2423-2425), zero elsewhere, [K/hPa]"
    },
    "dtmdt_mid": {
     "type": "unknown",
     "units": "K/hPa",
     "shape": ["lev"],
     "description": "cumulus heating in the updraft interior jt < k < mx (F90:2432-2435 with beta = 0, F90:2433), zero elsewhere, [K/hPa]"
    },
    "dtmdt": {
     "type": "unknown",
     "units": "K/hPa",
     "shape": ["lev"],
     "description": "cumulus heating dtmdt = dtmdt_jt + dtmdt_mid (the two Fortran loops write disjoint level sets, k = jt and jt < k < mx), [K/hPa]"
    },
    "dqmdt_jt": {
     "type": "unknown",
     "units": "1/hPa",
     "shape": ["lev"],
     "description": "cumulus drying at the updraft top dqmdt at k = jt (F90:2426-2428), zero elsewhere, [1/hPa]"
    },
    "dqmdt_mid": {
     "type": "unknown",
     "units": "1/hPa",
     "shape": ["lev"],
     "description": "cumulus drying in the updraft interior jt < k < mx (F90:2436-2446 with beta = 0), zero elsewhere, [1/hPa]"
    },
    "dqmdt": {
     "type": "unknown",
     "units": "1/hPa",
     "shape": ["lev"],
     "description": "cumulus drying dqmdt = dqmdt_jt + dqmdt_mid, [1/hPa]"
    },
    "thetavp_above": {
     "type": "unknown",
     "units": "K",
     "shape": ["lev"],
     "description": "parcel virtual potential temperature thetavp in the LCL-to-... branch lel <= k <= lcl (F90:2457), zero elsewhere, [K]"
    },
    "thetavp_below": {
     "type": "unknown",
     "units": "K",
     "shape": ["lev"],
     "description": "parcel virtual potential temperature thetavp in the below-LCL branch lcl < k < mx (F90:2474), zero elsewhere, [K]"
    },
    "thetavp": {
     "type": "unknown",
     "units": "K",
     "shape": ["lev"],
     "description": "parcel virtual potential temperature thetavp = thetavp_above + thetavp_below over lel <= k < mx (the union of the two branches), [K]"
    },
    "thetavm": {
     "type": "unknown",
     "units": "K",
     "shape": ["lev"],
     "description": "environmental virtual potential temperature thetavm = t (1000/p)^(rd/cp) (1 + 0.608 q) (F90:2462, 2480), zeroed outside lel <= k < mx (the levels the Fortran branches write; the same law in both branches; the region guard lives in the zm_theta_v_env template body), [K]"
    },
    "dqsdtp": {
     "type": "unknown",
     "units": "1/K",
     "shape": ["lev"],
     "description": "d(qs)/dT of the parcel dqsdtp in the above-LCL branch (F90:2458), zero elsewhere, [1/K]"
    },
    "dtpdt": {
     "type": "unknown",
     "units": "K/hPa",
     "shape": ["lev"],
     "description": "parcel temperature change dtpdt in the above-LCL branch (F90:2460-2462), zero elsewhere, [K/hPa]"
    },
    "dboydt_above": {
     "type": "unknown",
     "units": "m/(s^2*hPa)",
     "shape": ["lev"],
     "description": "CAPE-change integrand dboydt in the above-LCL branch lel <= k <= lcl (F90:2464-2468), zero elsewhere, [m/(s^2 hPa)]"
    },
    "dboydt_below": {
     "type": "unknown",
     "units": "m/(s^2*hPa)",
     "shape": ["lev"],
     "description": "CAPE-change integrand dboydt in the below-LCL branch lcl < k < mx (F90:2482-2485), zero elsewhere, [m/(s^2 hPa)]"
    },
    "dboydt": {
     "type": "unknown",
     "units": "m/(s^2*hPa)",
     "shape": ["lev"],
     "description": "CAPE-change integrand dboydt = dboydt_above + dboydt_below over lel <= k < mx, [m/(s^2 hPa)]"
    },
    "dz": {
     "type": "unknown",
     "units": "1",
     "shape": ["lev"],
     "description": "trivial layer measure of the closure integrals, dz = 1 per level: the ESD whole-column integral rule's free name dz binds by consumer variable name, and the two integrals (dsubcld, dadt) share the one imported rule, so the layer weight (zf_lo - zf_hi) of the Fortran dadt summand (F90:2498) is carried in the integrand dadt_integrand instead, [1]"
    },
    "dadt_integrand": {
     "type": "unknown",
     "units": "m^2/(s^2*hPa)",
     "shape": ["lev"],
     "description": "buoyant-energy integrand dadt_integrand = dboydt (zf_lo - zf_hi), the literal Fortran dadt summand (F90:2498), with the layer weight explicit because the integral measure is the trivial dz = 1, [m^2/(s^2 hPa)]"
    },
    "dadt": {
     "type": "unknown",
     "units": "m^2/(s^2*hPa)",
     "description": "buoyant energy change dadt = integral of dadt_integrand (F90:2490-2499; dboydt is zero outside lel <= k < mx, so the whole-column integral equals the Fortran sum), [m^2/(s^2 hPa)]"
    },
    "mb": {
     "type": "unknown",
     "units": "hPa/s",
     "description": "cloud-base mass flux mb = max((capelmt - cape)/(tau dadt), 0), zero when dadt = 0 (F90:2500-2503: dltaa = -(cape - capelmt), mb = max(dltaa/tau/dadt, 0)), [hPa/s]; pinned against the dumped mb from the normalized fluxes (worst rel 2.5e-16)"
    }
   },
   "equations": [
    {
     "lhs": "dp",
     "rhs": {
      "op": "*",
