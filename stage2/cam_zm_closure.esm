     "description": "net convective mass flux mc = mu + md at level k, NORMALIZED (dimensionless; dumped mc/mb)"
    },
    "du": {
     "type": "parameter",
     "units": "1/hPa",
     "shape": ["lev"],
     "default": [
 0.0,
