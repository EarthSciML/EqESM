       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "separated_streams_passthrough",
     "description": "Synthetic separated-streams row (separates_rain_snow = 1): Faxa_rainl = prrn = 2e-5, Faxa_snowl = prsn = 1e-5 kg/m2/s, the combined prec ignored (datm_datamode_jra_mod.F90:297-299; the branch is inactive in the C_JRA_t62 case, whose datm_jra_streams.csv carries separates_rain_snow = 0 with prrn = prsn = 1e30 spval).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
