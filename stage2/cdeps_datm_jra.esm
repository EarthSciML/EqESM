 },
 "models": {
  "Streams": {
   "expression_template_imports": [
    {
     "ref": "./cdeps_templates.esm"
    }
   ],
   "variables": {
    "lb": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "stream value at the lower time bound on the model grid after the spatial map (fldbun_data(LB)), [field units] (the field's own units vary per stream; the law is unit-agnostic)"
    },
    "ub": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "stream value at the upper time bound (fldbun_data(UB)), [field units] (the field's own units vary per stream; the law is unit-agnostic)"
    },
    "flb": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "time-interpolation factor on lb (linear: (t_ub - t_q)/(t_ub - t_lb); nearest/lower: 1 or 0; coszen: cosz/tavCosz, unused at night)"
    },
    "fub": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "time-interpolation factor on ub (linear: 1 - flb; nearest/upper: 0 or 1; coszen: 0, unused)"
    },
    "day": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "coszen day/night flag: 1 when cosz > 0.001 (the traced rows; all polar day at the traced T62 points on Jan 1), 0 at night when the law zeroes the value"
    },
    "value": {
     "type": "unknown",
     "units": "1",
     "description": "the interpolated stream value written into fldbun_model and consumed by the datamode, [field units] (the field's own units vary per stream; the law is unit-agnostic)"
    }
   },
   "equations": [
    {
     "lhs": "value",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "stream_interp",
      "bindings": {
       "lb": "lb",
       "ub": "ub",
       "flb": "flb",
       "fub": "fub",
       "day": "day"
      }
     }
    }
   ],
   "tests": [
    {
     "id": "linear_day",
     "description": "Synthetic linear-interpolation row: value = flb*lb + fub*ub = 0.25*10 + 0.75*20 = 17.5 (shr_strdata_advance, dshr_strdata_mod.F90:1292-1391; flb+fub = 1).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 10.0,
      "ub": 20.0,
      "flb": 0.25,
      "fub": 0.75,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 17.5,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "coszen_day",
     "description": "Synthetic coszen daytime row: value = lb*flb = 100*0.8 = 80 with fub = 0 (the flb factor IS cosz/tavCosz; cf. the traced swdn rows of cdeps_strdata_streams_jra.csv).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 100.0,
      "ub": 200.0,
      "flb": 0.8,
      "fub": 0.0,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 80.0,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "night_zero",
     "description": "Synthetic coszen night row: the law zeroes the value when the day flag is 0 (true cosz <= 0.001, dshr_strdata_mod.F90:1350-1365), regardless of the factors.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 100.0,
      "ub": 200.0,
      "flb": 0.8,
      "fub": 0.0,
      "day": 0.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "nearest_ub",
     "description": "Synthetic nearest-interpolation row: value = ub when flb = 0, fub = 1 (shr_strdata_advance nearest tintalgo).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 10.0,
      "ub": 20.0,
      "flb": 0.0,
      "fub": 1.0,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 20.0,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "traced_coszen_swdn_step0_point1",
     "description": "Traced coszen row (cdeps_strdata_streams_jra.csv step 0, ns 3 Faxa_swdn, n = 1): value = lb*flb with fub = 0 - the dumped flb IS cosz/tavCosz = 0.996590623955609711 (shr_strdata_advance + shr_tInterp_getCosz; the traced T62 points are polar-day on Jan 1).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 414.4862310585743,
      "ub": 430.8879545374925,
      "flb": 0.9965906239556097,
      "fub": 0.0,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 413.07309163167355,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "traced_linear_t10_step11_point16",
     "description": "Traced linear row (cdeps_strdata_streams_jra.csv step 11, ns 6 Sa_tbot, n = 16): value = flb*lb + fub*ub with flb = 1/3, fub = 2/3 (flb+fub = 1) - the t_10 stream of the JRA case (tintalgo linear).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "lb": 253.96881437924108,
      "ub": 253.97974865055187,
      "flb": 0.3333333333333333,
      "fub": 0.6666666666666667,
      "day": 1.0
     },
     "assertions": [
      {
       "variable": "value",
       "time": 0.0,
       "expected": 253.97610389344828,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    }
   ]
  },
  "Jra": {
   "expression_template_imports": [
    {
     "ref": "./cdeps_templates.esm"
    }
   ],
   "variables": {
    "strm_tbot": {
     "type": "parameter",
     "units": "K",
     "default": 280.0,
     "description": "interpolated 10-m air temperature stream value (t_10 -> Sa_tbot), datm.streams.xml stream_variables of the C_JRA_t62 case"
    },
    "strm_pslv": {
     "type": "parameter",
     "units": "Pa",
     "default": 100000.0,
     "description": "interpolated sea-level pressure stream value (slp -> Sa_pslv)"
    },
    "strm_u": {
     "type": "parameter",
     "units": "m/s",
     "default": 5.0,
     "description": "interpolated 10-m zonal wind stream value (u_10 -> Sa_u)"
    },
    "strm_v": {
     "type": "parameter",
     "units": "m/s",
     "default": -3.0,
     "description": "interpolated 10-m meridional wind stream value (v_10 -> Sa_v)"
    },
    "strm_shum": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.005,
     "description": "interpolated 10-m specific humidity stream value (q_10 -> Sa_shum); passes through unchanged - the JRA datamode has no qsat cap"
    },
    "strm_prec": {
     "type": "parameter",
     "units": "kg/m^2/s",
     "default": 0.0001,
     "description": "interpolated combined precipitation flux (prec -> Faxa_prec), split by the tbot < TKFRZ step test when separates_rain_snow = 0"
    },
    "strm_prrn": {
     "type": "parameter",
     "units": "kg/m^2/s",
     "default": 1e+30,
     "description": "interpolated separate rainfall flux (1e30 spval, SHR_CONST_SPVAL, when the prrn/prsn stream pair is absent, i.e. separates_rain_snow = 0)"
    },
    "strm_prsn": {
     "type": "parameter",
     "units": "kg/m^2/s",
     "default": 1e+30,
     "description": "interpolated separate snowfall flux (1e30 spval when absent)"
    },
    "strm_lwdn": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 300.0,
     "description": "interpolated downward longwave radiation (lwdn -> Faxa_lwdn)"
    },
    "strm_swdn": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 300.0,
     "description": "interpolated downward shortwave radiation (swdn -> Faxa_swdn), coszen-tintalgo stream"
    },
    "separates_rain_snow": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "1 when the prrn/prsn stream pair is associated (the datamode then passes the two through to Faxa_rainl/Faxa_snowl), else 0 (the datamode splits strm_prec by the tbot < TKFRZ test); the C_JRA_t62 case has no separate streams (datm_jra_streams.csv separates_rain_snow = 0)"
    },
    "lat": {
     "type": "parameter",
     "units": "deg",
     "default": -90.0,
     "description": "model-mesh latitude yc (degrees) of the traced point (datm_jra_exports.csv lat column; the T62 Gaussian mesh of the C_JRA_t62 case)"
    },
    "rain_frac": {
     "type": "unknown",
     "units": "1",
     "description": "rain fraction of the combined-precip split: 1 when tbot >= TKFRZ else 0 (the step function of datm_datamode_jra_advance, F90:301-307)"
    },
    "avg_alb": {
     "type": "unknown",
     "units": "1",
     "description": "LY08 latitudinally-varying surface albedo avg_alb = r4(0.069) - r4(0.011)*cos(2*lat*degtorad) (F90:317 with the UNSUFFIXED single-precision literals 0.069/0.011, see bugs.md; datm_jra_exports.csv avg_alb column)"
    },
    "Sa_z": {
     "type": "unknown",
     "units": "m",
     "description": "reference height of the surface state, constant 10 m (F90:285)"
    },
    "Sa_u": {
     "type": "unknown",
     "units": "m/s",
     "description": "10-m zonal wind export (F90:278)"
    },
    "Sa_v": {
     "type": "unknown",
     "units": "m/s",
     "description": "10-m meridional wind export (F90:279)"
    },
    "Sa_u10m": {
     "type": "unknown",
     "units": "m/s",
     "description": "zonal wind at 10 m, a copy of Sa_u (F90:288)"
    },
    "Sa_v10m": {
     "type": "unknown",
     "units": "m/s",
     "description": "meridional wind at 10 m, a copy of Sa_v (F90:289)"
    },
    "Sa_tbot": {
     "type": "unknown",
     "units": "K",
     "description": "surface air temperature export (F90:276)"
    },
    "Sa_ptem": {
     "type": "unknown",
     "units": "K",
     "description": "potential temperature export, a copy of Sa_tbot (F90:277)"
    },
    "Sa_shum": {
     "type": "unknown",
     "units": "kg/kg",
     "description": "surface specific humidity export, a copy of the stream value (F90:280)"
    },
    "Sa_dens": {
     "type": "unknown",
     "units": "kg/m^3",
     "description": "surface air density pbot/(rdair*tbot*(1 + qcoef*shum)) with qcoef = r4(0.608) = 0.6079999804496765 (F90:292, the UNSUFFIXED single-precision literal 0.608, see bugs.md)"
    },
    "Sa_pbot": {
     "type": "unknown",
     "units": "Pa",
     "description": "surface pressure export, a copy of strm_pslv (F90:275)"
    },
    "Sa_pslv": {
     "type": "unknown",
     "units": "Pa",
     "description": "sea-level pressure export, a copy of strm_pslv (F90:274)"
    },
    "Faxa_rainc": {
     "type": "unknown",
     "units": "kg/m^2/s",
     "description": "convective rain flux, identically 0 in this datamode (F90:295)"
    },
    "Faxa_rainl": {
     "type": "unknown",
     "units": "kg/m^2/s",
     "description": "large-scale rain flux: the prrn passthrough (separated streams) or prec*rain_frac (F90:297-307)"
    },
    "Faxa_snowc": {
     "type": "unknown",
     "units": "kg/m^2/s",
     "description": "convective snow flux, identically 0 in this datamode (F90:296)"
    },
    "Faxa_snowl": {
     "type": "unknown",
     "units": "kg/m^2/s",
     "description": "large-scale snow flux: the prsn passthrough (separated streams) or prec*(1 - rain_frac) (F90:297-307)"
    },
    "Faxa_swndr": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "direct near-infrared shortwave, 0.31*swdn (F90:311)"
    },
    "Faxa_swndf": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "diffuse near-infrared shortwave, 0.17*swdn (F90:314)"
    },
    "Faxa_swvdr": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "direct visible shortwave, 0.28*swdn (F90:310)"
    },
    "Faxa_swvdf": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "diffuse visible shortwave, 0.24*swdn (F90:313)"
    },
    "Faxa_swnet": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "net surface shortwave swdn*(1 - avg_alb) (F90:318)"
    },
    "Faxa_swdn": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "downward shortwave export, a copy of the stream value (F90:281)"
    },
    "Faxa_lwdn": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "downward longwave export, a copy of the stream value (F90:282)"
    }
   },
