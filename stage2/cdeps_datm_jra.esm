       "time": 0.0,
       "expected": 1e-05,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "density_round",
     "description": "Synthetic density row: Sa_dens = pbot/(rdair*tbot*(1 + qcoef*shum)) = 100000/(287.0423113650487*280*(1 + 0.6079999804496765*0.005)) with rdair = SHR_CONST_RDAIR and qcoef = r4(0.608) = 0.6079999804496765 - the JRA55 moisture coefficient is an UNSUFFIXED single-precision literal in the Fortran (datm_datamode_jra_mod.F90:292; see bugs.md), and even the exact r8 0.608 would differ in the 8th decimal, so this law differs in the 8th decimal from the CLMNCEP density template.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "strm_pslv": 100000.0,
      "strm_tbot": 280.0,
      "strm_shum": 0.005
     },
     "assertions": [
      {
       "variable": "Sa_dens",
       "time": 0.0,
       "expected": 1.2404458136038392,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "Sa_pbot",
       "time": 0.0,
       "expected": 100000.0,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "Sa_pslv",
       "time": 0.0,
       "expected": 100000.0,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "albedo_pole_sw_split",
     "description": "Synthetic polar row (lat = 90 deg, the T62 traced points sit at the pole row): avg_alb = r4(0.069) - r4(0.011)*cos(2*90*degtorad) = 0.07999999821186066, Faxa_swnet = swdn*(1 - avg_alb) = 300*0.9200000017881393 = 276.0000005364418 W/m2 - the 0.069/0.011 coefficients are UNSUFFIXED single-precision literals in the Fortran (datm_datamode_jra_mod.F90:317; see bugs.md) - and the fixed split Faxa_swvdr/ndr/vdf/ndf = swdn*0.28/0.31/0.24/0.17 (datm_datamode_jra_mod.F90:310-313, exact _R8 literals).",
