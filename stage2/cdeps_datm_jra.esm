   "tests": [
    {
     "id": "all_snow_step",
     "description": "Synthetic combined-precip row below freezing: tbot = 253.15 K < TKFRZ = 273.15 K -> rain_frac = 0, Faxa_rainl = 0, Faxa_snowl = prec = 1e-4 kg/m2/s, rainc = snowc = 0 (datm_datamode_jra_mod.F90:301-307; the step split, distinct from the CLMNCEP smooth ramp).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "strm_tbot": 253.15,
      "strm_prec": 0.0001,
      "separates_rain_snow": 0.0
     },
     "assertions": [
      {
       "variable": "rain_frac",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "Faxa_rainl",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "Faxa_snowl",
       "time": 0.0,
       "expected": 0.0001,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "Faxa_rainc",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "Faxa_snowc",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "all_rain_step",
     "description": "Synthetic combined-precip row at/above freezing: tbot = 283.15 K >= TKFRZ -> rain_frac = 1, Faxa_rainl = prec, Faxa_snowl = 0 (datm_datamode_jra_mod.F90:301-307).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "strm_tbot": 283.15,
      "strm_prec": 0.0001,
