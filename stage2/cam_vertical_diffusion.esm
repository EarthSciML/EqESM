    },
   "tauy": {
    "type": "parameter",
    "units": "kg/(m*s^2)",
    "default": 0.0,
    "description": "surface meridional stress tauy (per-step dump column tauy)"
    },
   "ksrftms": {
    "type": "parameter",
    "units": "kg/(m^2*s)",
    "default": 0.0,
    "description": "turbulent-mountain-stress surface drag coefficient ksrftms, added to ksrf by turbulent_mountain_stress_add_drag_coefficient_run (diffusion_stubs.F90:161-184); zero in the window"
    },
   "ksrfmin": {
    "type": "parameter",
    "units": "kg/(m^2*s)",
    "default": 1e-04,
    "description": "minimum surface drag coefficient ksrfmin = 1.e-4 kg/(m2 s) (diffusion_solver.F90:44): the floor that keeps the implicit-surface-stress damping rate at pver nonzero even when the turbulent stress vanishes"
    },
   "wsmin": {
    "type": "parameter",
    "units": "m/s",
    "default": 1.0,
    "description": "minimum lowest-level wind speed wsmin = 1 m/s for estimating the frictional velocity (diffusion_solver.F90:42)"
    },
   "ksrf": {
    "type": "unknown",
    "units": "kg/(m^2*s)",
    "description": "total surface drag coefficient ksrf = ksrftms + max(tau/ws, ksrfmin) of implicit_surface_stress_add_drag_coefficient_run (diffusion_solver.F90:232-239), the surface_stress_coefficient law; = ksrfmin in the window (taux = tauy = ksrftms = 0)"
    },
