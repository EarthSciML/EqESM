      315139.3088646416, 315814.349563606, 316988.9249309061, 319648.0537169, 324170.9181130199, 328084.1997595133,
      331210.14153627044, 332986.65185315924, 334320.8829223958, 335403.22004100477, 336507.7781546821, 339000.7250139721,
