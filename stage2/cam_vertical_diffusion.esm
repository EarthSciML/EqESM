   "tauresx_enter": {
    "type": "parameter",
    "units": "Pa",
    "default": 0.00014478837360691117,
    "description": "residual stress entering the step (the value the solver injects at pver, diffusion_solver.F90:491); step 1 is the observed pbuf initial (0 at nstep==0, provenance unexplained); steps >= 2 the previous step's updated tauresx"
    },
   "tauresy_enter": {
    "type": "parameter",
    "units": "Pa",
    "default": 0.0005519501195026867,
    "description": "meridional residual stress entering the step"
    },
   "ramda": {
    "type": "unknown",
    "units": "1",
    "description": "dt/timeres: the fraction of the residual stress injected this step, the am_correction = .false. branch of diffusion_solver.F90:491-496 (timeres = 7200 s, dt = 1800 s in the run; = 0.25)"
    },
   "g": {
    "type": "parameter",
    "units": "m/s^2",
    "default": 9.80616,
    "description": "gravity (gravit)"
    },
   "dt": {
    "type": "parameter",
    "units": "s",
    "default": 1800.0,
    "description": "physics timestep (ztodt)"
    },
   "timeres": {
    "type": "parameter",
    "units": "s",
    "default": 7200.0,
    "description": "relaxation timescale of the residual stress, the timeres namelist of the implicit-surface-stress branch (diffusion_solver.F90:495); 7200 s in the run, so ramda = dt/timeres = 0.25"
    },
   "shflux": {
    "type": "parameter",
    "units": "kg/s^3",
    "default": 0.0,
    "description": "surface sensible heat flux shflx (W/m^2); zero in the window, so src_s = 0"
    },
   "cflx": {
    "type": "parameter",
    "units": "kg/(m^2*s)",
    "default": 0.0,
    "description": "surface constituent flux (kg/m2/s), explicit q surface source"
    },
   "dryfac": {
    "type": "parameter",
    "units": "1",
    "default": 1.0,
    "description": "pdel(32)/pdeldry(32) tendency conversion for dry constituents (1 for moist), diffusion_solver.F90:1056-1061"
    },
   "tauimpx_f": {
    "type": "unknown",
    "units": "1",
    "shape": [
     "lev"
     ],
    "description": "zonal net-stress integrand (u-u0)/(g*dt) (bound to a named observed: the integral rule's where clause matches only a bare layer field)"
    },
   "tauimpy_f": {
    "type": "unknown",
    "units": "1",
    "shape": [
     "lev"
     ],
    "description": "meridional net-stress integrand (v-v0)/(g*dt)"
    },
   "tauimpx": {
    "type": "unknown",
    "units": "Pa",
    "description": "net zonal stress added this step, integral of tauimpx_f over the column (usum_out - usum_in)/dt, diffusion_solver.F90:557-568"
    },
   "tauimpy": {
    "type": "unknown",
    "units": "Pa",
    "description": "net meridional stress added this step"
    },
   "tauresx": {
    "type": "unknown",
    "units": "Pa",
    "description": "updated residual stress tauresx = tauresx_enter + taux - tauimpx + tautmsx + taubljx (F90:580-584; taux = tautmsx = taubljx = 0 in the window); dump column tauresx"
    },
   "tauresy": {
    "type": "unknown",
    "units": "Pa",
    "description": "updated meridional residual stress; dump column tauresy"
    },
   "kdudz_bot": {
    "type": "parameter",
    "default": 0.0,
    "description": "the ESD flux rule's prescribed surface value of K du/dz; zero in the window (taux = tauy = shflux = 0; the q surface flux enters as the explicit source src_q). Declared without units on purpose (ysu.esm idiom): the rule subtracts this one name inside every field's flux row, so it must be unit-polymorphic"
    },
   "kdudz_top": {
    "type": "parameter",
    "default": 0.0,
    "description": "the ESD flux rule's prescribed top value of K du/dz; zero (the CAM solve's default fixed-flux top; the dse solve's BoundaryFixedLayer(0)/dse_top flux is 2 K(1) (dse_top - s(1))/del(1), which vanishes at the window's kvh(1) = 0, dse_top = 0). Units omitted for the same reason as kdudz_bot"
    },
   "zero": {
    "type": "parameter",
    "default": 0.0,
    "description": "units-free zero bound into the surface_layer_source and wind_damping_rate template applications (the checker requires ifelse branches to share dimensions and the four sources carry different units; a units-free declaration is dimension-agnostic, the ysu.esm idiom of the kdudz_bot/kdudz_top names)"
    },
   "src_u": {
    "type": "unknown",
    "units": "m/s^2",
    "shape": [
     "lev"
     ],
    "description": "surface momentum source g*tauresx_enter*ramda/dz[1] at lev 1, 0 elsewhere (the pver injection f2s*taures*ramda/pdel, F90:491-499)"
    },
   "src_v": {
    "type": "unknown",
