    },
    "bot_level": {
     "type": "parameter",
     "units": "1",
     "default": 32.0,
     "shape": [
      "site"
     ],
     "description": "ptend%bot_level of each call in dump (TOA-first) level indexing (cam_phys_tend.csv column bot_level); the full column (1, 32) at every active site, [1]."
    },
    "win": {
     "type": "unknown",
     "units": "1",
     "default": 0.0,
     "shape": [
      "site",
      "lev"
     ],
     "description": "the per-call [top_level, bot_level] update window in model (surface-first) indices: win(s, k) = 1 for NLEV+1-bot_level(s) <= k <= NLEV+1-top_level(s), [1]."
    },
    "dudt": {
     "type": "unknown",
     "units": "m/s^2",
     "default": 0.0,
     "shape": [
      "lev"
     ],
     "description": "the accumulated tend%dudt over the call sequence: sum over sites of lu*win*ptend_u (F90:287-295), [m/s^2]."
    },
    "dvdt": {
     "type": "unknown",
     "units": "m/s^2",
     "default": 0.0,
     "shape": [
      "lev"
     ],
     "description": "the accumulated tend%dvdt over the call sequence: sum over sites of lv*win*ptend_v (F90:296-301), [m/s^2]."
    },
    "dtdt": {
     "type": "unknown",
     "units": "K/s",
