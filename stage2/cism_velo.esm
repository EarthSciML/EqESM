   ]
  },
  "DivaVelocity": {
   "expression_template_imports": [
    {
     "ref": "./cism_templates.esm"
    }
   ],
   "variables": {
    "uvel_2d": {
     "type": "parameter",
     "units": "m/yr",
     "default": 0.0,
     "description": "depth-integrated (DIVA) x velocity at the vertex, the solution of the 2-D solve (cism_velo.csv uvel_2d, solver units; the recovery law uvel_basal = uvel_2d*beta_eff/beta_internal is pinned against it)"
    },
    "vvel_2d": {
     "type": "parameter",
     "units": "m/yr",
     "default": 0.0,
     "description": "depth-integrated (DIVA) y velocity at the vertex (cism_velo.csv vvel_2d)"
    },
    "uvel_basal": {
     "type": "parameter",
     "units": "m/yr",
     "default": 0.0,
     "description": "basal x velocity at the vertex, uvel(11) (cism_velo.csv uvel_011, the last accepted solve result; the input to the mounted BasalTraction - the Fortran's calcbeta argument ubas/vbas, F90:844, and the anchor of the 3-D profile)"
    },
    "vvel_basal": {
     "type": "parameter",
     "units": "m/yr",
     "default": 0.0,
     "description": "basal y velocity at the vertex, vvel(11) (cism_velo.csv vvel_011)"
    },
    "f_ground": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "grounded ice fraction at the vertex (cism_velo.csv f_ground; 1 on every traced row of the reference run): beta_internal = f_ground*beta, the calcbeta weighting of glissade_basal_traction.F90:595-630"
    },
    "beta_raw": {
     "type": "parameter",
     "units": "Pa yr/m",
     "default": 0.0,
     "description": "basal friction coefficient of the mounted BasalTraction (the pseudo-plastic beta of glissade_calcbeta, which_ho_babc = 3), driven by the coupling edge from BasalTraction.beta (param_to_var); evaluated at the basal velocity uvel_basal/vvel_basal and the bed/N_stag of the vertex"
    },
    "omega": {
     "type": "parameter",
     "units": "m/(Pa yr)",
     "default": 0.0,
     "description": "staggered double integral at the vertex (cism_velo_nbr.csv stag_omega, the dumped stag_omega column): the omega of the beta_eff law"
    },
    "stag_omega_k": {
     "type": "parameter",
     "units": "m/(Pa yr)",
     "shape": [
      "lev_nodes"
     ],
     "default": 0.0,
     "description": "single integral staggered to the vertex at each velocity level (cism_velo_nbr.csv stag_omega_k_001..011): the per-level stagger of omega_k is a grid operation deferred to stage 3, so the staggered field enters as a dumped input; level 11 (the bed) is 0 on every traced row, which makes the profile formula reduce to uvel(11) = uvel_basal at the bed"
    },
    "theta_x": {
     "type": "parameter",
     "units": "rad",
     "default": 0.0,
     "description": "x-direction slope angle at the vertex (cism_velo_nbr.csv stag_theta_slope_x; produced by DivaGeometry, fed from the dump in the stage-2 tests)"
    },
    "theta_y": {
     "type": "parameter",
     "units": "rad",
     "default": 0.0,
     "description": "y-direction slope angle at the vertex (cism_velo_nbr.csv stag_theta_slope_y)"
    },
    "F_x": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "DIVA slope correction factor in x at the vertex (cism_velo_nbr.csv stag_diva_slope_factor_x; produced by DivaGeometry)"
    },
    "F_y": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "DIVA slope correction factor in y at the vertex (cism_velo_nbr.csv stag_diva_slope_factor_y)"
    },
    "beta_internal": {
     "type": "unknown",
     "units": "Pa yr/m",
     "description": "basal friction coefficient as consumed by the solve: beta_internal = f_ground*beta_raw (the calcbeta f_ground weighting, F90:595-630; the dumped beta_internal column holds the last ACCEPTED calcbeta pass of the Picard loop, so the chain is pinned at rel 1e-5)"
    },
    "beta_eff_x": {
     "type": "unknown",
     "units": "Pa yr/m",
     "description": "effective basal friction in x: beta_eff_x = F_x*beta_internal/(F_x + beta_internal*omega*cos(theta_x)) (cism_beta_eff, F90:2589-2601, Goldberg 2011 eq. 40-41 with the May 2025 slope correction; the dumped beta_eff_x column)"
    },
    "beta_eff_y": {
     "type": "unknown",
     "units": "Pa yr/m",
     "description": "effective basal friction in y: beta_eff_y = F_y*beta_internal/(F_y + beta_internal*omega*cos(theta_y)) (the dumped beta_eff_y column)"
    },
    "uvel_basal_recovered": {
     "type": "unknown",
     "units": "m/yr",
     "description": "the 3-D recovery law of Goldberg (2011) eq. 34: uvel(nz) = uvel_2d*beta_eff_x/beta_internal (F90:5800-5801); equals the input uvel_basal to within the Picard chain error"
    },
    "vvel_basal_recovered": {
     "type": "unknown",
     "units": "m/yr",
     "description": "the y recovery law: vvel(nz) = vvel_2d*beta_eff_y/beta_internal (F90:5801)"
    },
    "btractx": {
     "type": "unknown",
     "units": "Pa",
     "description": "basal traction in x: btractx = beta_internal*uvel_basal = beta_eff_x*uvel_2d (F90:3874 and F90:5780, Goldberg 2011 eq. 38-39; the dumped btractx column)"
    },
    "btracty": {
     "type": "unknown",
     "units": "Pa",
     "description": "basal traction in y: btracty = beta_internal*vvel_basal = beta_eff_y*vvel_2d (the dumped btracty column)"
    },
    "slope_corr_x": {
     "type": "unknown",
     "units": "1",
     "description": "x slope correction of the vertical shear: cos(theta_x)/F_x (the Fortran slope_correction_x, F90:5935)"
    },
    "slope_corr_y": {
     "type": "unknown",
     "units": "1",
     "description": "y slope correction of the vertical shear: cos(theta_y)/F_y (F90:5936)"
    },
    "uvel": {
     "type": "unknown",
     "units": "m/yr",
     "shape": [
      "lev_nodes"
     ],
     "description": "3-D x velocity profile: uvel[k] = uvel_basal + btractx*stag_omega_k[k]*slope_corr_x (Goldberg 2011 eq. 32 with the slope correction, F90:5804-5815; the dumped uvel_001..011 columns; at the bed level 11 the formula reduces to uvel_basal since stag_omega_k(11) = 0)"
    },
    "vvel": {
     "type": "unknown",
     "units": "m/yr",
     "shape": [
      "lev_nodes"
     ],
     "description": "3-D y velocity profile: vvel[k] = vvel_basal + btracty*stag_omega_k[k]*slope_corr_y (the dumped vvel_001..011 columns)"
    }
   },
   "equations": [
    {
     "lhs": "beta_internal",
     "rhs": {
      "op": "*",
      "args": [
       "f_ground",
       "beta_raw"
      ]
     }
    },
    {
     "lhs": "beta_eff_x",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "cism_beta_eff",
      "bindings": {
       "F": "F_x",
       "beta": "beta_internal",
       "omega": "omega",
       "theta": "theta_x"
      }
     }
    },
    {
     "lhs": "beta_eff_y",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "cism_beta_eff",
      "bindings": {
       "F": "F_y",
       "beta": "beta_internal",
       "omega": "omega",
       "theta": "theta_y"
      }
     }
    },
    {
     "lhs": "uvel_basal_recovered",
     "rhs": {
      "op": "/",
      "args": [
       {
        "op": "*",
        "args": [
         "uvel_2d",
         "beta_eff_x"
        ]
       },
       "beta_internal"
      ]
     }
    },
    {
     "lhs": "vvel_basal_recovered",
     "rhs": {
      "op": "/",
      "args": [
       {
        "op": "*",
        "args": [
         "vvel_2d",
         "beta_eff_y"
        ]
       },
       "beta_internal"
      ]
     }
    },
    {
     "lhs": "btractx",
     "rhs": {
      "op": "*",
      "args": [
       "beta_internal",
       "uvel_basal"
      ]
     }
    },
    {
     "lhs": "btracty",
     "rhs": {
      "op": "*",
      "args": [
       "beta_internal",
       "vvel_basal"
      ]
     }
    },
    {
     "lhs": "slope_corr_x",
     "rhs": {
      "op": "/",
      "args": [
       {
        "op": "cos",
        "args": [
         "theta_x"
        ]
       },
       "F_x"
      ]
     }
    },
    {
     "lhs": "slope_corr_y",
     "rhs": {
      "op": "/",
      "args": [
       {
        "op": "cos",
        "args": [
         "theta_y"
        ]
       },
       "F_y"
      ]
     }
    },
    {
     "lhs": "uvel",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "k"
      ],
      "args": [
       "stag_omega_k"
      ],
      "ranges": {
       "k": {
        "from": "lev_nodes"
       }
      },
      "expr": {
       "op": "+",
       "args": [
        "uvel_basal",
        {
         "op": "*",
         "args": [
          "btractx",
          {
           "op": "*",
           "args": [
            {
             "op": "index",
             "args": [
              "stag_omega_k",
              "k"
             ]
            },
            "slope_corr_x"
           ]
          }
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": "vvel",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "k"
      ],
      "args": [
       "stag_omega_k"
      ],
      "ranges": {
       "k": {
        "from": "lev_nodes"
       }
      },
      "expr": {
       "op": "+",
       "args": [
        "vvel_basal",
        {
         "op": "*",
         "args": [
          "btracty",
          {
           "op": "*",
           "args": [
            {
             "op": "index",
             "args": [
              "stag_omega_k",
              "k"
             ]
            },
            "slope_corr_y"
           ]
          }
         ]
        }
       ]
      }
     }
    }
   ],
   "tests": [
    {
     "id": "velo_step1_cell2511",
     "description": "Dump pin, cism_velo.csv / cism_velo_nbr.csv step 1, cell (25,11): the thin-ice vertex (thck_sw = 1.37 m) on the steepest slope (theta_x = 0.0316 rad, F_x = 1.003). The chain: the mounted BasalTraction at the exit basal velocity (u = 0.06066, v = -0.00893 m/yr, bed = 538.05 m, N_stag = 2.39e5 Pa) gives beta_internal = 8.07e4 Pa yr/m; beta_eff_x = F*beta/(F + beta*omega*cos(theta)) = 7.72e4; the recovery uvel_basal = uvel_2d*beta_eff/beta_internal returns the input basal velocity; btractx = beta_internal*uvel_basal = 4.89e3 Pa; and the 3-D profile uvel[k] = uvel_basal + btractx*stag_omega_k[k]*cos(theta)/F spans 0.0610 (surface) down to the basal value. All assertions at rel 1e-5: the dumped beta_internal is the last ACCEPTED calcbeta pass of the Picard loop, whose velocity iterate differs from the exit basal velocity by the final Picard correction - the law at the exit velocity is exact to worst 6.04e-7 over the 128 exit rows (the stated numerical reason; every other law in the chain is exact given the dumped beta_internal, verified at 1e-12 in the extractor).",
