       }
      },
      "expr": {
       "op": "ifelse",
       "args": [
        {
         "op": "==",
         "args": [
          "ice_mask",
          1.0
         ]
        },
        {
         "op": "*",
         "args": [
          0.25,
          {
           "op": "+",
           "args": [
            {
             "op": "index",
             "args": [
