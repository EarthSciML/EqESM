     "description": "land fraction of the atm grid cell (FBFrac(compatm) lfrac), the land weight of every lnd2atm merge (mrg_fracname_lnd2atm_state = 'lfrac' of med_internalstate_mod.F90:289-290), [-]"
    },
    "ifrac": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "ice fraction of the atm grid cell (FBFrac(compatm) ifrac), the ice weight of every lnd2atm merge (the 'ifrac' of the addmrg specs), [-]"
    },
    "ofrac": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "open-ocean fraction of the atm grid cell (FBFrac(compatm) ofrac), the ocean weight of every lnd2atm merge (the 'ofrac' of the addmrg specs), [-]"
