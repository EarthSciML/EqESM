    }
   },
   "equations": [
    {
     "lhs": "Sx_avsdr",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "fraction_weighted_sum",
      "bindings": {
       "ice_value": {
        "op": "apply_expression_template",
        "args": [],
        "name": "fraction_weighted_sum",
        "bindings": {
         "ice_value": "Sl_avsdr",
         "open_value": "Si_avsdr",
         "ice_frac": "lfrac",
         "open_frac": "ifrac"
        }
       },
       "open_value": "So_avsdr",
       "ice_frac": {
        "op": "const",
        "args": [],
        "value": 1.0,
        "units": "1"
       },
       "open_frac": "ofrac"
      }
     }
    },
    {
     "lhs": "Sx_avsdf",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
      "name": "fraction_weighted_sum",
      "bindings": {
       "ice_value": {
        "op": "apply_expression_template",
        "args": [],
        "name": "fraction_weighted_sum",
        "bindings": {
         "ice_value": "Sl_avsdf",
         "open_value": "Si_avsdf",
         "ice_frac": "lfrac",
         "open_frac": "ifrac"
        }
       },
       "open_value": "So_avsdf",
       "ice_frac": {
        "op": "const",
        "args": [],
        "value": 1.0,
        "units": "1"
       },
       "open_frac": "ofrac"
      }
     }
    },
    {
     "lhs": "Sx_anidr",
     "rhs": {
      "op": "apply_expression_template",
      "args": [],
