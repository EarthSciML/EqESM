    "description": "McICA stochastic subcolumn cloud indicator (0/1) per g-point and esd level (dump cam_rad_solver_sw.csv cld_sto, lev reversed); an RNG output of mcica_subcol_gen_sw.f90 (permuteseed = 1, single column), out of scope, carried as an input"
    },
   "tauc_sto": {
    "type": "unknown",
    "units": "1",
    "shape": ["gpt", "lev"],
    "description": "subcolumn optical depth tauc_sto = cld_sto*tau(band(gpt)) (mcica_subcol_gen_sw.f90:439-444, the mcica_subcolumn template with fill 0 over the band_gather of tau)"
    },
   "ssac_sto": {
    "type": "unknown",
    "units": "1",
    "shape": ["gpt", "lev"],
    "description": "subcolumn single-scattering albedo ssac_sto = cld_sto*ssa(band(gpt)) + (1-cld_sto) (the clear-sky fill is 1)"
    },
   "asmc_sto": {
    "type": "unknown",
    "units": "1",
    "shape": ["gpt", "lev"],
    "description": "subcolumn asymmetry factor asmc_sto = cld_sto*asm(band(gpt)) (fill 0)"
    },
   "fsfc_sto": {
    "type": "unknown",
    "units": "1",
    "shape": ["gpt", "lev"],
    "description": "subcolumn forward-scatter fraction fsfc_sto = cld_sto*fsfc(band(gpt)) (fill 0)"
    }
   },
  "equations": [
   {
