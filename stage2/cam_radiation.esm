 "CamRadSolin": {
  "expression_template_imports": [],
  "variables": {
   "sfac": {
    "type": "parameter",
    "units": "1",
    "shape": ["band"],
    "default": [
      0.9930878982211978,0.994466593497209,0.9986585151370867,0.9996050030436655,1.00507150586941,
      1.0062629449689149,1.0076054407353665,1.0019837395518234,0.9955454289721368,0.9938937369081854,
      0.9872473202939728,0.9175026071630408,0.9342312366768494,1.0273557559560724
     ],
    "description": "solar facular modulation per band (sfac(1:nbndsw), radsw.F90:395-397, dimensionless solar-cycle factor; dump cam_rad_scal.csv sfac_b1..b14)"
    },
   "solar_band_irrad": {
    "type": "parameter",
    "units": "W/m^2",
    "shape": ["band"],
    "default": [12.11, 20.3600000000001, 23.73, 22.43, 55.63, 102.93, 24.29, 345.74, 218.19, 347.2, 129.49, 50.15, 3.08, 12.89],
    "description": "band-averaged solar irradiances of radconstants.F90:34-40 (sum = 1368.22 W/m2), the solar_band_irrad(:) used by radsw.F90:395-397"
    },
   "eccf": {
    "type": "parameter",
    "units": "1",
    "default": 0.9686709151493066,
    "description": "earth-orbit eccentricity factor of the solar constant (radsw.F90:395-397; dump cam_rad_scal.csv eccf)"
    },
   "coszrs": {
    "type": "parameter",
    "units": "1",
    "default": 0.13082862620925734,
    "description": "cosine of the solar zenith angle at the column (radsw.F90:395-397; dump cam_rad_scal.csv coszrs; day steps only -- the night solin = 0 branch is not pinned)"
    },
   "solin": {
    "type": "unknown",
    "units": "W/m^2",
    "description": "top-of-atmosphere incident solar flux solin = sum_b sfac_b*solar_band_irrad_b * eccf * coszrs (radsw.F90:395-397, the band sum a faq + reduction over the band axis)"
    }
   },
  "equations": [
   {
    "lhs": "solin",
    "rhs": {
     "op": "*",
     "args": [
      {
       "op": "faq",
       "output_idx": [],
       "reduce": "+",
       "ranges": {"b": {"from": "band"}},
       "args": [],
       "expr": {
        "op": "*",
        "args": [
         {"op": "index", "args": ["sfac", "b"]},
         {"op": "index", "args": ["solar_band_irrad", "b"]}
         ]
        }
       },
      "eccf",
      "coszrs"
      ]
     }
    }
   ],
  "tests": [
