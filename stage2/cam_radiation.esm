  "equations": [
   {
    "lhs": "pint_hi",
    "rhs": {
     "op": "apply_expression_template",
     "args": [],
     "name": "edge_shift",
     "bindings": {
      "lo": "pint_lo",
      "sfc": "pint_sfc",
      "n": {"op": "+", "args": ["NK", -1]},
      "kset": "k"
      }
     }
    },
   {
    "lhs": "T_ifc_hi",
    "rhs": {
     "op": "apply_expression_template",
     "args": [],
     "name": "edge_shift",
     "bindings": {
      "lo": "T_ifc_lo",
      "sfc": "T_ifc_sfc",
      "n": {"op": "+", "args": ["NK", -1]},
      "kset": "k"
      }
     }
    },
   {
    "lhs": "pmid",
    "rhs": {
     "op": "faq",
     "output_idx": ["kk"],
     "ranges": {"kk": {"from": "k"}},
     "args": [],
     "expr": {
      "op": "ifelse",
      "args": [
       {"op": "==", "args": ["kk", 1]},
       {
        "op": "*",
        "args": [
         {"op": "const", "args": [], "value": 0.5, "units": "1"},
         {"op": "index", "args": ["pint_hi", 1]}
         ]
        },
       {
        "op": "*",
        "args": [
         {"op": "const", "args": [], "value": 0.5, "units": "1"},
         {
          "op": "+",
          "args": [
           {"op": "index", "args": ["pint_lo", "kk"]},
           {"op": "index", "args": ["pint_hi", "kk"]}
           ]
          }
         ]
        }
       ]
      }
     }
    },
   {
    "lhs": "h2ovmr",
    "rhs": {
     "op": "*",
     "args": [
      {
       "op": "/",
       "args": [
        "q_H2O",
        {
         "op": "-",
         "args": [
          {"op": "const", "args": [], "value": 1.0, "units": "1"},
          "q_H2O"
          ]
         }
        ]
       },
      "amdw"
      ]
     }
    },
   {
    "lhs": "cfc22vmr",
    "rhs": {"op": "const", "args": [], "value": 0.0, "units": "mol/mol"}
    },
   {
    "lhs": "ccl4vmr",
    "rhs": {"op": "const", "args": [], "value": 0.0, "units": "mol/mol"}
    }
   ],
  "tests": [
   {
    "id": "step3",
    "description": "cam_rad_input.csv rows (step 3, k = 1..33, RRTMG layer top-down): the rrtmg_state_create laws of rrtmg_state.F90:60-247 pinned at the extra layer (k=1), top CAM layer (k=2), mid column (k=17) and surface layer (k=33): pmid(1) = 0.5*pint_hi(1), pmid(k) = 0.5*(pint_lo+pint_hi) (F90:126,140), the shared edges pint_hi(k) = pint_lo(k+1) and T_ifc_hi(k) = T_ifc_lo(k+1) (k <= 32; the surface edges pint_hi(33)/T_ifc_hi(33) are inputs), h2ovmr = (q/(1-q))*amdw (F90:47,198) and the cfc22vmr = ccl4vmr = 0 configuration zeroing (F90:222-223).",
    "time_span": {"start": 0.0, "end": 0.0},
    "initial_conditions": {},
    "parameter_overrides": {},
    "assertions": [
