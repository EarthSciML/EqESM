             "vicen",
             "vvel"
            ]
           }
          ],
          "wrt": "y"
         }
        ]
       }
      ]
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "vsnon"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "-",
      "args": [
       {
        "op": "+",
        "args": [
         {
          "op": "D",
          "args": [
           {
            "op": "*",
            "args": [
             "vsnon",
             "uvel"
            ]
           }
          ],
          "wrt": "x"
         },
         {
          "op": "D",
