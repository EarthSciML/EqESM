   "tests": [
    {
     "id": "dump_zero_s1_l16",
     "description": "cam_phys_tend.csv row (step 1, site rayleigh, lev 16): the run's namelist has raytau0 = 0, so rayleigh_friction_run returns zero tendencies before the profile (rayleigh_friction.F90:113-115); the dumped ptend_u/ptend_v/ptend_s at this state (u = 0.59679870398157597, v = -8.0061501266860073 m/s, the strongest wind of the column) are all 0.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "u": 0.596798703981576,
      "v": -8.006150126686007,
      "k": 16.0,
      "raytau0": 0.0
     },
     "assertions": [
      {
       "variable": "dudt",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-12,
        "abs": 1e-24
       }
      },
      {
       "variable": "dvdt",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-12,
        "abs": 1e-24
       }
      },
      {
       "variable": "dsdt",
       "time": 0.0,
       "expected": 0.0,
       "tolerance": {
        "rel": 1e-12,
        "abs": 1e-24
       }
      }
     ]
    },
