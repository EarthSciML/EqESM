{
 "esm": "1.3.0",
 "metadata": {
  "name": "mom6_vertical_diffusion",
  "description": "MOM6 implicit vertical tracer diffusion (tracer_vertdiff_Eulerian no-sink branch, MOM_tracer_diabatic.F90:384-413; ent computed in MOM_diabatic_driver.F90:1728-1739) written as the PDE dT/dt = d/dz (Kd dT/dz) for each tracer, discretized by the EarthSciDiscretizations rule varcoeff_face_laplacian_lev_flux_bc with zero prescribed face fluxes. The rule's lowering (G[n] = Kd[n](u[n]-u[n-1])/(zc[n]-zc[n-1]), L[ell] = (G[ell+1]-G[ell])/dz[ell], zero face fluxes) is exactly the MOM6 tridiagonal law h_k (u'_k - u_k) = ent_k (u'_{k-1} - u'_k) + ent_{k+1} (u'_{k+1} - u'_k) with ent = dt Kd/dz_int; the PDE's h divides out through the cell measure. The esd column reverses the MOM6 top-down order: esd lev ell <-> MOM6 layer NLEV+1-ell, esd interface n <-> MOM6 interface NLEV+2-n, ze increasing upward from the bottom (ze[1] = -H) to the surface (ze[NLEV+1] = 0). T and S are carried separately because Kd_heat != Kd_salt on most dumped interfaces (10-36 per column, up to ~50%; the dump contradicts the claim of README-mom6-w2.md that they are equal). Pinned to rows of stage1/dumps/mom6/mom6_diabatic_tri.csv (see README-mom6-vertdiff.md; tuples extracted by stage1/analysis/extract_mom6_vertdiff_tuples.py).",
  "license": "MIT",
  "tags": ["mom6", "ocean", "vertical-diffusion", "tracer", "stage2", "pde"]
 },
 "metaparameters": {
  "NLEV": {"type": "integer", "default": 75, "description": "MOM6 layer count (E3SM ne30pg2 ocean: 75 z-star levels)"}
 },
 "models": {
  "TridiagonalMixing": {
   "expression_template_imports": [
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/grid.esm",
     "only": ["column_cell_center", "column_cell_thickness"],
     "bindings": {"NLEV": "NLEV"}
    },
    {
     "ref": "${ESD_ROOT}/grids/column_nonuniform_1d/rules/varcoeff_face_laplacian_lev_flux_bc.esm",
     "bindings": {"NLEV": "NLEV"}
    },
    {
     "ref": "mom6_templates.esm",
     "only": ["interface_entrainment", "tridiagonal_residual"]
    }
   ],
   "variables": {
    "ze": {"type": "parameter", "units": "m", "shape": ["lev_nodes"], "description": "interface depths, ze[1] = -H bottom .. ze[NLEV+1] = 0 surface (row A of mom6_diabatic_tri.csv by default)"},
    "Kd_heat": {"type": "parameter", "units": "m^2/s", "shape": ["lev_nodes"], "description": "interface heat diffusivity (Kd_heat_01..76 reversed)"},
    "Kd_salt": {"type": "parameter", "units": "m^2/s", "shape": ["lev_nodes"], "description": "interface salt diffusivity (Kd_salt_01..76 reversed)"},
    "dt": {"type": "parameter", "units": "s", "default": 3600.0, "description": "coupling step of the dumped row"},
    "T_before": {"type": "parameter", "units": "degC", "shape": ["lev"], "description": "entering potential temperature (T_before_01..75 reversed)"},
    "S_before": {"type": "parameter", "units": "g/kg", "shape": ["lev"], "description": "entering salinity (S_before_01..75 reversed)"},
    "kdudz_bot": {"type": "parameter", "default": 0.0, "description": "units-free zero bottom face flux (cam idiom; T and S fluxes carry different units)"},
    "kdudz_top": {"type": "parameter", "default": 0.0, "description": "units-free zero surface face flux"},
    "zero": {"type": "parameter", "default": 0.0, "description": "units-free zero for the template boundary branches"},
    "T": {"type": "unknown", "units": "degC", "shape": ["lev"], "description": "potential temperature after the vertical mixing step (T_after_01..75 reversed; the solve's output, used here as the initial condition so the operator can be evaluated on it)"},
    "S": {"type": "unknown", "units": "g/kg", "shape": ["lev"], "description": "salinity after the vertical mixing step (S_after_01..75 reversed)"},
    "zc": {"type": "unknown", "units": "m", "shape": ["lev"], "description": "cell-center depths from column_cell_center"},
    "dz": {"type": "unknown", "units": "m", "shape": ["lev"], "description": "cell thicknesses from column_cell_thickness"},
    "ent": {"type": "unknown", "units": "m", "shape": ["lev_nodes"], "description": "heat interface entrainment dt*Kd_heat/dz_int, zero on the faces (interface_entrainment)"},
    "ent_s": {"type": "unknown", "units": "m", "shape": ["lev_nodes"], "description": "salt interface entrainment dt*Kd_salt/dz_int, zero on the faces"},
    "ptend_T": {"type": "unknown", "units": "degC/s", "shape": ["lev"], "description": "heat operator dT/dt = D(Kd_heat*D(T,lev),lev) (the rule's lowering)"},
    "ptend_S": {"type": "unknown", "units": "g/kg/s", "shape": ["lev"], "description": "salt operator dS/dt = D(Kd_salt*D(S,lev),lev)"},
    "tri_res_T": {"type": "unknown", "units": "degC*m", "shape": ["lev"], "description": "tridiagonal residual for T: dz*(T-T_before) - ent*(T[nlev-1]-T[nlev]) - ent*(T[nlev+1]-T[nlev])"},
    "tri_res_S": {"type": "unknown", "units": "g/kg*m", "shape": ["lev"], "description": "tridiagonal residual for S"}
   },
   "equations": [
    {"lhs": "zc", "rhs": {"op": "apply_expression_template", "args": [], "name": "column_cell_center", "bindings": {"ze": "ze"}}},
    {"lhs": "dz", "rhs": {"op": "apply_expression_template", "args": [], "name": "column_cell_thickness", "bindings": {"ze": "ze"}}},
    {"lhs": "ent", "rhs": {"op": "apply_expression_template", "args": [], "name": "interface_entrainment", "bindings": {"Kd": "Kd_heat", "dt": "dt", "ze": "ze", "nlev_max": {"op": "+", "args": ["NLEV", 1]}, "zero": "zero"}}},
    {"lhs": "ent_s", "rhs": {"op": "apply_expression_template", "args": [], "name": "interface_entrainment", "bindings": {"Kd": "Kd_salt", "dt": "dt", "ze": "ze", "nlev_max": {"op": "+", "args": ["NLEV", 1]}, "zero": "zero"}}},
    {"lhs": "ptend_T", "rhs": {"op": "D", "args": [{"op": "*", "args": ["Kd_heat", {"op": "D", "args": ["T"], "wrt": "lev"}]}], "wrt": "lev"}},
    {"lhs": "ptend_S", "rhs": {"op": "D", "args": [{"op": "*", "args": ["Kd_salt", {"op": "D", "args": ["S"], "wrt": "lev"}]}], "wrt": "lev"}},
    {"lhs": "tri_res_T", "rhs": {"op": "apply_expression_template", "args": [], "name": "tridiagonal_residual", "bindings": {"dz": "dz", "ent": "ent", "u": "T", "u0": "T_before", "nlev_max": {"op": "+", "args": ["NLEV", 1]}, "zero": "zero"}}},
    {"lhs": "tri_res_S", "rhs": {"op": "apply_expression_template", "args": [], "name": "tridiagonal_residual", "bindings": {"dz": "dz", "ent": "ent_s", "u": "S", "u0": "S_before", "nlev_max": {"op": "+", "args": ["NLEV", 1]}, "zero": "zero"}}},
    {"lhs": {"op": "D", "args": ["T"], "wrt": "t"}, "rhs": "ptend_T"},
    {"lhs": {"op": "D", "args": ["S"], "wrt": "t"}, "rhs": "ptend_S"}
   ],
   "tests": [
    {
     "id": "rowA_convective_tod32400_gi3_gj79",
     "description": "Dump row (tod=32400, gi=3, gj=79, dt=3600 s): deep convection, ent ~ 3.6e6 m on MOM6 interfaces 61-75 (esd 2-16), mixed layers 70-71 (esd 5-6). T/S-differing diffusivity exercised at esd interface 28 (MOM6 49): ent_T=1.0067 vs ent_S=1.0109. Expected ptend = (T_after - T_before)/dt from the dump columns (derived, not a dump column). At the deep convective layers the dumped T'/S' satisfy the discrete identity only to the solve's round-off amplified by ent ~ 3.6e6 (scaled residual <= 1.4e-16, dump-wide maxima 1.2e-12 T / 2.0e-12 S of validate_mom6_w2.py), hence rel 1e-3 and abs 2e-8 K/s for the tendencies there; the boundary, mid-column and ent pins stay tight.",
