      "qsmb_raw": 1.2898195203542923e-05
     },
     "assertions": [
      {
       "variable": "tsfc",
       "time": 0.0,
       "expected": -0.003957271002548168,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "qsmb",
       "time": 0.0,
       "expected": 1.2898195203542923e-05,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
     "id": "import_clamp_sentinel",
     "description": "The -250 degC sentinel clamp firing, from the SOURCE FORMULA (glc_import_export.F90:326-333; no dump row hits it - the traced cells are all CLM land/ice points): the 'Jer hack' case of F90:328-332 - a land point where CLM sees ocean sends raw 0 K, which the -tkfrz conversion drops to -273.15 degC; the where-clamp resets it to 0 degC.",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "tsfc_raw": 0.0
     },
     "assertions": [
      {
       "variable": "tsfc",
       "time": 0.0,
       "expected": 0.0
      }
     ]
    },
    {
     "id": "import_clamp_boundary_open",
     "description": "The clamp boundary, from the SOURCE FORMULA: tsfc_raw = 23.15 K converts to exactly -250 degC, which does NOT fire the strict (<) where-condition of F90:333 - the converted value passes through unchanged (tsfc = -250 degC).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "tsfc_raw": 23.15
     },
     "assertions": [
      {
       "variable": "tsfc",
       "time": 0.0,
       "expected": -250.0
      }
     ]
    },
    {
     "id": "import_clamp_just_below",
     "description": "The clamp just below the boundary, from the SOURCE FORMULA: tsfc_raw = 23.1499 K converts to -250.0001 degC < -250, so the where-condition fires and tsfc = 0 degC (the strict-< boundary of F90:333 sits between this row and import_clamp_boundary_open).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "tsfc_raw": 23.1499
     },
     "assertions": [
      {
       "variable": "tsfc",
       "time": 0.0,
       "expected": 0.0
      }
     ]
    },
    {
     "id": "import_warm_branch",
     "description": "The unconverted linear branch, from the SOURCE FORMULA: tsfc_raw = 293.15 K (20 degC) converts to tsfc = 20 degC with no clamp (the dump window's tsfc are all below freezing; this pins the linear branch away from the traced range).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "tsfc_raw": 293.15
     },
     "assertions": [
      {
       "variable": "tsfc",
       "time": 0.0,
       "expected": 20.0
      }
     ]
    }
   ]
  },
  "GlcCapExport": {
   "variables": {
    "usrf": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "description": "ice surface elevation (glide_geometry%usrf, m); not carried by cism_cap.csv - the test inputs take the transport-exit usrf of the same cell/step from cism_transport.csv (cross-file identity topo == usrf verified on all 64 export rows)"
    },
    "thck": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "description": "ice thickness (glide_geometry%thck, m); the ice-covered test of is_ice_covered is thck > min_thck with min_thck = 0 (glad_constants.F90:63, glad_output_states.F90:152)"
    },
    "calving_rate": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "calving thickness removal rate calving_thck/dt (m of ice per dynamics step divided by dt; glad_output_fluxes.F90:104-105). Per-dynamics-step CISM state not carried by cism_cap.csv, so an input here; zero throughout the reference window (no calving)"
    },
    "removal_rate": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "other solid-ice removal rate removal_thck/dt (icebergs/isthmuses from glissade_handle_ice_caps, forced retreat, tiny-thickness cleanup; tracked separately from calving but lost as solid ice, F90:91-96, 104-105). Not carried by the dump; zero in this window"
    },
    "bmlt": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "basal melt rate (model%basal_melt%bmlt, m/s ice; F90:122-128). Not carried by cism_cap.csv (the thermo dump carries the step-integrated bmlt_ground m/yr); zero in this window (cold base)"
    },
    "lateral_melt_rate": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "lateral/submarine melt thickness rate lateral_melt%melt_thck/dt (m of ice per dynamics step divided by dt; F90:117-129). Not carried by the dump; zero in this window"
    },
    "ucondflx": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "conductive heat flux at the upper surface (model%temper%ucondflx, W/m2, positive down; glissade_therm.F90:669); hflx = -ucondflx (the sign flip of F90:138-139, see metadata and bugs.md on the up/down label contradiction). Not carried by the dump; zero in this window"
    },
    "rhoi": {
     "type": "parameter",
     "units": "kg/m^3",
     "default": 917.0,
     "description": "ice density (glide_types default 917.0 kg/m3, the rhoi of glad_output_fluxes.F90:81)"
    },
    "T_coupling": {
     "type": "parameter",
     "units": "s",
     "default": 3.1536e7,
     "description": "coupling interval length 8760 h = 1 yr (tstep_mbal at GLC_NCPL = 1; = n_icetstep * dt = 2 * 0.5 yr). The Fortran divides the flux sum by the step count av_count_output = n_icetstep (F90:152-154); the continuous limit replaces sum_k f_k / count by (1/T_coupling) * integral_0^T_coupling f dt, identical for piecewise-constant f_k over the count steps of length dt"
    },
    "active_grid": {
     "type": "unknown",
     "units": "1",
     "description": "the active-grid mask of is_in_active_grid (usrf > 0, glad_output_states.F90:110-133, the same condition that sets ice_sheet_grid_mask - not dumped, not modeled separately)"
    },
    "topo": {
     "type": "unknown",
     "units": "m",
     "description": "exported surface elevation: usrf on the active grid, 0 elsewhere (glad_output_states.F90:91, 97-99)"
    },
    "ice_covered": {
     "type": "unknown",
     "units": "1",
     "description": "exported ice-covered flag: 1 where thck > min_thck = 0 (F90:152, glad_constants.F90:63) on the active grid, 0 elsewhere (F90:82-86, 97-99)"
    },
    "S_rofi": {
     "type": "unknown",
     "units": "kg/m^2",
     "default": 0.0,
     "description": "accumulated solid-ice runoff mass per area over the coupling interval: D(S_rofi)/dt = rhoi*(calving_rate + removal_rate), the continuous limit of the Fortran's per-step rofi_sum accumulation (F90:104-105; reset at the interval start, glad_timestep.F90:149)"
    },
    "S_rofl": {
     "type": "unknown",
     "units": "kg/m^2",
     "default": 0.0,
     "description": "accumulated liquid runoff mass per area over the coupling interval: D(S_rofl)/dt = rhoi*(bmlt + lateral_melt_rate), the continuous limit of rofl_sum (F90:128-129)"
    },
    "S_hflx": {
     "type": "unknown",
     "units": "J/m^2",
     "default": 0.0,
     "description": "accumulated heat per area over the coupling interval: D(S_hflx)/dt = -ucondflx, the continuous limit of hflx_sum (F90:138-139)"
    },
    "rofi": {
     "type": "unknown",
     "units": "kg/m^2/s",
     "description": "exported solid ice runoff (kg/m2/s = mm H2O/s), the coupling-interval average of rhoi*(calving_rate + removal_rate): S_rofi/T_coupling at the interval end (the Fortran's calculate_average_output_fluxes, F90:143-161)"
    },
    "rofl": {
     "type": "unknown",
     "units": "kg/m^2/s",
     "description": "exported liquid runoff (kg/m2/s = mm H2O/s), the coupling-interval average of rhoi*(bmlt + lateral_melt_rate): S_rofl/T_coupling"
    },
    "hflx": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "exported heat flux (W/m2), the coupling-interval average of -ucondflx: S_hflx/T_coupling"
    }
   },
   "equations": [
    {
     "lhs": "active_grid",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": ">",
        "args": [
         "usrf",
         {
          "op": "const",
          "args": [],
          "value": 0.0,
          "units": "m"
         }
        ]
       },
       1.0,
       0.0
      ]
     }
    },
    {
     "lhs": "topo",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": "==",
        "args": [
         "active_grid",
         1.0
        ]
       },
       "usrf",
       {
        "op": "const",
        "args": [],
        "value": 0.0,
        "units": "m"
       }
      ]
     }
    },
    {
     "lhs": "ice_covered",
     "rhs": {
      "op": "ifelse",
      "args": [
       {
        "op": "==",
        "args": [
         "active_grid",
         1.0
        ]
       },
       {
        "op": "ifelse",
        "args": [
         {
          "op": ">",
          "args": [
           "thck",
           {
            "op": "const",
            "args": [],
            "value": 0.0,
            "units": "m"
           }
          ]
         },
         1.0,
         0.0
        ]
       },
       0.0
      ]
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "S_rofi"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "*",
      "args": [
       "rhoi",
       {
        "op": "+",
        "args": [
         "calving_rate",
         "removal_rate"
        ]
       }
      ]
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "S_rofl"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "*",
      "args": [
       "rhoi",
       {
        "op": "+",
        "args": [
         "bmlt",
         "lateral_melt_rate"
        ]
       }
      ]
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "S_hflx"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "-",
      "args": [
       "ucondflx"
      ]
     }
    },
    {
     "lhs": "rofi",
     "rhs": {
      "op": "/",
      "args": [
       "S_rofi",
       "T_coupling"
      ]
     }
    },
    {
     "lhs": "rofl",
     "rhs": {
      "op": "/",
      "args": [
       "S_rofl",
       "T_coupling"
      ]
     }
    },
    {
     "lhs": "hflx",
     "rhs": {
      "op": "/",
      "args": [
       "S_hflx",
       "T_coupling"
      ]
     }
    }
   ],
   "tests": [
    {
     "id": "export_topo_step1_cell2511",
     "description": "Dump pin, cism_cap.csv export row (cap_step 1, cell 25,11): topo = 1083.4394647029326 m, ice_covered = 1. usrf and thck are taken from cism_transport.csv exit row (cism_step 2, cell 25,11): usrf = 1083.4394647029326 m, thck = 1.4394647029325882 m (the export happens after the second dynamics step of year 1; the cross-file identity topo == usrf holds on all 64 export rows).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "usrf": 1083.4394647029326,
      "thck": 1.4394647029325882
     },
     "assertions": [
      {
       "variable": "active_grid",
       "time": 0.0,
       "expected": 1.0
      },
      {
       "variable": "topo",
       "time": 0.0,
       "expected": 1083.4394647029326,
       "tolerance": {
        "rel": 1e-12
       }
