    "tests": [
     {
      "id": "accumulate_thickness_step1_cell2611",
      "description": "Dump pin of the thickness rate law d(thck)/dt = acab - bmlt with bmlt = 0: the cism_transport.csv entry row of cell 26,11 at step 1 has thck = 14 m and acab = 2.0809741699667099 m/yr; the SMB-only prediction after one 0.5-yr step is 14 + 0.5*2.0809741699667099 = 15.040487084983354 m, and the dump exit thck is 15.040488048712829 m. The +9.64e-07 m residual is the horizontal advection of the step (the transport happens between the entry and exit phases of the dump; the same cell's step-2 residual drops to +9.6e-10 m, see README-cism-transport.md): tolerance rel 1e-6 is ~10x the residual.",
      "time_span": {
       "start": 0.0,
       "end": 0.5
      },
      "parameter_overrides": {
       "acab": 2.0809741699667099,
       "topg": 1752.9000244140625
      },
      "initial_conditions": {
       "thck_raw": 14.0,
       "age": 0.0
      },
      "assertions": [
       {
        "variable": "thck",
        "time": 0.5,
        "expected": 15.040488048712829,
        "tolerance": {
         "rel": 1e-6
        }
       },
       {
        "variable": "acab_applied",
        "time": 0.5,
        "expected": 2.0809741699667099,
        "tolerance": {
         "rel": 1e-12
        }
       },
       {
        "variable": "bmlt_applied",
        "time": 0.5,
        "expected": 0.0
       },
       {
        "variable": "melt_potential",
        "time": 0.5,
        "expected": 0.0
       }
      ]
     },
     {
      "id": "accumulate_thickness_step2_cell2611",
      "description": "Dump pin, same cell, step 2: entry thck = 15.040488048712829 m (the step-1 exit), same acab; prediction 16.080975133696185 m vs dump exit 16.080975134653887 m - the advection residual is +9.58e-10 m (rel 6e-11), near round-off: tolerance rel 1e-9.",
      "time_span": {
       "start": 0.0,
       "end": 0.5
      },
      "parameter_overrides": {
       "acab": 2.0809741699667099,
       "topg": 1752.9000244140625
      },
      "initial_conditions": {
       "thck_raw": 15.040488048712829,
       "age": 0.0
      },
      "assertions": [
       {
        "variable": "thck",
        "time": 0.5,
        "expected": 16.080975134653887,
        "tolerance": {
         "rel": 1e-9
        }
       }
      ]
     },
     {
      "id": "accumulate_thickness_step4_cell2611",
      "description": "Dump pin, same cell, step 4 (the second cap year's ablation-free second step): entry thck = 16.85918996861492 m with acab = 1.5564316967068248 m/yr (cap_step 2 qsmb of this cell); prediction 17.637405816968332 m vs dump exit 17.637404090581274 m - residual -1.73e-06 m: tolerance rel 1e-6.",
      "time_span": {
       "start": 0.0,
       "end": 0.5
      },
      "parameter_overrides": {
       "acab": 1.5564316967068248,
       "topg": 1752.9000244140625
      },
      "initial_conditions": {
