        }
       }
      ]
     },
     {
      "id": "full_melt_step1_cell2811",
      "description": "Dump pin of the full-melt clip and the tracer zeroing: cell 28,11 at step 1 has entry thck = 0.019958499819040298 m with acab = -0.7075135162820545 m/yr (the zeroing did not fire: thck > 0). One 0.5-yr step would remove 0.35375675814102725 m - the whole column and more - so the Fortran clips the exit thck to 0 (dump exit thck = 0 exactly) and carries the excess into melt_potential = 0.35375675814102725 - 0.019958499819040298 = 0.33379825832198695 m (not a dump column: the per-step value follows from the same conservation check the Fortran itself runs, F90:1523-1538). The dump's exit temp_001..010 are all 0 (the tracer = 0 of the removed layers, F90:1411-1413), pinning T1_out = Tbar_out = 0. The applied rate is clipped too: acab_applied = -H_pre/dt = -0.039916999638080596 m/yr (the surface ablation applied to the 0.0199585 m that existed), bmlt_applied = 0.",
      "time_span": {
       "start": 0.0,
       "end": 0.5
      },
      "parameter_overrides": {
       "acab": -0.7075135162820545,
       "topg": 921.1400146484375,
       "T1": -2.389185071557904,
       "Tbar": -2.389185071557904,
       "Tsurf": -2.389185071557904,
       "Tbed": -2.389185071557904
      },
      "initial_conditions": {
       "thck_raw": 0.019958499819040298,
       "age": 0.0
      },
      "assertions": [
       {
        "variable": "thck",
        "time": 0.5,
        "expected": 0.0
       },
       {
        "variable": "melt_potential",
        "time": 0.5,
