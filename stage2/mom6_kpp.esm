     "shape": [
      "layer"
     ],
     "units": "ppt m",
     "default": 0.0
    },
    "surfHu": {
     "type": "unknown",
     "shape": [
      "layer"
     ],
     "units": "m^2 s^-1",
     "default": 0.0
    },
    "surfHv": {
     "type": "unknown",
     "shape": [
      "layer"
     ],
     "units": "m^2 s^-1",
     "default": 0.0
    },
    "surfT": {
     "type": "unknown",
     "shape": [
      "layer"
     ],
     "units": "degC",
     "default": 0.0,
     "description": "Surface-layer-mean temperature for the assumed OBL depth at layer k (F90:1379; the sum runs over all 75 layers, delH = 0 beyond ksfc), [degC]"
    },
