{
 "esm": "1.3.0",
 "metadata": {
  "name": "clm_templates",
  "description": "Expression-template library for the CTSM/CLM land-surface components (stage 2 of the EqESM project): the pointwise closure laws of ctsm5.4.063 (cesm3.0-alphabranch checkout) exercised by the stage-2 CLM components, currently CanopyHydrology and CanopyFluxInterface (stage2/clm_canopy.esm): the QSat saturation vapor pressure/specific humidity laws and their derivatives, the canopy interception/storage/excess laws, the ZengWang2007 roughness and displacement laws, the emissivity laws and the latent heat of vaporization/sublimation law. Transcribed exactly from the Fortran; every template carries its source file:line in its description and returns one scalar (the CLM laws are all pointwise, so a template per output is sufficient). The remaining shared laws (soil/snow hydraulics and thermal properties, snow hydrology and albedo, Monin-Obukhov and aerodynamic laws, etc.) will be added here as their stage-2 components are implemented. The bare-ground fluxes component (stage2/clm_bareground.esm) adds the Monin-Obukhov surface-layer laws: the Paulson (1970) stability functions (the scalar one reused from ./cmeps_templates.esm by reference through psixhu_unstable, esm-spec 9.7.3; the momentum one authored fresh because its constant is SHR_CONST_PI*0.5 while the cmeps psimhu_unstable hard-codes 1.571), the MoninObukIni initialization laws (wind speed, bulk Richardson number, clamped initial zeta), the four-branch friction-velocity profile laws (momentum and scalar, shared by the 2-m diagnostics), the Meier2022 roughness laws (z0hg and the snowmelt-dependent z0mg) and the Magnus dewpoint law. Reference: stage1/cesm/components/clm/src/biogeophys/.",
  "license": "MIT"
 },
 "expression_template_imports": [
  { "ref": "./cmeps_templates.esm" }
 ],
 "expression_templates": {
  "poly8": {
   "description": "Ninth-order power-sum polynomial c0 + c1*x + ... + c8*x^8, the mathematical form of the Flatau et al. (1992) saturation-vapor-pressure fits used by QSat (QSatMod.F90:18-56). Written as a power sum rather than the Fortran's nested Horner form (QSatMod.F90:93-97) for readability; the two agree to round-off.",
   "params": ["c0", "c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "x"],
   "body": {"op": "+", "args": [
    "c0",
    {"op": "*", "args": ["c1", "x"]},
    {"op": "*", "args": ["c2", {"op": "^", "args": ["x", 2]}]},
    {"op": "*", "args": ["c3", {"op": "^", "args": ["x", 3]}]},
    {"op": "*", "args": ["c4", {"op": "^", "args": ["x", 4]}]},
    {"op": "*", "args": ["c5", {"op": "^", "args": ["x", 5]}]},
    {"op": "*", "args": ["c6", {"op": "^", "args": ["x", 6]}]},
    {"op": "*", "args": ["c7", {"op": "^", "args": ["x", 7]}]},
    {"op": "*", "args": ["c8", {"op": "^", "args": ["x", 8]}]}
   ]}
  },
  "qsat_esat": {
   "description": "Saturation vapor pressure es(T) [Pa]: QSatMod.F90:90-100. td = min(100, max(-75, T - TKFRZ)); the water polynomial (coefficients a0..a8, QSatMod.F90:18-26) for td >= 0, the ice polynomial (c0..c8, QSatMod.F90:38-46) otherwise, scaled by 100 to Pa.",
   "params": ["T", "TKFRZ"],
   "body": {"op": "*", "args": [100.0, {"op": "ifelse", "args": [
    {"op": ">=", "args": [{"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}, 0.0]},
    {"op": "apply_expression_template", "args": [], "name": "poly8", "bindings": {
     "c0": 6.11213476, "c1": 0.444007856, "c2": 0.143064234e-1, "c3": 0.264461437e-3,
     "c4": 0.305903558e-5, "c5": 0.196237241e-7, "c6": 0.892344772e-10, "c7": -0.373208410e-12,
     "c8": 0.209339997e-15, "x": {"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}}},
    {"op": "apply_expression_template", "args": [], "name": "poly8", "bindings": {
     "c0": 6.11123516, "c1": 0.503109514, "c2": 0.188369801e-1, "c3": 0.420547422e-3,
     "c4": 0.614396778e-5, "c5": 0.602780717e-7, "c6": 0.387940929e-9, "c7": 0.149436277e-11,
     "c8": 0.262655803e-14, "x": {"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}}}
   ]}]}
  },
  "qsat_esat_dT": {
   "description": "d(es)/dT [Pa/K]: QSatMod.F90:108-117. The b0..b8 water fit (QSatMod.F90:28-36) for td >= 0, the d0..d8 ice fit (QSatMod.F90:48-56) otherwise, scaled by 100. td = min(100, max(-75, T - TKFRZ)).",
   "params": ["T", "TKFRZ"],
   "body": {"op": "*", "args": [100.0, {"op": "ifelse", "args": [
    {"op": ">=", "args": [{"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}, 0.0]},
    {"op": "apply_expression_template", "args": [], "name": "poly8", "bindings": {
     "c0": 0.444017302, "c1": 0.286064092e-1, "c2": 0.794683137e-3, "c3": 0.121211669e-4,
     "c4": 0.103354611e-6, "c5": 0.404125005e-9, "c6": -0.788037859e-12, "c7": -0.114596802e-13,
     "c8": 0.381294516e-16, "x": {"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}}},
    {"op": "apply_expression_template", "args": [], "name": "poly8", "bindings": {
     "c0": 0.503277922, "c1": 0.377289173e-1, "c2": 0.126801703e-2, "c3": 0.249468427e-4,
     "c4": 0.313703411e-6, "c5": 0.257180651e-8, "c6": 0.133268878e-10, "c7": 0.394116744e-13,
     "c8": 0.498070196e-16, "x": {"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}}}
   ]}]}
  },
  "qsat_qs": {
   "description": "Saturation specific humidity qs(T,p) [kg/kg]: QSatMod.F90:101-103. vp = 1/(p - 0.378*es) [1/Pa]; qs = es * 0.622 * vp. Shares qsat_esat by reference.",
   "params": ["T", "p", "TKFRZ"],
   "body": {"op": "*", "args": [
    {"op": "apply_expression_template", "args": [], "name": "qsat_esat", "bindings": {"T": "T", "TKFRZ": "TKFRZ"}},
    0.622,
    {"op": "/", "args": [1.0, {"op": "-", "args": ["p", {"op": "*", "args": [0.378, {"op": "apply_expression_template", "args": [], "name": "qsat_esat", "bindings": {"T": "T", "TKFRZ": "TKFRZ"}}]}]}]}
   ]}
  },
  "qsat_qsdT": {
   "description": "d(qs)/dT [1/K]: QSatMod.F90:118-120. qsdT = esdT * vp1 * vp * p with vp1 = 0.622/(p - 0.378*es) and vp = 1/(p - 0.378*es), i.e. qsdT = 0.622*esdT*p/(p - 0.378*es)^2. Shares qsat_esat and qsat_esat_dT by reference.",
   "params": ["T", "p", "TKFRZ"],
   "body": {"op": "*", "args": [
    0.622,
    {"op": "apply_expression_template", "args": [], "name": "qsat_esat_dT", "bindings": {"T": "T", "TKFRZ": "TKFRZ"}},
    "p",
    {"op": "^", "args": [{"op": "/", "args": [1.0, {"op": "-", "args": ["p", {"op": "*", "args": [0.378, {"op": "apply_expression_template", "args": [], "name": "qsat_esat", "bindings": {"T": "T", "TKFRZ": "TKFRZ"}}]}]}]}, 2]}
   ]}
  },
  "soil_suction": {
   "description": "Soil matric potential smp = -sucsat * s^(-bsw) [mm], negative: SoilWaterRetentionCurveClappHornberg1978Mod.F90:115.",
   "params": ["sucsat", "bsw", "s"],
   "body": {"op": "*", "args": [-1.0, "sucsat", {"op": "^", "args": ["s", {"op": "-", "args": ["bsw"]}]}]}
  },
  "canopy_intercept_liq": {
   "description": "Canopy liquid-interception fraction fpiliq [1] (CLM5 default, use_clm5_fpi = .false.): CanopyHydrologyMod.F90:538. fpiliq = 0.25*(1 - exp(-0.5*(elai+esai))).",
   "params": ["elai", "esai"],
   "body": {"op": "*", "args": [0.25, {"op": "-", "args": [1.0, {"op": "exp", "args": [{"op": "*", "args": [-0.5, {"op": "+", "args": ["elai", "esai"]}]}]}]}]}
  },
  "canopy_intercept_snow": {
   "description": "Canopy snow-interception fraction fpisnow [1]: CanopyHydrologyMod.F90:541. fpisnow = 1 - exp(-0.5*(elai+esai)).",
   "params": ["elai", "esai"],
   "body": {"op": "-", "args": [1.0, {"op": "exp", "args": [{"op": "*", "args": [-0.5, {"op": "+", "args": ["elai", "esai"]}]}]}]}
  },
  "canopy_storage_max": {
   "description": "Maximum canopy storage canmx [mm H2O] = storage_scalar*(elai+esai): CanopyHydrologyMod.F90:755 (liq_canopy_storage_scalar) and :757 (snow_canopy_storage_scalar).",
   "params": ["storage_scalar", "elai", "esai"],
   "body": {"op": "*", "args": ["storage_scalar", {"op": "+", "args": ["elai", "esai"]}]}
  },
  "canopy_excess_flux": {
   "description": "Rate of excess canopy water falling off the canopy [mm H2O/s] = max((can - canmx)/dtime, 0): CanopyHydrologyMod.F90:756, 758.",
   "params": ["can", "canmx", "dtime"],
   "body": {"op": "max", "args": [{"op": "*", "args": [{"op": "-", "args": ["can", "canmx"]}, {"op": "/", "args": [1.0, "dtime"]}]}, 0.0]}
  },
  "pft_z0m_zengwang2007": {
   "description": "Momentum roughness length z0m = z0mr*htop [m], z0param_method = 'ZengWang2007': BiogeophysPreFluxCalcsMod.F90:175.",
   "params": ["z0mr", "htop"],
   "body": {"op": "*", "args": ["z0mr", "htop"]}
  },
  "pft_displa_zengwang2007": {
   "description": "Displacement height displa = displar*htop [m], z0param_method = 'ZengWang2007': BiogeophysPreFluxCalcsMod.F90:176.",
   "params": ["displar", "htop"],
   "body": {"op": "*", "args": ["displar", "htop"]}
  },
  "vegetation_emissivity": {
   "description": "Vegetation emissivity emv = 1 - exp(-(elai+esai)/avmuir) [1]: BiogeophysPreFluxCalcsMod.F90:397.",
   "params": ["elai", "esai", "avmuir"],
   "body": {"op": "-", "args": [1.0, {"op": "exp", "args": [{"op": "*", "args": [-1.0, {"op": "/", "args": [{"op": "+", "args": ["elai", "esai"]}, "avmuir"]}]}]}]}
  },
  "ground_emissivity": {
   "description": "Ground emissivity emg = (1-frac_sno)*emg_soil + frac_sno*emg_snow [1], emg_soil = 0.96, emg_snow = 0.97: BiogeophysPreFluxCalcsMod.F90:348.",
   "params": ["frac_sno_albedo", "emg_soil", "emg_snow"],
   "body": {"op": "+", "args": [{"op": "*", "args": [{"op": "-", "args": [1.0, "frac_sno_albedo"]}, "emg_soil"]}, {"op": "*", "args": ["frac_sno_albedo", "emg_snow"]}]}
  },
  "latent_heat_of_vapor": {
   "description": "Latent heat of vaporization or sublimation htvp [J/kg]: BiogeophysPreFluxCalcsMod.F90:354-358. hsub when the top layer has ice but no liquid (h2osoi_liq <= 0 and h2osoi_ice > 0), else hvap.",
   "params": ["h2osoi_liq_top", "h2osoi_ice_top", "hvap", "hsub"],
   "body": {"op": "ifelse", "args": [
    {"op": "and", "args": [{"op": "<=", "args": ["h2osoi_liq_top", 0.0]}, {"op": ">", "args": ["h2osoi_ice_top", 0.0]}]},
    "hsub", "hvap"
   ]}
  },
  "stability_func_momentum": {
   "description": "Paulson (1970) unstable momentum stability function StabilityFunc1(zeta) of FrictionVelocityMod.F90:1131-1134: chik2 = sqrt(1 - 16*zeta), chik = sqrt(chik2), 2*log((1+chik)*0.5) + log((1+chik2)*0.5) - 2*atan(chik) + SHR_CONST_PI*0.5. The trailing constant is SHR_CONST_PI*0.5 = 1.5707963267948966 exactly (clm_varcon.F90:42, rpi = SHR_CONST_PI); the cmeps psimhu_unstable hard-codes 1.571 instead, so this template is authored fresh rather than reused. Only the rib < 0 (unstable) branch is transcribed here; the stable branch of the flux-gradient relations is the linear 5*zeta form written directly in the profile templates.",
   "params": ["zeta"],
   "body": {"op": "+", "args": [
    {"op": "*", "args": [2.0, {"op": "log", "args": [{"op": "*", "args": [{"op": "+", "args": [1.0, {"op": "sqrt", "args": [{"op": "sqrt", "args": [{"op": "-", "args": [1.0, {"op": "*", "args": [16.0, "zeta"]}]}]}]}]}, 0.5]}]}]},
    {"op": "log", "args": [{"op": "*", "args": [{"op": "+", "args": [1.0, {"op": "sqrt", "args": [{"op": "-", "args": [1.0, {"op": "*", "args": [16.0, "zeta"]}]}]}]}, 0.5]}]},
    {"op": "*", "args": [-2.0, {"op": "atan", "args": [{"op": "sqrt", "args": [{"op": "sqrt", "args": [{"op": "-", "args": [1.0, {"op": "*", "args": [16.0, "zeta"]}]}]}]}]}]},
    {"op": "const", "args": [], "value": 1.5707963267948966, "units": "1"}
   ]}
  },
  "stability_func_scalar": {
   "description": "Paulson (1970) unstable scalar stability function StabilityFunc2(zeta) of FrictionVelocityMod.F90:1151-1152: 2*log((1 + sqrt(1 - 16*zeta))*0.5). This is exactly the cmeps psixhu_unstable (flux_atmocn_Large.F90:164) evaluated at x = (1 - 16*zeta)^0.25, so it is reused by reference (esm-spec 9.7.3) rather than re-authored.",
   "params": ["zeta"],
   "body": {"op": "apply_expression_template", "args": [], "name": "psixhu_unstable", "bindings": {"x": {"op": "^", "args": [{"op": "-", "args": [1.0, {"op": "*", "args": [16.0, "zeta"]}]}, 0.25]}}}
  },
  "monin_obukhov_initial_wind": {
   "description": "Initial wind speed um of MoninObukIni (FrictionVelocityMod.F90:1190-1194): wc = 0.5 m/s convective velocity; if dthv >= 0 then um = max(ur, 0.1) else um = sqrt(ur^2 + wc^2). The companion initial ustar = 0.06 (F90:1189) is never read after the MoninObukIni call in BareGroundFluxesMod, so it is omitted.",
   "params": ["dthv", "ur", "wc"],
   "body": {"op": "ifelse", "args": [
    {"op": ">=", "args": ["dthv", 0.0]},
    {"op": "max", "args": ["ur", 0.1]},
    {"op": "sqrt", "args": [{"op": "+", "args": [{"op": "^", "args": ["ur", 2]}, {"op": "^", "args": ["wc", 2]}]}]}
   ]}
  },
  "bulk_richardson": {
   "description": "Bulk Richardson number rib of MoninObukIni (FrictionVelocityMod.F90:1196): rib = grav*zldis*dthv/(thv*um^2).",
   "params": ["grav", "zldis", "dthv", "thv", "um"],
   "body": {"op": "/", "args": [
    {"op": "*", "args": ["grav", "zldis", "dthv"]},
    {"op": "*", "args": ["thv", {"op": "^", "args": ["um", 2]}]}
   ]}
  },
  "monin_obukhov_initial_zeta": {
   "description": "Initial Monin-Obukhov stability parameter zeta of MoninObukIni (FrictionVelocityMod.F90:1198-1204). Stable/neutral branch (rib >= 0): zeta = rib*log(zldis/z0m)/(1 - 5*min(rib, 0.19)) clamped to [0.01, zetamaxstable]; unstable branch: zeta = rib*log(zldis/z0m) clamped to [-100, -0.01]. The Obukhov length follows as obu = zldis/zeta at the call site.",
   "params": ["rib", "zldis", "z0m", "zetamaxstable"],
   "body": {"op": "ifelse", "args": [
    {"op": ">=", "args": ["rib", 0.0]},
    {"op": "min", "args": ["zetamaxstable", {"op": "max", "args": [{"op": "/", "args": [{"op": "*", "args": ["rib", {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0m"]}]}]}, {"op": "-", "args": [1.0, {"op": "*", "args": [5.0, {"op": "min", "args": ["rib", 0.19]}]}]}]}, 0.01]}]},
    {"op": "max", "args": [-100.0, {"op": "min", "args": [{"op": "*", "args": ["rib", {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0m"]}]}]}, -0.01]}]}
   ]}
  },
  "friction_velocity_momentum": {
   "description": "Momentum profile: friction velocity ustar = vkc*um/v of FrictionVelocity (FrictionVelocityMod.F90:857-871), where v is the four-branch integral of the wind profile in zeta = zldis/obu and zetam = 1.574 is the transition point of the flux-gradient relation (F90:795). Branches: zeta < -zetam: v = log(-zetam*obu/z0m) - StabilityFunc1(-zetam) + StabilityFunc1(z0m/obu) + 1.14*((-zeta)^0.333 - zetam^0.333); zeta < 0: v = log(zldis/z0m) - StabilityFunc1(zeta) + StabilityFunc1(z0m/obu); zeta <= 1: v = log(zldis/z0m) + 5*zeta - 5*z0m/obu; else: v = log(obu/z0m) + 5 - 5*z0m/obu + (5*log(zeta) + zeta - 1). The profile zeta is recomputed as zldis/obu inside the template exactly as the Fortran does for each of its profile calls.",
   "params": ["vkc", "um", "zldis", "z0m", "obu", "zetam"],
   "body": {"op": "*", "args": ["vkc", "um", {"op": "/", "args": [1.0, {"op": "ifelse", "args": [
    {"op": "<", "args": [{"op": "/", "args": ["zldis", "obu"]}, {"op": "-", "args": ["zetam"]}]},
    {"op": "+", "args": [
     {"op": "log", "args": [{"op": "/", "args": [{"op": "*", "args": [{"op": "-", "args": ["zetam"]}, "obu"]}, "z0m"]}]},
     {"op": "-", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_func_momentum", "bindings": {"zeta": {"op": "-", "args": ["zetam"]}}}]},
     {"op": "apply_expression_template", "args": [], "name": "stability_func_momentum", "bindings": {"zeta": {"op": "/", "args": ["z0m", "obu"]}}},
     {"op": "*", "args": [1.14, {"op": "-", "args": [{"op": "^", "args": [{"op": "-", "args": [{"op": "/", "args": ["zldis", "obu"]}]}, 0.333]}, {"op": "^", "args": ["zetam", 0.333]}]}]}
    ]},
    {"op": "ifelse", "args": [
     {"op": "<", "args": [{"op": "/", "args": ["zldis", "obu"]}, 0.0]},
     {"op": "+", "args": [
      {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0m"]}]},
      {"op": "-", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_func_momentum", "bindings": {"zeta": {"op": "/", "args": ["zldis", "obu"]}}}]},
      {"op": "apply_expression_template", "args": [], "name": "stability_func_momentum", "bindings": {"zeta": {"op": "/", "args": ["z0m", "obu"]}}}
     ]},
     {"op": "ifelse", "args": [
      {"op": "<=", "args": [{"op": "/", "args": ["zldis", "obu"]}, 1.0]},
      {"op": "+", "args": [
       {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0m"]}]},
       {"op": "*", "args": [5.0, {"op": "/", "args": ["zldis", "obu"]}]},
       {"op": "-", "args": [{"op": "*", "args": [5.0, {"op": "/", "args": ["z0m", "obu"]}]}]}
      ]},
      {"op": "+", "args": [
       {"op": "log", "args": [{"op": "/", "args": ["obu", "z0m"]}]},
       5.0,
       {"op": "-", "args": [{"op": "*", "args": [5.0, {"op": "/", "args": ["z0m", "obu"]}]}]},
       {"op": "+", "args": [
        {"op": "*", "args": [5.0, {"op": "log", "args": [{"op": "/", "args": ["zldis", "obu"]}]}]},
        {"op": "/", "args": ["zldis", "obu"]},
        -1.0
       ]}
      ]}
     ]}
    ]}
   ]}]}]}
  },
  "friction_velocity_scalar": {
   "description": "Scalar (heat/water) profile factor temp = vkc/v of FrictionVelocity (FrictionVelocityMod.F90:956-970 for the heat profile temp1 at the measurement height; the same law with the z0q roughness and zldis = 2 + z0h/z0q serves the humidity profile temp2 (F90:974-1015, equal to temp1 when forc_hgt_q == forc_hgt_t and z0q == z0h, which holds in the traced run) and the 2-m diagnostics temp12m/temp22m (F90:1022-1038, 1051-1067)), where v is the four-branch integral of the profile in zeta = zldis/obu and zetat = 0.465 is the transition point of the temperature profile (F90:796). Branches: zeta < -zetat: v = log(-zetat*obu/z0) - StabilityFunc2(-zetat) + StabilityFunc2(z0/obu) + 0.8*(zetat^(-0.333) - (-zeta)^(-0.333)); zeta < 0: v = log(zldis/z0) - StabilityFunc2(zeta) + StabilityFunc2(z0/obu); zeta <= 1: v = log(zldis/z0) + 5*zeta - 5*z0/obu; else: v = log(obu/z0) + 5 - 5*z0/obu + (5*log(zeta) + zeta - 1). The profile zeta is recomputed as zldis/obu inside the template exactly as the Fortran does for each of its profile calls.",
   "params": ["vkc", "zldis", "z0", "obu", "zetat"],
   "body": {"op": "*", "args": ["vkc", {"op": "/", "args": [1.0, {"op": "ifelse", "args": [
    {"op": "<", "args": [{"op": "/", "args": ["zldis", "obu"]}, {"op": "-", "args": ["zetat"]}]},
    {"op": "+", "args": [
     {"op": "log", "args": [{"op": "/", "args": [{"op": "*", "args": [{"op": "-", "args": ["zetat"]}, "obu"]}, "z0"]}]},
     {"op": "-", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_func_scalar", "bindings": {"zeta": {"op": "-", "args": ["zetat"]}}}]},
     {"op": "apply_expression_template", "args": [], "name": "stability_func_scalar", "bindings": {"zeta": {"op": "/", "args": ["z0", "obu"]}}},
     {"op": "*", "args": [0.8, {"op": "-", "args": [{"op": "^", "args": ["zetat", -0.333]}, {"op": "^", "args": [{"op": "-", "args": [{"op": "/", "args": ["zldis", "obu"]}]}, -0.333]}]}]}
    ]},
    {"op": "ifelse", "args": [
     {"op": "<", "args": [{"op": "/", "args": ["zldis", "obu"]}, 0.0]},
     {"op": "+", "args": [
      {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0"]}]},
      {"op": "-", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_func_scalar", "bindings": {"zeta": {"op": "/", "args": ["zldis", "obu"]}}}]},
      {"op": "apply_expression_template", "args": [], "name": "stability_func_scalar", "bindings": {"zeta": {"op": "/", "args": ["z0", "obu"]}}}
     ]},
     {"op": "ifelse", "args": [
      {"op": "<=", "args": [{"op": "/", "args": ["zldis", "obu"]}, 1.0]},
      {"op": "+", "args": [
       {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0"]}]},
       {"op": "*", "args": [5.0, {"op": "/", "args": ["zldis", "obu"]}]},
       {"op": "-", "args": [{"op": "*", "args": [5.0, {"op": "/", "args": ["z0", "obu"]}]}]}
      ]},
      {"op": "+", "args": [
       {"op": "log", "args": [{"op": "/", "args": ["obu", "z0"]}]},
       5.0,
       {"op": "-", "args": [{"op": "*", "args": [5.0, {"op": "/", "args": ["z0", "obu"]}]}]},
       {"op": "+", "args": [
        {"op": "*", "args": [5.0, {"op": "log", "args": [{"op": "/", "args": ["zldis", "obu"]}]}]},
        {"op": "/", "args": ["zldis", "obu"]},
        -1.0
       ]}
      ]}
     ]}
    ]}
   ]}]}]}
  },
  "z0hg_meier2022": {
   "description": "Meier2022 ground scalar-roughness update z0hg (BareGroundFluxesMod.F90:365, after Yang et al. 2008): z0hg = meier_param3*nu_param/ustar*exp(-beta_param*ustar^0.5*|tstar|^0.25), with meier_param3 = 70 (clm_varcon.F90:171), nu_param = 1.5e-5 m^2/s kinematic viscosity of air (clm_varcon.F90:165) and beta_param = 7.2 (s/m)^0.5/K^0.25 (clm_varcon.F90:164). The traced run uses z0param_method = 'Meier2022'.",
   "params": ["meier_param3", "nu_param", "ustar", "beta_param", "tstar"],
   "body": {"op": "*", "args": [
    {"op": "*", "args": ["meier_param3", {"op": "/", "args": ["nu_param", "ustar"]}]},
    {"op": "exp", "args": [{"op": "*", "args": [
     {"op": "-", "args": ["beta_param"]},
     {"op": "^", "args": ["ustar", 0.5]},
     {"op": "^", "args": [{"op": "abs", "args": ["tstar"]}, 0.25]}
    ]}]}
   ]}
  },
  "z0mg_meier2022_snowmelt": {
   "description": "Meier2022 ground momentum roughness over snow-covered ground z0mg (FrictionVelocityMod.F90:620-623, the use_z0m_snowmelt = .true. branch of SetRoughnessLengthsAndForcHeightsNonLake): z0mg = exp(-b1_param*pi*0.5 + b4_param)*1e-3 when snomelt_accum < 1e-5 m, else exp(b1_param*atan((log10(snomelt_accum) + meier_param1)/meier_param2) + b4_param)*1e-3, with b1_param = 1.4, b4_param = -0.31, meier_param1 = 0.23, meier_param2 = 0.08 (clm_varcon.F90:166-170) and pi = SHR_CONST_PI = 3.141592653589793 (so pi*0.5 = 1.5707963267948966). The log10 argument is written as snomelt_accum/1 m so the unit algebra closes (the Fortran takes log10 of a length in m). The traced rows all fall in the snomelt_accum < 1e-5 branch (z0mg = exp(-1.4*pi/2 - 0.31)*1e-3 = 8.13402050576016129e-05).",
   "params": ["snomelt_accum", "b1_param", "b4_param", "meier_param1", "meier_param2"],
   "body": {"op": "*", "args": [
    {"op": "const", "args": [], "value": 1.0e-3, "units": "m"},
    {"op": "ifelse", "args": [
     {"op": "<", "args": ["snomelt_accum", {"op": "const", "args": [], "value": 1.0e-5, "units": "m"}]},
     {"op": "exp", "args": [{"op": "+", "args": [
      {"op": "*", "args": [{"op": "-", "args": ["b1_param"]}, {"op": "const", "args": [], "value": 1.5707963267948966, "units": "1"}]},
      "b4_param"
     ]}]},
     {"op": "exp", "args": [{"op": "+", "args": [
      {"op": "*", "args": ["b1_param", {"op": "atan", "args": [{"op": "/", "args": [
       {"op": "+", "args": [{"op": "log10", "args": [{"op": "/", "args": ["snomelt_accum", {"op": "const", "args": [], "value": 1.0, "units": "m"}]}]}, "meier_param1"]},
       "meier_param2"
      ]}]}]},
      "b4_param"
     ]}]}
    ]}
   ]}
  },
  "dewpoint_magnus": {
   "description": "Dewpoint temperature [K] from vapor pressure e and temperature t (BareGroundFluxesMod.F90:548-578, dewpoint(), Equation 7 of Lawrence 2005 with the Alduchov & Eskridge 1996 coefficients): td = ifelse(t < tfrz, B1_ice*log(e/C1_ice)/(A1_ice - log(e/C1_ice)), B1_liq*log(e/C1_liq)/(A1_liq - log(e/C1_liq))) + tfrz, with A1_ice = 22.587, B1_ice = 273.86 K, C1_ice = 611.21 Pa and A1_liq = 17.625, B1_liq = 243.04 K, C1_liq = 610.94 Pa. The ice/liquid selection is on the input temperature t (t_grnd at the call site), not on the dewpoint. The traced rows are all in the liquid branch.",
   "params": ["e", "t", "tfrz"],
   "body": {"op": "+", "args": [
    {"op": "ifelse", "args": [
     {"op": "<", "args": ["t", "tfrz"]},
     {"op": "/", "args": [
      {"op": "*", "args": [{"op": "const", "args": [], "value": 273.86, "units": "K"}, {"op": "log", "args": [{"op": "/", "args": ["e", {"op": "const", "args": [], "value": 611.21, "units": "Pa"}]}]}]},
      {"op": "-", "args": [{"op": "const", "args": [], "value": 22.587, "units": "1"}, {"op": "log", "args": [{"op": "/", "args": ["e", {"op": "const", "args": [], "value": 611.21, "units": "Pa"}]}]}]}
     ]},
     {"op": "/", "args": [
      {"op": "*", "args": [{"op": "const", "args": [], "value": 243.04, "units": "K"}, {"op": "log", "args": [{"op": "/", "args": ["e", {"op": "const", "args": [], "value": 610.94, "units": "Pa"}]}]}]},
      {"op": "-", "args": [{"op": "const", "args": [], "value": 17.625, "units": "1"}, {"op": "log", "args": [{"op": "/", "args": ["e", {"op": "const", "args": [], "value": 610.94, "units": "Pa"}]}]}]}
     ]}
    ]},
    "tfrz"
   ]}
  }
 }
}
