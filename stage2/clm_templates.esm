{
 "esm": "1.3.0",
 "metadata": {
  "name": "clm_templates",
  "description": "Expression-template library for the CTSM/CLM land-surface components (stage 2 of the EqESM project): the pointwise closure laws of ctsm5.4.063 (cesm3.0-alphabranch checkout) exercised by the stage-2 CLM components, currently CanopyHydrology and CanopyFluxInterface (stage2/clm_canopy.esm) and SoilTemperature (stage2/clm_soiltemp.esm): the QSat saturation vapor pressure/specific humidity laws and their derivatives, the canopy interception/storage/excess laws, the ZengWang2007 roughness and displacement laws, the emissivity laws and the latent heat of vaporization/sublimation law, and the soil/snow thermal laws (snow bulk density, Sturm1997/Jordan1991 snow thermal conductivity, snow heat capacity, Johansen (1975) soil thermal conductivity, de Vries (1963) soil heat capacity). Transcribed exactly from the Fortran; every template carries its source file:line in its description and returns one scalar (the CLM laws are all pointwise, so a template per output is sufficient). The remaining shared laws (soil/snow hydraulics, snow hydrology and albedo, Monin-Obukhov and aerodynamic laws, etc.) will be added here as their stage-2 components are implemented. The bare-ground fluxes component (stage2/clm_bareground.esm) adds the Monin-Obukhov surface-layer laws: the Paulson (1970) stability functions (the scalar one reused from ./cmeps_templates.esm by reference through psixhu_unstable, esm-spec 9.7.3; the momentum one authored fresh because its constant is SHR_CONST_PI*0.5 while the cmeps psimhu_unstable hard-codes 1.571, with the chik = sqrt(sqrt(1-16*zeta)) intermediate factored as stability_chik), the MoninObukIni initialization laws (wind speed, bulk Richardson number, initial zeta through the shared clamp_zeta), the four-branch friction-velocity profile laws (momentum and scalar, taking the stability parameter zeta as a parameter and sharing the stable branches as stable_profile_integral), the Meier2022 roughness laws (z0hg and the snowmelt-dependent z0mg), the Magnus dewpoint law, the virtual potential temperature scale/difference law (virtual_potential_scale, shared by dthv and thvstar) and the BareGroundFluxes flux laws (sensible_heat_flux, evaporation_flux, wind_stress_component, ref2m_profile). Reference: stage1/cesm/components/clm/src/biogeophys/.",
  "license": "MIT"
 },
 "expression_template_imports": [
  { "ref": "./cmeps_templates.esm" }
 ],
 "expression_templates": {
  "poly8": {
   "description": "Ninth-order power-sum polynomial c0 + c1*x + ... + c8*x^8, the mathematical form of the Flatau et al. (1992) saturation-vapor-pressure fits used by QSat (QSatMod.F90:18-56). Written as a power sum rather than the Fortran's nested Horner form (QSatMod.F90:93-97) for readability; the two agree to round-off.",
   "params": ["c0", "c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "x"],
   "body": {"op": "+", "args": [
    "c0",
    {"op": "*", "args": ["c1", "x"]},
    {"op": "*", "args": ["c2", {"op": "^", "args": ["x", 2]}]},
    {"op": "*", "args": ["c3", {"op": "^", "args": ["x", 3]}]},
    {"op": "*", "args": ["c4", {"op": "^", "args": ["x", 4]}]},
    {"op": "*", "args": ["c5", {"op": "^", "args": ["x", 5]}]},
    {"op": "*", "args": ["c6", {"op": "^", "args": ["x", 6]}]},
    {"op": "*", "args": ["c7", {"op": "^", "args": ["x", 7]}]},
    {"op": "*", "args": ["c8", {"op": "^", "args": ["x", 8]}]}
   ]}
  },
  "qsat_esat": {
   "description": "Saturation vapor pressure es(T) [Pa]: QSatMod.F90:90-100. td = min(100, max(-75, T - TKFRZ)); the water polynomial (coefficients a0..a8, QSatMod.F90:18-26) for td >= 0, the ice polynomial (c0..c8, QSatMod.F90:38-46) otherwise, scaled by 100 to Pa.",
   "params": ["T", "TKFRZ"],
   "body": {"op": "*", "args": [100.0, {"op": "ifelse", "args": [
    {"op": ">=", "args": [{"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}, 0.0]},
    {"op": "apply_expression_template", "args": [], "name": "poly8", "bindings": {
     "c0": 6.11213476, "c1": 0.444007856, "c2": 0.143064234e-1, "c3": 0.264461437e-3,
     "c4": 0.305903558e-5, "c5": 0.196237241e-7, "c6": 0.892344772e-10, "c7": -0.373208410e-12,
     "c8": 0.209339997e-15, "x": {"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}}},
    {"op": "apply_expression_template", "args": [], "name": "poly8", "bindings": {
     "c0": 6.11123516, "c1": 0.503109514, "c2": 0.188369801e-1, "c3": 0.420547422e-3,
     "c4": 0.614396778e-5, "c5": 0.602780717e-7, "c6": 0.387940929e-9, "c7": 0.149436277e-11,
     "c8": 0.262655803e-14, "x": {"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}}}
   ]}]}
  },
  "qsat_esat_dT": {
   "description": "d(es)/dT [Pa/K]: QSatMod.F90:108-117. The b0..b8 water fit (QSatMod.F90:28-36) for td >= 0, the d0..d8 ice fit (QSatMod.F90:48-56) otherwise, scaled by 100. td = min(100, max(-75, T - TKFRZ)).",
   "params": ["T", "TKFRZ"],
   "body": {"op": "*", "args": [100.0, {"op": "ifelse", "args": [
    {"op": ">=", "args": [{"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}, 0.0]},
    {"op": "apply_expression_template", "args": [], "name": "poly8", "bindings": {
     "c0": 0.444017302, "c1": 0.286064092e-1, "c2": 0.794683137e-3, "c3": 0.121211669e-4,
     "c4": 0.103354611e-6, "c5": 0.404125005e-9, "c6": -0.788037859e-12, "c7": -0.114596802e-13,
     "c8": 0.381294516e-16, "x": {"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}}},
    {"op": "apply_expression_template", "args": [], "name": "poly8", "bindings": {
     "c0": 0.503277922, "c1": 0.377289173e-1, "c2": 0.126801703e-2, "c3": 0.249468427e-4,
     "c4": 0.313703411e-6, "c5": 0.257180651e-8, "c6": 0.133268878e-10, "c7": 0.394116744e-13,
     "c8": 0.498070196e-16, "x": {"op": "min", "args": [100.0, {"op": "max", "args": [-75.0, {"op": "-", "args": ["T", "TKFRZ"]}]}]}}}
   ]}]}
  },
  "qsat_qs": {
   "description": "Saturation specific humidity qs(T,p) [kg/kg]: QSatMod.F90:101-103. vp = 1/(p - 0.378*es) [1/Pa]; qs = es * 0.622 * vp, with 0.622 and 0.378 the Rd/Rv molecular-weight ratios written bare in the Fortran. Shares qsat_esat by reference.",
   "params": ["T", "p", "TKFRZ"],
   "body": {"op": "*", "args": [
    {"op": "apply_expression_template", "args": [], "name": "qsat_esat", "bindings": {"T": "T", "TKFRZ": "TKFRZ"}},
    {"op": "const", "args": [], "value": 0.622, "units": "1"},
    {"op": "/", "args": [1.0, {"op": "-", "args": ["p", {"op": "*", "args": [{"op": "const", "args": [], "value": 0.378, "units": "1"}, {"op": "apply_expression_template", "args": [], "name": "qsat_esat", "bindings": {"T": "T", "TKFRZ": "TKFRZ"}}]}]}]}
   ]}
  },
  "qsat_qsdT": {
   "description": "d(qs)/dT [1/K]: QSatMod.F90:118-120. qsdT = esdT * vp1 * vp * p with vp1 = 0.622/(p - 0.378*es) and vp = 1/(p - 0.378*es), i.e. qsdT = 0.622*esdT*p/(p - 0.378*es)^2, with 0.622 and 0.378 the Rd/Rv molecular-weight ratios written bare in the Fortran. Shares qsat_esat and qsat_esat_dT by reference.",
   "params": ["T", "p", "TKFRZ"],
   "body": {"op": "*", "args": [
    {"op": "const", "args": [], "value": 0.622, "units": "1"},
    {"op": "apply_expression_template", "args": [], "name": "qsat_esat_dT", "bindings": {"T": "T", "TKFRZ": "TKFRZ"}},
    "p",
    {"op": "^", "args": [{"op": "/", "args": [1.0, {"op": "-", "args": ["p", {"op": "*", "args": [{"op": "const", "args": [], "value": 0.378, "units": "1"}, {"op": "apply_expression_template", "args": [], "name": "qsat_esat", "bindings": {"T": "T", "TKFRZ": "TKFRZ"}}]}]}]}, 2]}
   ]}
  },
  "soil_suction": {
   "description": "Soil matric potential smp = -sucsat * s^(-bsw) [mm], negative: SoilWaterRetentionCurveClappHornberg1978Mod.F90:115.",
   "params": ["sucsat", "bsw", "s"],
   "body": {"op": "*", "args": [-1.0, "sucsat", {"op": "^", "args": ["s", {"op": "-", "args": ["bsw"]}]}]}
  },
  "canopy_intercept_liq": {
   "description": "Canopy liquid-interception fraction fpiliq [1] (CLM5 default, use_clm5_fpi = .false.): CanopyHydrologyMod.F90:538. fpiliq = 0.25*(1 - exp(-0.5*(elai+esai))).",
   "params": ["elai", "esai"],
   "body": {"op": "*", "args": [0.25, {"op": "-", "args": [1.0, {"op": "exp", "args": [{"op": "*", "args": [-0.5, {"op": "+", "args": ["elai", "esai"]}]}]}]}]}
  },
  "canopy_intercept_snow": {
   "description": "Canopy snow-interception fraction fpisnow [1]: CanopyHydrologyMod.F90:541. fpisnow = 1 - exp(-0.5*(elai+esai)).",
   "params": ["elai", "esai"],
   "body": {"op": "-", "args": [1.0, {"op": "exp", "args": [{"op": "*", "args": [-0.5, {"op": "+", "args": ["elai", "esai"]}]}]}]}
  },
  "canopy_storage_max": {
   "description": "Maximum canopy storage canmx [mm H2O] = storage_scalar*(elai+esai): CanopyHydrologyMod.F90:755 (liq_canopy_storage_scalar) and :757 (snow_canopy_storage_scalar).",
   "params": ["storage_scalar", "elai", "esai"],
   "body": {"op": "*", "args": ["storage_scalar", {"op": "+", "args": ["elai", "esai"]}]}
  },
  "canopy_excess_flux": {
   "description": "Rate of excess canopy water falling off the canopy [mm H2O/s] = max((can - canmx)/dtime, 0): CanopyHydrologyMod.F90:756, 758.",
   "params": ["can", "canmx", "dtime"],
   "body": {"op": "max", "args": [{"op": "*", "args": [{"op": "-", "args": ["can", "canmx"]}, {"op": "/", "args": [1.0, "dtime"]}]}, 0.0]}
  },
  "pft_z0m_zengwang2007": {
   "description": "Momentum roughness length z0m = z0mr*htop [m], z0param_method = 'ZengWang2007': BiogeophysPreFluxCalcsMod.F90:175.",
   "params": ["z0mr", "htop"],
   "body": {"op": "*", "args": ["z0mr", "htop"]}
  },
  "pft_displa_zengwang2007": {
   "description": "Displacement height displa = displar*htop [m], z0param_method = 'ZengWang2007': BiogeophysPreFluxCalcsMod.F90:176.",
   "params": ["displar", "htop"],
   "body": {"op": "*", "args": ["displar", "htop"]}
  },
  "vegetation_emissivity": {
   "description": "Vegetation emissivity emv = 1 - exp(-(elai+esai)/avmuir) [1]: BiogeophysPreFluxCalcsMod.F90:397.",
   "params": ["elai", "esai", "avmuir"],
   "body": {"op": "-", "args": [1.0, {"op": "exp", "args": [{"op": "*", "args": [-1.0, {"op": "/", "args": [{"op": "+", "args": ["elai", "esai"]}, "avmuir"]}]}]}]}
  },
  "ground_emissivity": {
   "description": "Ground emissivity emg = (1-frac_sno)*emg_soil + frac_sno*emg_snow [1], emg_soil = 0.96, emg_snow = 0.97: BiogeophysPreFluxCalcsMod.F90:348.",
   "params": ["frac_sno_albedo", "emg_soil", "emg_snow"],
   "body": {"op": "+", "args": [{"op": "*", "args": [{"op": "-", "args": [1.0, "frac_sno_albedo"]}, "emg_soil"]}, {"op": "*", "args": ["frac_sno_albedo", "emg_snow"]}]}
  },
  "latent_heat_of_vapor": {
   "description": "Latent heat of vaporization or sublimation htvp [J/kg]: BiogeophysPreFluxCalcsMod.F90:354-358. hsub when the top layer has ice but no liquid (h2osoi_liq <= 0 and h2osoi_ice > 0), else hvap.",
   "params": ["h2osoi_liq_top", "h2osoi_ice_top", "hvap", "hsub"],
   "body": {"op": "ifelse", "args": [
    {"op": "and", "args": [{"op": "<=", "args": ["h2osoi_liq_top", 0.0]}, {"op": ">", "args": ["h2osoi_ice_top", 0.0]}]},
    "hsub", "hvap"
   ]}
  },
  "snow_bulk_density": {
   "description": "Snow bulk density bw = (h2osoi_ice + h2osoi_liq)/(frac_sno_fluxes*dz) [kg/m3]: SoilTemperatureMod.F90:744. frac_sno_fluxes is the snow-covered fraction used for heat-flux calculations (0..1); the stage-1 W3 dump exercises frac_sno_fluxes = 1 exactly.",
   "params": ["h2osoi_ice", "h2osoi_liq", "frac_sno_fluxes", "dz"],
   "body": {"op": "/", "args": [
    {"op": "+", "args": ["h2osoi_ice", "h2osoi_liq"]},
    {"op": "*", "args": ["frac_sno_fluxes", "dz"]}
   ]}
  },
  "snow_thermal_cond_sturm1997": {
   "description": "Snow thermal conductivity thk [W/m/K] of the Sturm et al. (1997) fit as implemented in SoilTemperatureMod.F90:774-778 (bw in kg/m3): thk = 0.023 + 0.234*(bw/1000) for bw <= 156, else thk = 0.138 - 1.01*(bw/1000) + 3.233*(bw/1000)^2. The traced run uses the Sturm1997 snow_thermal_cond_method. The five literals in the Fortran lack the _r8 suffix, so under default real(4) the executed coefficients are the float32-rounded values written here (0.023000000044703484, 0.23399999737739563, 0.1379999965429306, 1.0099999904632568, 3.2330000400543213) promoted to double, not the paper's coefficients (bugs.md #33; verified in the compiled object's .rodata.cst8 and against the dump to rel 1.6e-16).",
   "params": ["bw"],
   "body": {"op": "ifelse", "args": [
    {"op": "<=", "args": ["bw", {"op": "const", "args": [], "value": 156.0, "units": "kg/m^3"}]},
    {"op": "+", "args": [{"op": "const", "args": [], "value": 0.023000000044703484, "units": "W/m/K"}, {"op": "*", "args": [{"op": "const", "args": [], "value": 0.23399999737739563, "units": "W/m/K"}, {"op": "/", "args": ["bw", {"op": "const", "args": [], "value": 1000.0, "units": "kg/m^3"}]}]}]},
    {"op": "+", "args": [{"op": "const", "args": [], "value": 0.1379999965429306, "units": "W/m/K"}, {"op": "*", "args": [{"op": "const", "args": [], "value": -1.0099999904632568, "units": "W/m/K"}, {"op": "/", "args": ["bw", {"op": "const", "args": [], "value": 1000.0, "units": "kg/m^3"}]}]}, {"op": "*", "args": [{"op": "const", "args": [], "value": 3.2330000400543213, "units": "W/m/K"}, {"op": "^", "args": [{"op": "/", "args": ["bw", {"op": "const", "args": [], "value": 1000.0, "units": "kg/m^3"}]}, {"op": "const", "args": [], "value": 2, "units": "1"}]}]}]}
   ]}
  },
  "snow_thermal_cond_jordan1991": {
   "description": "Snow thermal conductivity thk [W/m/K] of the Jordan (1991) fit as implemented in SoilTemperatureMod.F90:767 (bw in kg/m3): thk = tkair + (7.75e-5*bw + 1.105e-6*bw^2)*(tkice - tkair). The Jordan1991 method is the alternate snow_thermal_cond_method; the traced run uses Sturm1997 so this template is not exercised by the dump.",
   "params": ["bw", "tkair", "tkice"],
   "body": {"op": "+", "args": ["tkair", {"op": "*", "args": [
    {"op": "+", "args": [{"op": "*", "args": [{"op": "const", "args": [], "value": 7.75e-5, "units": "m^3/kg"}, "bw"]}, {"op": "*", "args": [{"op": "const", "args": [], "value": 1.105e-6, "units": "m^6/kg^2"}, {"op": "^", "args": ["bw", {"op": "const", "args": [], "value": 2, "units": "1"}]}]}]},
    {"op": "-", "args": ["tkice", "tkair"]}
   ]}]}
  },
  "snow_heat_capacity": {
   "description": "Snow heat capacity cv = max(thin_sfclayer, (cpliq*h2osoi_liq + cpice*h2osoi_ice)/frac_sno_fluxes) [J/m2/K], the thin-layer floor of SoilTemperatureMod.F90:892-895 (cv is per unit ground area, h2osoi_* in kg/m2). The else branch is thin_sfclayer + 0*h2osoi_liq, value-identical to the scalar thin_sfclayer, so both branches of the ifelse under the runtime scalar condition frac_sno_fluxes > 0 share one value box, which the strict native compiler requires when the template is applied whole-array inside a const-cadence observed (esm-libraries-spec 2.5.10). The thin_sfclayer floor never binds in the dump (all snow layers have dz >= thin_sfclayer).",
   "params": ["h2osoi_liq", "h2osoi_ice", "frac_sno_fluxes", "cpliq", "cpice", "thin_sfclayer"],
   "body": {"op": "ifelse", "args": [
    {"op": ">", "args": ["frac_sno_fluxes", {"op": "const", "args": [], "value": 0.0, "units": "1"}]},
    {"op": "max", "args": ["thin_sfclayer", {"op": "/", "args": [
     {"op": "+", "args": [{"op": "*", "args": ["cpliq", "h2osoi_liq"]}, {"op": "*", "args": ["cpice", "h2osoi_ice"]}]},
     "frac_sno_fluxes"]}]},
    {"op": "+", "args": ["thin_sfclayer", {"op": "*", "args": [{"op": "const", "args": [], "value": 0.0, "units": "J/kg/K"}, "h2osoi_liq"]}]}
   ]}
  },
  "soil_saturation_water_content": {
   "description": "Soil water saturation satw = min(1, (h2osoi_liq/denh2o + h2osoi_ice/denice + excess_ice/denice)/(dz*watsat)) [1]: SoilTemperatureMod.F90:712-713. excess_ice is the excess-ice water equivalent (use_excess_ice = .true. in the run; 0 for all dumped columns).",
   "params": ["h2osoi_liq", "h2osoi_ice", "excess_ice", "dz", "watsat", "denh2o", "denice"],
   "body": {"op": "min", "args": [{"op": "const", "args": [], "value": 1.0, "units": "1"}, {"op": "/", "args": [
    {"op": "+", "args": [
     {"op": "/", "args": ["h2osoi_liq", "denh2o"]},
     {"op": "/", "args": ["h2osoi_ice", "denice"]},
     {"op": "/", "args": ["excess_ice", "denice"]}]},
    {"op": "*", "args": ["dz", "watsat"]}
   ]}]}
  },
  "kersten_number": {
   "description": "Kersten number dke [1] of the Johansen (1975) soil thermal conductivity: SoilTemperatureMod.F90:715-719. dke = satw for frozen soil (t_soisno < tfrz), dke = max(0, log10(satw) + 1) for unfrozen soil.",
   "params": ["satw", "t_soisno", "tfrz"],
   "body": {"op": "ifelse", "args": [
    {"op": ">=", "args": ["t_soisno", "tfrz"]},
    {"op": "max", "args": [{"op": "const", "args": [], "value": 0.0, "units": "1"}, {"op": "+", "args": [{"op": "log10", "args": ["satw"]}, {"op": "const", "args": [], "value": 1.0, "units": "1"}]}]},
    "satw"
   ]}
  },
  "soil_liquid_fraction": {
   "description": "Liquid fraction of soil water fl = (h2osoi_liq/(denh2o*dz))/(h2osoi_liq/(denh2o*dz) + h2osoi_ice/(denice*dz) + excess_ice/(denice*dz)) [1]: SoilTemperatureMod.F90:721-723.",
   "params": ["h2osoi_liq", "h2osoi_ice", "excess_ice", "dz", "denh2o", "denice"],
   "body": {"op": "/", "args": [
    {"op": "/", "args": ["h2osoi_liq", {"op": "*", "args": ["denh2o", "dz"]}]},
    {"op": "+", "args": [
     {"op": "/", "args": ["h2osoi_liq", {"op": "*", "args": ["denh2o", "dz"]}]},
     {"op": "/", "args": ["h2osoi_ice", {"op": "*", "args": ["denice", "dz"]}]},
     {"op": "/", "args": ["excess_ice", {"op": "*", "args": ["denice", "dz"]}]}
    ]}
   ]}
  },
  "soil_saturated_thermal_cond": {
   "description": "Saturated soil thermal conductivity dksat = tkmg*tkwat^(fl*watsat)*tkice^((1-fl)*watsat) [W/m/K] of the Johansen (1975) law: SoilTemperatureMod.F90:724. tkmg is the saturated conductivity of the mineral matrix (tkmg = tkm^(1-watsat) from the soil-texture initialization, SoilStateInitTimeConstMod.F90:581), so the exponent (1-watsat) is folded in; fl is the liquid fraction of soil water.",
   "params": ["tkmg", "fl", "watsat", "tkwat", "tkice"],
   "body": {"op": "*", "args": [
    "tkmg",
    {"op": "^", "args": ["tkwat", {"op": "*", "args": ["fl", "watsat"]}]},
    {"op": "^", "args": ["tkice", {"op": "*", "args": [{"op": "-", "args": [{"op": "const", "args": [], "value": 1.0, "units": "1"}, "fl"]}, "watsat"]}]}
   ]}
  },
  "soil_thermal_cond": {
   "description": "Soil thermal conductivity thk [W/m/K] of the Johansen (1975) law as implemented in SoilTemperatureMod.F90:712-727, in the named-intermediate form: thk = dke*dksat + (1-dke)*tkdry when satw > 1e-7 (the Fortran threshold is the .1e-6_r8 literal = 1e-7), thk = tkdry otherwise, with the saturation water content satw, the Kersten number dke and the saturated conductivity dksat as NAMED intermediate parameters, each defined once by the caller from soil_saturation_water_content, kersten_number and soil_saturated_thermal_cond (the ESM template format admits params + body only, so naming the intermediates once requires the caller to compute them as observeds: clm_soiltemp.esm declares satw/dke/fl/dksat exactly that way; the bedrock override thk_bedrock at :727 is applied by the caller's layer mask).",
   "params": ["satw", "dke", "dksat", "tkdry"],
   "body": {"op": "ifelse", "args": [
    {"op": ">", "args": ["satw", {"op": "const", "args": [], "value": 1.0e-7, "units": "1"}]},
    {"op": "+", "args": [
     {"op": "*", "args": ["dke", "dksat"]},
     {"op": "*", "args": [{"op": "-", "args": [{"op": "const", "args": [], "value": 1.0, "units": "1"}, "dke"]}, "tkdry"]}
    ]},
    "tkdry"
   ]}
  },
  "soil_heat_capacity": {
   "description": "Soil heat capacity cv = csol*(1-watsat)*dz + h2osoi_ice*cpice + h2osoi_liq*cpliq + excess_ice*cpice [J/m2/K] (de Vries, 1963), per unit ground area: SoilTemperatureMod.F90:852-854. csol is the mineral+organic matrix volumetric heat capacity, watsat the porosity; the dump pins only the product csol*(1-watsat).",
   "params": ["csol", "watsat", "dz", "h2osoi_ice", "h2osoi_liq", "excess_ice", "cpice", "cpliq"],
   "body": {"op": "+", "args": [
    {"op": "*", "args": ["csol", {"op": "-", "args": [{"op": "const", "args": [], "value": 1.0, "units": "1"}, "watsat"]}, "dz"]},
    {"op": "*", "args": ["h2osoi_ice", "cpice"]},
    {"op": "*", "args": ["h2osoi_liq", "cpliq"]},
    {"op": "*", "args": ["excess_ice", "cpice"]}
   ]}
  },
  "clm_interface_conductivity": {
   "description": "Harmonic-mean thermal conductivity tk [W/m/K] at the interface between two adjacent layers, from the assumption that the flux across the interface equals the flux from each node to the interface: tk = thk1*thk2*(z2-z1)/(thk1*(z2-zi) + thk2*(zi-z1)) with thk1/thk2 the layer conductivities, z1/z2 the layer-center depths and zi the interface depth between them (SoilTemperatureMod.F90:825-826). The bottom of the column carries no interface (tk = 0 at :828; handled by the caller).",
   "params": ["thk1", "thk2", "z1", "z2", "zi"],
   "body": {"op": "/", "args": [
    {"op": "*", "args": ["thk1", "thk2", {"op": "-", "args": ["z2", "z1"]}]},
    {"op": "+", "args": [
     {"op": "*", "args": ["thk1", {"op": "-", "args": ["z2", "zi"]}]},
     {"op": "*", "args": ["thk2", {"op": "-", "args": ["zi", "z1"]}]}]}
    ]}
  },
  "stability_chik": {
   "description": "chik = sqrt(sqrt(1 - 16*zeta)), the intermediate of the Paulson (1970) momentum stability function (FrictionVelocityMod.F90:1131-1132). Factored so the 1 - 16*zeta subexpression is authored once and bound by stability_func_momentum by reference (chik2 = chik^2 of the Fortran's chik2 = sqrt(1 - 16*zeta)).",
   "params": ["zeta"],
   "body": {"op": "sqrt", "args": [{"op": "sqrt", "args": [{"op": "-", "args": [1.0, {"op": "*", "args": [16.0, "zeta"]}]}]}]}
  },
  "stability_func_momentum": {
   "description": "Paulson (1970) unstable momentum stability function StabilityFunc1(zeta) of FrictionVelocityMod.F90:1131-1134: chik2 = sqrt(1 - 16*zeta), chik = sqrt(chik2), 2*log((1+chik)*0.5) + log((1+chik2)*0.5) - 2*atan(chik) + SHR_CONST_PI*0.5, with chik/chik2 bound once via the stability_chik template by reference. The trailing constant is SHR_CONST_PI*0.5 = 1.5707963267948966 exactly (clm_varcon.F90:42, rpi = SHR_CONST_PI); the cmeps psimhu_unstable hard-codes 1.571 instead, so this template is authored fresh rather than reused. Only the rib < 0 (unstable) branch is transcribed here; the stable branch of the flux-gradient relations is the linear 5*zeta form written directly in the profile templates.",
   "params": ["zeta"],
   "body": {"op": "+", "args": [
    {"op": "*", "args": [2.0, {"op": "log", "args": [{"op": "*", "args": [{"op": "+", "args": [1.0, {"op": "apply_expression_template", "args": [], "name": "stability_chik", "bindings": {"zeta": "zeta"}}]}, 0.5]}]}]},
    {"op": "log", "args": [{"op": "*", "args": [{"op": "+", "args": [1.0, {"op": "^", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_chik", "bindings": {"zeta": "zeta"}}, 2]}]}, 0.5]}]},
    {"op": "*", "args": [-2.0, {"op": "atan", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_chik", "bindings": {"zeta": "zeta"}}]}]},
    {"op": "const", "args": [], "value": 1.5707963267948966, "units": "1"}
   ]}
  },
  "stability_func_scalar": {
   "description": "Paulson (1970) unstable scalar stability function StabilityFunc2(zeta) of FrictionVelocityMod.F90:1151-1152: 2*log((1 + sqrt(1 - 16*zeta))*0.5). This is exactly the cmeps psixhu_unstable (flux_atmocn_Large.F90:164) evaluated at x = (1 - 16*zeta)^0.25, so it is reused by reference (esm-spec 9.7.3) rather than re-authored.",
   "params": ["zeta"],
   "body": {"op": "apply_expression_template", "args": [], "name": "psixhu_unstable", "bindings": {"x": {"op": "^", "args": [{"op": "-", "args": [1.0, {"op": "*", "args": [16.0, "zeta"]}]}, 0.25]}}}
  },
  "monin_obukhov_initial_wind": {
   "description": "Initial wind speed um of MoninObukIni (FrictionVelocityMod.F90:1190-1194): wc = 0.5 m/s convective velocity; if dthv >= 0 then um = max(ur, 0.1 m/s) else um = sqrt(ur^2 + wc^2). The companion initial ustar = 0.06 (F90:1189) is never read after the MoninObukIni call in BareGroundFluxesMod, so it is omitted. Also applied to the stability-iteration update of um (BareGroundFluxesMod.F90:370,373), whose branch test is zeta_raw >= 0 instead of dthv >= 0.",
   "params": ["dthv", "ur", "wc"],
   "body": {"op": "ifelse", "args": [
    {"op": ">=", "args": ["dthv", 0.0]},
    {"op": "max", "args": ["ur", {"op": "const", "args": [], "value": 0.1, "units": "m/s"}]},
    {"op": "sqrt", "args": [{"op": "+", "args": [{"op": "^", "args": ["ur", 2]}, {"op": "^", "args": ["wc", 2]}]}]}
   ]}
  },
  "bulk_richardson": {
   "description": "Bulk Richardson number rib of MoninObukIni (FrictionVelocityMod.F90:1196): rib = grav*zldis*dthv/(thv*um^2).",
   "params": ["grav", "zldis", "dthv", "thv", "um"],
   "body": {"op": "/", "args": [
    {"op": "*", "args": ["grav", "zldis", "dthv"]},
    {"op": "*", "args": ["thv", {"op": "^", "args": ["um", 2]}]}
   ]}
  },
  "clamp_zeta": {
   "description": "Sign-preserving clamp of the Monin-Obukhov stability parameter zeta (BareGroundFluxesMod.F90:369-374 and FrictionVelocityMod.F90:1200-1204): stable/neutral branch (zeta >= 0) zeta = min(zetamaxstable, max(zeta, 0.01)), unstable branch zeta = max(-100, min(zeta, -0.01)). Shared by the MoninObukIni initialization (monin_obukhov_initial_zeta) and every pass of the BareGroundFluxes stability iteration.",
   "params": ["zeta", "zetamaxstable"],
   "body": {"op": "ifelse", "args": [
    {"op": ">=", "args": ["zeta", 0.0]},
    {"op": "min", "args": ["zetamaxstable", {"op": "max", "args": ["zeta", {"op": "const", "args": [], "value": 0.01, "units": "1"}]}]},
    {"op": "max", "args": [{"op": "const", "args": [], "value": -100.0, "units": "1"}, {"op": "min", "args": ["zeta", {"op": "const", "args": [], "value": -0.01, "units": "1"}]}]}
   ]}
  },
  "monin_obukhov_initial_zeta": {
   "description": "Initial Monin-Obukhov stability parameter zeta of MoninObukIni (FrictionVelocityMod.F90:1198-1204). Stable/neutral branch (rib >= 0): zeta = rib*log(zldis/z0m)/(1 - 5*min(rib, 0.19)); unstable branch: zeta = rib*log(zldis/z0m); the branch result then passes through the sign-preserving clamp of clamp_zeta, shared with the stability-iteration clamp. The Obukhov length follows as obu = zldis/zeta at the call site.",
   "params": ["rib", "zldis", "z0m", "zetamaxstable"],
   "body": {"op": "apply_expression_template", "args": [], "name": "clamp_zeta", "bindings": {
    "zeta": {"op": "ifelse", "args": [
     {"op": ">=", "args": ["rib", 0.0]},
     {"op": "/", "args": [{"op": "*", "args": ["rib", {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0m"]}]}]}, {"op": "-", "args": [1.0, {"op": "*", "args": [5.0, {"op": "min", "args": ["rib", 0.19]}]}]}]},
     {"op": "*", "args": ["rib", {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0m"]}]}]}
    ]},
    "zetamaxstable": "zetamaxstable"
   }}
  },
  "stable_profile_integral": {
   "description": "The stable/neutral branches of the integrated flux-profile integral v, the denominator of the friction-velocity laws (v in ustar = vkc*um/v and temp = vkc/v), identical for the momentum (FrictionVelocityMod.F90:865-869) and scalar (F90:964-968) profiles: zeta <= 1: v = log(zldis/z0) + 5*zeta - 5*z0/obu; zeta > 1: v = log(obu/z0) + 5 - 5*z0/obu + (5*log(zeta) + zeta - 1), in the stability parameter zeta = zldis/obu. Shared by friction_velocity_momentum and friction_velocity_scalar by reference.",
   "params": ["zldis", "z0", "obu", "zeta"],
   "body": {"op": "ifelse", "args": [
    {"op": "<=", "args": ["zeta", 1.0]},
    {"op": "+", "args": [
     {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0"]}]},
     {"op": "*", "args": [5.0, "zeta"]},
     {"op": "-", "args": [{"op": "*", "args": [5.0, {"op": "/", "args": ["z0", "obu"]}]}]}
    ]},
    {"op": "+", "args": [
     {"op": "log", "args": [{"op": "/", "args": ["obu", "z0"]}]},
     5.0,
     {"op": "-", "args": [{"op": "*", "args": [5.0, {"op": "/", "args": ["z0", "obu"]}]}]},
     {"op": "+", "args": [
      {"op": "*", "args": [5.0, {"op": "log", "args": ["zeta"]}]},
      "zeta",
      -1.0
     ]}
    ]}
   ]}
  },
  "friction_velocity_momentum": {
   "description": "Momentum profile: friction velocity ustar = vkc*um/v of FrictionVelocity (FrictionVelocityMod.F90:857-871), where v is the four-branch integral of the wind profile in the stability parameter zeta, passed in and computed once at the call site as zldis/obu (zetam = 1.574 is the transition point of the flux-gradient relation, F90:795). Branches: zeta < -zetam: v = log(-zetam*obu/z0m) - StabilityFunc1(-zetam) + StabilityFunc1(z0m/obu) + 1.14*((-zeta)^0.333 - zetam^0.333); zeta < 0: v = log(zldis/z0m) - StabilityFunc1(zeta) + StabilityFunc1(z0m/obu); the stable branches (zeta <= 1 and zeta > 1) are the shared stable_profile_integral, applied by reference.",
   "params": ["vkc", "um", "zldis", "z0m", "obu", "zetam", "zeta"],
   "body": {"op": "*", "args": ["vkc", "um", {"op": "/", "args": [1.0, {"op": "ifelse", "args": [
    {"op": "<", "args": ["zeta", {"op": "-", "args": ["zetam"]}]},
    {"op": "+", "args": [
     {"op": "log", "args": [{"op": "/", "args": [{"op": "*", "args": [{"op": "-", "args": ["zetam"]}, "obu"]}, "z0m"]}]},
     {"op": "-", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_func_momentum", "bindings": {"zeta": {"op": "-", "args": ["zetam"]}}}]},
     {"op": "apply_expression_template", "args": [], "name": "stability_func_momentum", "bindings": {"zeta": {"op": "/", "args": ["z0m", "obu"]}}},
     {"op": "*", "args": [1.14, {"op": "-", "args": [{"op": "^", "args": [{"op": "-", "args": ["zeta"]}, 0.333]}, {"op": "^", "args": ["zetam", 0.333]}]}]}
    ]},
    {"op": "ifelse", "args": [
     {"op": "<", "args": ["zeta", 0.0]},
     {"op": "+", "args": [
      {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0m"]}]},
      {"op": "-", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_func_momentum", "bindings": {"zeta": "zeta"}}]},
      {"op": "apply_expression_template", "args": [], "name": "stability_func_momentum", "bindings": {"zeta": {"op": "/", "args": ["z0m", "obu"]}}}
     ]},
     {"op": "apply_expression_template", "args": [], "name": "stable_profile_integral", "bindings": {
      "zldis": "zldis", "z0": "z0m", "obu": "obu", "zeta": "zeta"
     }}
    ]}
   ]}]}]}
  },
  "friction_velocity_scalar": {
   "description": "Scalar (heat/water) profile factor temp = vkc/v of FrictionVelocity (FrictionVelocityMod.F90:956-970 for the heat profile temp1 at the measurement height; the same law with the z0q roughness and zldis = 2 + z0h/z0q serves the humidity profile temp2 (F90:974-1015, equal to temp1 when forc_hgt_q == forc_hgt_t and z0q == z0h, which holds in the traced run) and the 2-m diagnostics temp12m/temp22m (F90:1022-1038, 1051-1067)), where v is the four-branch integral of the profile in the stability parameter zeta, passed in and computed once at the call site as zldis/obu (zetat = 0.465 is the transition point of the temperature profile, F90:796). Branches: zeta < -zetat: v = log(-zetat*obu/z0) - StabilityFunc2(-zetat) + StabilityFunc2(z0/obu) + 0.8*(zetat^(-0.333) - (-zeta)^(-0.333)); zeta < 0: v = log(zldis/z0) - StabilityFunc2(zeta) + StabilityFunc2(z0/obu); the stable branches (zeta <= 1 and zeta > 1) are the shared stable_profile_integral, applied by reference.",
   "params": ["vkc", "zldis", "z0", "obu", "zetat", "zeta"],
   "body": {"op": "*", "args": ["vkc", {"op": "/", "args": [1.0, {"op": "ifelse", "args": [
    {"op": "<", "args": ["zeta", {"op": "-", "args": ["zetat"]}]},
    {"op": "+", "args": [
     {"op": "log", "args": [{"op": "/", "args": [{"op": "*", "args": [{"op": "-", "args": ["zetat"]}, "obu"]}, "z0"]}]},
     {"op": "-", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_func_scalar", "bindings": {"zeta": {"op": "-", "args": ["zetat"]}}}]},
     {"op": "apply_expression_template", "args": [], "name": "stability_func_scalar", "bindings": {"zeta": {"op": "/", "args": ["z0", "obu"]}}},
     {"op": "*", "args": [0.8, {"op": "-", "args": [{"op": "^", "args": ["zetat", -0.333]}, {"op": "^", "args": [{"op": "-", "args": ["zeta"]}, -0.333]}]}]}
    ]},
    {"op": "ifelse", "args": [
     {"op": "<", "args": ["zeta", 0.0]},
     {"op": "+", "args": [
      {"op": "log", "args": [{"op": "/", "args": ["zldis", "z0"]}]},
      {"op": "-", "args": [{"op": "apply_expression_template", "args": [], "name": "stability_func_scalar", "bindings": {"zeta": "zeta"}}]},
      {"op": "apply_expression_template", "args": [], "name": "stability_func_scalar", "bindings": {"zeta": {"op": "/", "args": ["z0", "obu"]}}}
     ]},
     {"op": "apply_expression_template", "args": [], "name": "stable_profile_integral", "bindings": {
      "zldis": "zldis", "z0": "z0", "obu": "obu", "zeta": "zeta"
     }}
    ]}
   ]}]}]}
  },
  "z0hg_meier2022": {
   "description": "Meier2022 ground scalar-roughness update z0hg (BareGroundFluxesMod.F90:365, after Yang et al. 2008): z0hg = meier_param3*nu_param/ustar*exp(-beta_param*ustar^0.5*|tstar|^0.25), with meier_param3 = 70 (clm_varcon.F90:171), nu_param = 1.5e-5 m^2/s kinematic viscosity of air (clm_varcon.F90:165) and beta_param = 7.2 (s/m)^0.5/K^0.25 (clm_varcon.F90:164). The traced run uses z0param_method = 'Meier2022'.",
   "params": ["meier_param3", "nu_param", "ustar", "beta_param", "tstar"],
   "body": {"op": "*", "args": [
    {"op": "*", "args": ["meier_param3", {"op": "/", "args": ["nu_param", "ustar"]}]},
    {"op": "exp", "args": [{"op": "*", "args": [
     {"op": "-", "args": ["beta_param"]},
     {"op": "^", "args": ["ustar", 0.5]},
     {"op": "^", "args": [{"op": "abs", "args": ["tstar"]}, 0.25]}
    ]}]}
   ]}
  },
  "z0mg_meier2022_snowmelt": {
   "description": "Meier2022 ground momentum roughness over snow-covered ground z0mg (FrictionVelocityMod.F90:620-623, the use_z0m_snowmelt = .true. branch of SetRoughnessLengthsAndForcHeightsNonLake): z0mg = exp(-b1_param*pi*0.5 + b4_param)*1e-3 when snomelt_accum < 1e-5 m, else exp(b1_param*atan((log10(snomelt_accum) + meier_param1)/meier_param2) + b4_param)*1e-3, with b1_param = 1.4, b4_param = -0.31, meier_param1 = 0.23, meier_param2 = 0.08 (clm_varcon.F90:166-170) and pi = SHR_CONST_PI = 3.141592653589793 (so pi*0.5 = 1.5707963267948966). The log10 argument is written as snomelt_accum/1 m so the unit algebra closes (the Fortran takes log10 of a length in m). The traced rows all fall in the snomelt_accum < 1e-5 branch (z0mg = exp(-1.4*pi/2 - 0.31)*1e-3 = 8.13402050576016129e-05).",
   "params": ["snomelt_accum", "b1_param", "b4_param", "meier_param1", "meier_param2"],
   "body": {"op": "*", "args": [
    {"op": "const", "args": [], "value": 1.0e-3, "units": "m"},
    {"op": "ifelse", "args": [
     {"op": "<", "args": ["snomelt_accum", {"op": "const", "args": [], "value": 1.0e-5, "units": "m"}]},
     {"op": "exp", "args": [{"op": "+", "args": [
      {"op": "*", "args": [{"op": "-", "args": ["b1_param"]}, {"op": "const", "args": [], "value": 1.5707963267948966, "units": "1"}]},
      "b4_param"
     ]}]},
     {"op": "exp", "args": [{"op": "+", "args": [
      {"op": "*", "args": ["b1_param", {"op": "atan", "args": [{"op": "/", "args": [
       {"op": "+", "args": [{"op": "log10", "args": [{"op": "/", "args": ["snomelt_accum", {"op": "const", "args": [], "value": 1.0, "units": "m"}]}]}, "meier_param1"]},
       "meier_param2"
      ]}]}]},
      "b4_param"
     ]}]}
    ]}
   ]}
  },
  "virtual_potential_scale": {
   "description": "Virtual potential temperature scale/difference x_v = x*(1 + 0.61*forc_q) + 0.61*forc_th*y [K]: BareGroundFluxesMod.F90:328 for the difference dthv = dth*(1 + 0.61*forc_q) + 0.61*forc_th*dqh and F90:367 for the scale thvstar = tstar*(1 + 0.61*forc_q) + 0.61*forc_th*qstar. The 0.61 virtual-temperature factor is the Fortran's bare constant, transcribed with its unit.",
   "params": ["x", "forc_q", "forc_th", "y"],
   "body": {"op": "+", "args": [
    {"op": "*", "args": ["x", {"op": "+", "args": [
     {"op": "const", "args": [], "value": 1.0, "units": "1"},
     {"op": "*", "args": [{"op": "const", "args": [], "value": 0.61, "units": "1"}, "forc_q"]}
    ]}]},
    {"op": "*", "args": [{"op": "const", "args": [], "value": 0.61, "units": "1"}, "forc_th", "y"]}
   ]}
  },
  "dewpoint_magnus": {
   "description": "Dewpoint temperature [K] from vapor pressure e and temperature t (BareGroundFluxesMod.F90:548-578, dewpoint(), Equation 7 of Lawrence 2005 with the Alduchov & Eskridge 1996 coefficients): td = ifelse(t < tfrz, B1_ice*log(e/C1_ice)/(A1_ice - log(e/C1_ice)), B1_liq*log(e/C1_liq)/(A1_liq - log(e/C1_liq))) + tfrz, with A1_ice = 22.587, B1_ice = 273.86 K, C1_ice = 611.21 Pa and A1_liq = 17.625, B1_liq = 243.04 K, C1_liq = 610.94 Pa. The ice/liquid selection is on the input temperature t (t_grnd at the call site), not on the dewpoint. The traced rows all have t_grnd ~ 234-250 K < tfrz, so the ice branch is the one exercised; only the sign of t_grnd - forc_dewpoint is pinned by the raiw gate.",
   "params": ["e", "t", "tfrz"],
   "body": {"op": "+", "args": [
    {"op": "ifelse", "args": [
     {"op": "<", "args": ["t", "tfrz"]},
     {"op": "/", "args": [
      {"op": "*", "args": [{"op": "const", "args": [], "value": 273.86, "units": "K"}, {"op": "log", "args": [{"op": "/", "args": ["e", {"op": "const", "args": [], "value": 611.21, "units": "Pa"}]}]}]},
      {"op": "-", "args": [{"op": "const", "args": [], "value": 22.587, "units": "1"}, {"op": "log", "args": [{"op": "/", "args": ["e", {"op": "const", "args": [], "value": 611.21, "units": "Pa"}]}]}]}
     ]},
     {"op": "/", "args": [
      {"op": "*", "args": [{"op": "const", "args": [], "value": 243.04, "units": "K"}, {"op": "log", "args": [{"op": "/", "args": ["e", {"op": "const", "args": [], "value": 610.94, "units": "Pa"}]}]}]},
      {"op": "-", "args": [{"op": "const", "args": [], "value": 17.625, "units": "1"}, {"op": "log", "args": [{"op": "/", "args": ["e", {"op": "const", "args": [], "value": 610.94, "units": "Pa"}]}]}]}
     ]}
    ]},
    "tfrz"
   ]}
  },
  "sensible_heat_flux": {
   "description": "Sensible heat flux from a surface eflx_sh = -raih*(thm - t_surf) [W/m^2] (BareGroundFluxesMod.F90:449-454, applied to the ground temperature t_grnd, the top snow layer t_soisno(c, snl+1), the top soil layer t_soisno(c, 1) and the h2osfc surface).",
   "params": ["raih", "thm", "t_surf"],
   "body": {"op": "-", "args": [{"op": "*", "args": ["raih", {"op": "-", "args": ["thm", "t_surf"]}]}]}
  },
  "evaporation_flux": {
   "description": "Evaporation flux from a surface qflx_ev = -raiw*(forc_q - qg_surf) [kg/m^2/s] (BareGroundFluxesMod.F90:460-467, applied to the ground humidity qg and the snow/soil/h2osfc surface humidities; qflx_evap_soi = -raiw*dqh with dqh = forc_q - qg of F90:327).",
   "params": ["raiw", "forc_q", "qg_surf"],
   "body": {"op": "-", "args": [{"op": "*", "args": ["raiw", {"op": "-", "args": ["forc_q", "qg_surf"]}]}]}
  },
  "wind_stress_component": {
   "description": "One component of the surface wind stress taux/tauy = -forc_rho*forc_u/ram [kg/m/s^2] (BareGroundFluxesMod.F90:447-448, with ram = um/ustar^2 the momentum aerodynamic resistance of F90:396).",
   "params": ["forc_rho", "forc_u", "ram"],
   "body": {"op": "-", "args": [{"op": "*", "args": ["forc_rho", "forc_u", {"op": "/", "args": [1.0, "ram"]}]}]}
  },
  "ref2m_profile": {
   "description": "2-m height profile value x_ref2m = base + temp*delta*(1/temp2m - 1/temp): the temperature and humidity profile extrapolations of BareGroundFluxesMod.F90:470 (t_ref2m = thm + temp1*dth*(1/temp12m - 1/temp1)) and F90:473 (q_ref2m = forc_q + temp2*dqh*(1/temp22m - 1/temp2)).",
   "params": ["base", "temp", "delta", "temp2m"],
   "body": {"op": "+", "args": ["base", {"op": "*", "args": ["temp", "delta", {"op": "-", "args": [{"op": "/", "args": [1.0, "temp2m"]}, {"op": "/", "args": [1.0, "temp"]}]}]}]}
  },
  "soil_albedo_wetness": {
   "description": "Soil albedo wetness correction inc = max(0.11 - 0.40*h2osoi_vol, 0) [1]: the SoilAlbedo soil water factor of SurfaceAlbedoMod.F90:1244, h2osoi_vol the top-layer volumetric soil water [m3/m3].",
   "params": ["h2osoi_vol"],
   "body": {"op": "max", "args": [{"op": "-", "args": [0.11, {"op": "*", "args": [0.4, "h2osoi_vol"]}]}, 0.0]}
  },
  "soil_albedo": {
   "description": "Direct-beam soil albedo albsod = min(albsat + inc, albdry) [1]: SurfaceAlbedoMod.F90:1249 (SoilAlbedo), albsat/albdry the saturated/dry soil albedo of the column's color class and waveband (SurfaceAlbedoMod.F90:205-218) and inc the wetness correction (soil_albedo_wetness). The diffuse soil albedo is the same value, albsoi = albsod (SurfaceAlbedoMod.F90:1250), written as an identity at the call sites.",
   "params": ["albsat", "inc", "albdry"],
   "body": {"op": "min", "args": [{"op": "+", "args": ["albsat", "inc"]}, "albdry"]}
  },
  "snow_soil_albedo": {
   "description": "Snow/soil ground albedo blend alb_g = alb_soil*(1 - frac_sno) + alb_snow*frac_sno [1]: SurfaceAlbedoMod.F90:816 (direct beam: albgrd from albsod, albsnd) and F90:817 (diffuse: albgri from albsoi, albsni), frac_sno the frac_sno_albedo snow cover fraction and alb_snow the SNICAR snow albedo of the same beam and waveband.",
   "params": ["alb_soil", "alb_snow", "frac_sno"],
   "body": {"op": "+", "args": [{"op": "*", "args": ["alb_soil", {"op": "-", "args": [1.0, "frac_sno"]}]}, {"op": "*", "args": ["alb_snow", "frac_sno"]}]}
  },
  "absorbed_shortwave": {
   "description": "Shortwave absorbed by a surface in one waveband, solad*(1 - albd) + solai*(1 - albi) [W/m2]: the bare-surface absorption term of SurfaceRadiationMod.F90:701-710 (sabg with the ground albedos, sabg_soil with the soil albedos, sabg_snow with the snow albedos), solad/solai the incident direct/diffuse radiation and albd/albi the direct/diffuse albedo.",
   "params": ["solad", "solai", "albd", "albi"],
   "body": {"op": "+", "args": [{"op": "*", "args": ["solad", {"op": "-", "args": [{"op": "const", "args": [], "value": 1.0, "units": "1"}, "albd"]}]}, {"op": "*", "args": ["solai", {"op": "-", "args": [{"op": "const", "args": [], "value": 1.0, "units": "1"}, "albi"]}]}]}
  },
  "reflected_shortwave": {
   "description": "Shortwave reflected by a surface in one waveband, albd*solad + albi*solai [W/m2]: SurfaceRadiationMod.F90:897-899 (fsr), solad/solai the incident direct/diffuse radiation and albd/albi the direct/diffuse albedo.",
   "params": ["solad", "solai", "albd", "albi"],
   "body": {"op": "+", "args": [{"op": "*", "args": ["albd", "solad"]}, {"op": "*", "args": ["albi", "solai"]}]}
  },
  "rhos": {
   "description": "Atmospheric density rhos(q,p,t) [kg/m3]: the rhos function of atm2lndMod.F90:287-310 (the density used by the atm2lnd topo downscaling, written as a ratio of this law so that rhos_c equals rhos_g when the column elevation equals the atmosphere's), with egcm = q*p/(wv + (1 - wv)*q) (F90:306-307) and rhos = (p - (1 - wv)*egcm)/(rair*t) (F90:308). The molecular-weight ratio wv = wv_to_dair_weight_ratio = SHR_CONST_MWWV/SHR_CONST_MWDAIR = 18.016/28.966 = 0.6219705862045155 (clm_varcon.F90:71) and the dry-air gas constant rair = SHR_CONST_RDAIR = 287.0423113650487 J/(kg K) (clm_varcon.F90:55) are parameters so the call sites bind their own named, unit-carrying constants (the clm_atm_forcing.esm Downscale model binds wv_to_dair_weight_ratio and rair). The import-side density law (derive_quantities, lnd_import_export_utils.F90:70-73) is the same functional form with the 0.622/0.378 literals; it is shared with the DATM datamode via cdeps_templates.esm:density.",
   "params": ["q", "pbot", "tbot", "wv", "rair"],
   "body": {"op": "/", "args": [
    {"op": "-", "args": ["pbot", {"op": "*", "args": [
     {"op": "-", "args": [1.0, "wv"]},
     {"op": "/", "args": [
      {"op": "*", "args": ["q", "pbot"]},
      {"op": "+", "args": ["wv", {"op": "*", "args": [
       {"op": "-", "args": [1.0, "wv"]}, "q"]}]}]}]}]},
    {"op": "*", "args": ["tbot", "rair"]}]}
  }
 }
}
