  "CanopyFluxInterface": {
   "expression_template_imports": [
    {"ref": "./clm_templates.esm"}
   ],
   "variables": {
    "z0m": {"type": "unknown", "shape": ["patch"], "units": "m", "description": "momentum roughness length over vegetation (SetZ0mDisp, BiogeophysPreFluxCalcsMod.F90:175), [m]"},
    "displa": {"type": "unknown", "shape": ["patch"], "units": "m", "description": "displacement height (BiogeophysPreFluxCalcsMod.F90:176), [m]"},
    "t_grnd": {"type": "unknown", "shape": ["column"], "units": "K", "description": "ground surface temperature as the snow/soil/h2osfc weighted mean (CalcInitialTemperatureAndEnergyVars, BiogeophysPreFluxCalcsMod.F90:334-339), [K]"},
    "emg": {"type": "unknown", "shape": ["column"], "units": "1", "description": "ground emissivity (BiogeophysPreFluxCalcsMod.F90:344-350), [-]"},
    "emv": {"type": "unknown", "shape": ["patch"], "units": "1", "description": "vegetation emissivity (BiogeophysPreFluxCalcsMod.F90:397), [-]"},
    "htvp": {"type": "unknown", "shape": ["column"], "units": "J/kg", "description": "latent heat of vaporization or sublimation (BiogeophysPreFluxCalcsMod.F90:354-358), [J/kg]"},
    "thm": {"type": "unknown", "shape": ["patch"], "units": "K", "description": "intermediate temperature forc_t + 0.0098*forc_hgt_t where forc_hgt_t is the reference height of the temperature observation including the roughness correction (BiogeophysPreFluxCalcsMod.F90:400 with forc_hgt_t_patch of FrictionVelocityMod.F90:664; for the bare-ground traced patches forc_hgt_t_patch = 30.0 m + z0mg, see the thm tests), [K]"},
    "thv": {"type": "unknown", "shape": ["column"], "units": "K", "description": "virtual potential temperature forc_th*(1+0.61*forc_q) (BiogeophysPreFluxCalcsMod.F90:364), [K]"},
    "beta": {"type": "unknown", "shape": ["column"], "units": "1", "description": "coefficient of convective velocity, set to 1 (BiogeophysPreFluxCalcsMod.F90:362), [-]"},
    "zii": {"type": "unknown", "shape": ["column"], "units": "m", "description": "convective boundary layer height, set to 1000 (BiogeophysPreFluxCalcsMod.F90:363), [m]"},
    "s_top": {"type": "unknown", "shape": ["column"], "units": "1", "description": "relative saturation of the top soil layer, fac = min(1, max(0.01, wx/watsat)) with wx the volumetric water content (SurfaceHumidityMod.F90:132-134), [-]"},
    "hr": {"type": "unknown", "shape": ["column"], "units": "1", "description": "soil surface relative humidity exp(psit/(roverg*T1)) with psit = max(smpmin, -sucsat*fac^-bsw) (SurfaceHumidityMod.F90:135-138, the smpmin clamp at :136), [-]"},
    "soilalpha": {"type": "unknown", "shape": ["column"], "units": "1", "description": "factor reducing ground saturated specific humidity qred = (1-frac_sno_fluxes-frac_h2osfc)*hr + frac_sno_fluxes + frac_h2osfc (SurfaceHumidityMod.F90:139-141), [-]"},
    "qsatg_soil_raw": {"type": "unknown", "shape": ["column"], "units": "kg/kg", "description": "unclamped saturation specific humidity at the soil temperature (the raw QSat result before the supersaturated-window clamp, SurfaceHumidityMod.F90:185), [kg/kg]"},
    "qsatg_soil": {"type": "unknown", "shape": ["column"], "units": "kg/kg", "description": "saturation specific humidity at the soil temperature, clamped to forc_q in the supersaturated window qsatg > forc_q > hr*qsatg (SurfaceHumidityMod.F90:185-190), [kg/kg]"},
    "qsatgdT_soil": {"type": "unknown", "shape": ["column"], "units": "1/K", "description": "d(qsatg_soil)/dT, zeroed in the supersaturated window (SurfaceHumidityMod.F90:186-190), [1/K]"},
    "qsatg_snow": {"type": "unknown", "shape": ["column"], "units": "kg/kg", "description": "saturation specific humidity at the snow temperature (SurfaceHumidityMod.F90:194), [kg/kg]"},
    "qsatgdT_snow": {"type": "unknown", "shape": ["column"], "units": "1/K", "description": "d(qsatg_snow)/dT (SurfaceHumidityMod.F90:195), [1/K]"},
    "qsatg_h2osfc": {"type": "unknown", "shape": ["column"], "units": "kg/kg", "description": "saturation specific humidity at the surface-water temperature (SurfaceHumidityMod.F90:207), [kg/kg]"},
    "qsatgdT_h2osfc": {"type": "unknown", "shape": ["column"], "units": "1/K", "description": "d(qsatg_h2osfc)/dT (SurfaceHumidityMod.F90:208), [1/K]"},
    "qg_soil": {"type": "unknown", "shape": ["column"], "units": "kg/kg", "description": "specific humidity at the soil surface hr*qsatg_soil with the clamped saturation humidity (SurfaceHumidityMod.F90:191), [kg/kg]"},
    "qg_snow": {"type": "unknown", "shape": ["column"], "units": "kg/kg", "description": "specific humidity at the snow surface, qg_soil when no snow (SurfaceHumidityMod.F90:194-196, the snl = 0 consistency branch at :198-203), [kg/kg]"},
    "qg_h2osfc": {"type": "unknown", "shape": ["column"], "units": "kg/kg", "description": "specific humidity at the surface-water surface, qg_soil without surface water (SurfaceHumidityMod.F90:207-213), [kg/kg]"},
    "qg": {"type": "unknown", "shape": ["column"], "units": "kg/kg", "description": "area-weighted ground specific humidity (SurfaceHumidityMod.F90:215-216), [kg/kg]"},
    "dqgdT": {"type": "unknown", "shape": ["column"], "units": "1/K", "description": "d(qg)/dT including the frac_h2osfc*qsatgdT_h2osfc surface-water term (SurfaceHumidityMod.F90:197-210), [1/K]"},
    "htop": {"type": "parameter", "shape": ["patch"], "units": "m", "default": 0.0, "description": "canopy top height (canopystate htop), [m]"},
    "elai": {"type": "parameter", "shape": ["patch"], "units": "1", "default": 0.0, "description": "one-sided leaf area index with burying by snow, [-]"},
    "esai": {"type": "parameter", "shape": ["patch"], "units": "1", "default": 0.0, "description": "one-sided stem area index with burying by snow, [-]"},
    "z0mr": {"type": "parameter", "shape": ["patch"], "units": "1", "default": 0.1, "description": "ratio of momentum roughness length to canopy top height (pftcon z0mr), [-]"},
    "displar": {"type": "parameter", "shape": ["patch"], "units": "1", "default": 0.67, "description": "ratio of displacement height to canopy top height (pftcon displar), [-]"},
    "avmuir": {"type": "parameter", "units": "1", "default": 1.0, "description": "inverse optical depth per unit leaf area (BiogeophysPreFluxCalcsMod.F90:396), [-]"},
    "snl": {"type": "parameter", "shape": ["column"], "units": "1", "default": 0.0, "description": "number of snow layers (col%snl; negative when snow present), [-]"},
    "frac_sno_fluxes": {"type": "parameter", "shape": ["column"], "units": "1", "default": 0.0, "description": "fraction of ground covered by snow for heat-flux calculations, [-]"},
    "frac_sno_albedo": {"type": "parameter", "shape": ["column"], "units": "1", "default": 0.0, "description": "fraction of ground covered by snow for albedo calculations, [-]"},
    "frac_h2osfc": {"type": "parameter", "shape": ["column"], "units": "1", "default": 0.0, "description": "fraction of ground covered by surface water, [-]"},
    "t_soisno_top_soil": {"type": "parameter", "shape": ["column"], "units": "K", "default": 273.15, "description": "temperature of the top soil layer t_soisno(c,1), [K]"},
    "t_soisno_top_snow": {"type": "parameter", "shape": ["column"], "units": "K", "default": 273.15, "description": "temperature of the top snow layer t_soisno(c,snl+1), [K]"},
    "t_h2osfc": {"type": "parameter", "shape": ["column"], "units": "K", "default": 273.15, "description": "surface water temperature, [K]"},
    "h2osoi_liq_top": {"type": "parameter", "shape": ["column"], "units": "kg/m^2", "default": 0.0, "description": "liquid water in the top snow/soil layer, [kg/m2]"},
    "h2osoi_ice_top": {"type": "parameter", "shape": ["column"], "units": "kg/m^2", "default": 0.0, "description": "ice in the top snow/soil layer, [kg/m2]"},
    "dz_top": {"type": "parameter", "shape": ["column"], "units": "m", "default": 0.0175, "description": "thickness of the top soil layer, [m]"},
    "watsat_top": {"type": "parameter", "shape": ["column"], "units": "1", "default": 0.4, "description": "porosity of the top soil layer, [-]"},
    "sucsat_top": {"type": "parameter", "shape": ["column"], "units": "mm", "default": 100.0, "description": "minimum soil suction of the top layer, [mm]"},
    "bsw_top": {"type": "parameter", "shape": ["column"], "units": "1", "default": 6.0, "description": "Clapp-Hornberg exponent of the top layer, [-]"},
    "denh2o": {"type": "parameter", "units": "kg/m^3", "default": 1000.0, "description": "density of liquid water (clm_varcon denh2o), [kg/m3]"},
    "denice": {"type": "parameter", "units": "kg/m^3", "default": 917.0, "description": "density of ice (clm_varcon denice), [kg/m3]"},
    "roverg": {"type": "parameter", "units": "mm/K", "default": 47062.72789962227, "description": "Rw/g*1000 with Rw = R/M_wv the water-vapor gas constant and g gravity, converting soil water potential from mm of head to temperature units in hr = exp(psit/(roverg*T)) (clm_varcon roverg = SHR_CONST_RWV/SHR_CONST_G*1000), [mm/K]"},
    "smpmin": {"type": "parameter", "units": "mm", "default": -1e8, "description": "restriction for min of soil potential (soilstate smpmin = -1.e8, SoilStateInitTimeConstMod.F90:246), [mm]"},
    "forc_t": {"type": "parameter", "shape": ["patch"], "units": "K", "default": 273.15, "description": "atmospheric temperature, [K]"},
    "forc_th": {"type": "parameter", "shape": ["column"], "units": "K", "default": 273.15, "description": "atmospheric potential temperature, [K]"},
    "forc_q": {"type": "parameter", "shape": ["column"], "units": "kg/kg", "default": 0.0, "description": "atmospheric specific humidity, [kg/kg]"},
    "forc_pbot": {"type": "parameter", "shape": ["column"], "units": "Pa", "default": 101325.0, "description": "atmospheric pressure, [Pa]"},
    "forc_hgt_t": {"type": "parameter", "shape": ["patch"], "units": "m", "default": 30.0, "description": "observational height of temperature including the ground roughness correction (for the bare-ground traced patches = 30.0 m forcing height + z0mg; FrictionVelocityMod.F90:632,664), [m]"},
    "hvap": {"type": "parameter", "units": "J/kg", "default": 2.501e6, "description": "latent heat of vaporization (clm_varcon hvap = SHR_CONST_LATVAP), [J/kg]"},
    "hsub": {"type": "parameter", "units": "J/kg", "default": 2.8347e6, "description": "latent heat of sublimation hsub = LATICE + LATVAP = 3.337e5 + 2.501e6 (clm_varcon hsub = SHR_CONST_LATSUB), [J/kg]"},
    "TKFRZ": {"type": "parameter", "units": "K", "default": 273.15, "description": "freezing point of water (SHR_CONST_TKFRZ), [K]"},
    "emg_soil": {"type": "parameter", "units": "1", "default": 0.96, "description": "bare-soil ground emissivity (BiogeophysPreFluxCalcsMod.F90:348), [-]"},
    "emg_snow": {"type": "parameter", "units": "1", "default": 0.97, "description": "snow ground emissivity (BiogeophysPreFluxCalcsMod.F90:348), [-]"}
   },
   "equations": [
    {"lhs": "z0m", "rhs": {"op": "apply_expression_template", "args": [], "name": "pft_z0m_zengwang2007", "bindings": {"z0mr": "z0mr", "htop": "htop"}}},
    {"lhs": "displa", "rhs": {"op": "apply_expression_template", "args": [], "name": "pft_displa_zengwang2007", "bindings": {"displar": "displar", "htop": "htop"}}},
    {"lhs": "t_grnd", "rhs": {"op": "ifelse", "args": [
     {"op": "<", "args": ["snl", 0.0]},
     {"op": "+", "args": [
      {"op": "*", "args": ["frac_sno_fluxes", "t_soisno_top_snow"]},
      {"op": "*", "args": [{"op": "-", "args": [{"op": "-", "args": [1.0, "frac_sno_fluxes"]}, "frac_h2osfc"]}, "t_soisno_top_soil"]},
      {"op": "*", "args": ["frac_h2osfc", "t_h2osfc"]}]},
     {"op": "+", "args": [
      {"op": "*", "args": [{"op": "-", "args": [1.0, "frac_h2osfc"]}, "t_soisno_top_soil"]},
      {"op": "*", "args": ["frac_h2osfc", "t_h2osfc"]}]}
    ]}},
    {"lhs": "emg", "rhs": {"op": "apply_expression_template", "args": [], "name": "ground_emissivity", "bindings": {"frac_sno_albedo": "frac_sno_albedo", "emg_soil": "emg_soil", "emg_snow": "emg_snow"}}},
    {"lhs": "emv", "rhs": {"op": "apply_expression_template", "args": [], "name": "vegetation_emissivity", "bindings": {"elai": "elai", "esai": "esai", "avmuir": "avmuir"}}},
    {"lhs": "htvp", "rhs": {"op": "apply_expression_template", "args": [], "name": "latent_heat_of_vapor", "bindings": {"h2osoi_liq_top": "h2osoi_liq_top", "h2osoi_ice_top": "h2osoi_ice_top", "hvap": "hvap", "hsub": "hsub"}}},
    {"lhs": "thm", "rhs": {"op": "+", "args": ["forc_t", {"op": "*", "args": [0.0098, "forc_hgt_t"]}]}},
    {"lhs": "thv", "rhs": {"op": "*", "args": ["forc_th", {"op": "+", "args": [1.0, {"op": "*", "args": [0.61, "forc_q"]}]}]}},
    {"lhs": "beta", "rhs": 1.0},
    {"lhs": "zii", "rhs": 1000.0},
    {"lhs": "s_top", "rhs": {"op": "min", "args": [1.0, {"op": "max", "args": [0.01, {"op": "/", "args": [
     {"op": "+", "args": [{"op": "/", "args": ["h2osoi_liq_top", "denh2o"]}, {"op": "/", "args": ["h2osoi_ice_top", "denice"]}]},
     {"op": "*", "args": ["dz_top", "watsat_top"]}]}]}]}},
    {"lhs": "hr", "rhs": {"op": "exp", "args": [{"op": "/", "args": [
     {"op": "max", "args": ["smpmin", {"op": "apply_expression_template", "args": [], "name": "soil_suction", "bindings": {"sucsat": "sucsat_top", "bsw": "bsw_top", "s": "s_top"}}]},
     {"op": "*", "args": ["roverg", "t_soisno_top_soil"]}]}]}},
    {"lhs": "soilalpha", "rhs": {"op": "+", "args": [
     {"op": "*", "args": [{"op": "-", "args": [{"op": "-", "args": [1.0, "frac_sno_fluxes"]}, "frac_h2osfc"]}, "hr"]},
     "frac_sno_fluxes", "frac_h2osfc"]}},
    {"lhs": "qsatg_soil_raw", "rhs": {"op": "apply_expression_template", "args": [], "name": "qsat_qs", "bindings": {"T": "t_soisno_top_soil", "p": "forc_pbot", "TKFRZ": "TKFRZ"}}},
    {"lhs": "qsatg_soil", "rhs": {"op": "ifelse", "args": [
     {"op": "and", "args": [
      {"op": ">", "args": ["qsatg_soil_raw", "forc_q"]},
      {"op": ">", "args": ["forc_q", {"op": "*", "args": ["hr", "qsatg_soil_raw"]}]}]},
     "forc_q", "qsatg_soil_raw"]}},
    {"lhs": "qsatgdT_soil", "rhs": {"op": "ifelse", "args": [
     {"op": "and", "args": [
      {"op": ">", "args": ["qsatg_soil_raw", "forc_q"]},
      {"op": ">", "args": ["forc_q", {"op": "*", "args": ["hr", "qsatg_soil_raw"]}]}]},
     0.0,
     {"op": "apply_expression_template", "args": [], "name": "qsat_qsdT", "bindings": {"T": "t_soisno_top_soil", "p": "forc_pbot", "TKFRZ": "TKFRZ"}}]}},
    {"lhs": "qg_soil", "rhs": {"op": "*", "args": ["hr", "qsatg_soil"]}},
    {"lhs": "qsatg_snow", "rhs": {"op": "apply_expression_template", "args": [], "name": "qsat_qs", "bindings": {"T": "t_soisno_top_snow", "p": "forc_pbot", "TKFRZ": "TKFRZ"}}},
    {"lhs": "qsatgdT_snow", "rhs": {"op": "apply_expression_template", "args": [], "name": "qsat_qsdT", "bindings": {"T": "t_soisno_top_snow", "p": "forc_pbot", "TKFRZ": "TKFRZ"}}},
    {"lhs": "qsatg_h2osfc", "rhs": {"op": "apply_expression_template", "args": [], "name": "qsat_qs", "bindings": {"T": "t_h2osfc", "p": "forc_pbot", "TKFRZ": "TKFRZ"}}},
    {"lhs": "qsatgdT_h2osfc", "rhs": {"op": "apply_expression_template", "args": [], "name": "qsat_qsdT", "bindings": {"T": "t_h2osfc", "p": "forc_pbot", "TKFRZ": "TKFRZ"}}},
    {"lhs": "qg_snow", "rhs": {"op": "ifelse", "args": [{"op": "<", "args": ["snl", 0.0]}, "qsatg_snow", "qg_soil"]}},
    {"lhs": "qg_h2osfc", "rhs": {"op": "ifelse", "args": [{"op": ">", "args": ["frac_h2osfc", 0.0]}, "qsatg_h2osfc", "qg_soil"]}},
    {"lhs": "qg", "rhs": {"op": "+", "args": [
     {"op": "*", "args": ["frac_sno_fluxes", "qg_snow"]},
     {"op": "*", "args": [{"op": "-", "args": [{"op": "-", "args": [1.0, "frac_sno_fluxes"]}, "frac_h2osfc"]}, "qg_soil"]},
     {"op": "*", "args": ["frac_h2osfc", "qg_h2osfc"]}]}},
    {"lhs": "dqgdT", "rhs": {"op": "ifelse", "args": [
     {"op": "<", "args": ["snl", 0.0]},
     {"op": "+", "args": [
      {"op": "*", "args": ["frac_sno_fluxes", "qsatgdT_snow"]},
      {"op": "*", "args": [{"op": "-", "args": [{"op": "-", "args": [1.0, "frac_sno_fluxes"]}, "frac_h2osfc"]}, {"op": "*", "args": ["hr", "qsatgdT_soil"]}]},
      {"op": "ifelse", "args": [{"op": ">", "args": ["frac_h2osfc", 0.0]}, {"op": "*", "args": ["frac_h2osfc", "qsatgdT_h2osfc"]}, 0.0]}]},
     {"op": "+", "args": [
      {"op": "*", "args": [{"op": "-", "args": [1.0, "frac_h2osfc"]}, {"op": "*", "args": ["hr", "qsatgdT_soil"]}]},
      {"op": "ifelse", "args": [{"op": ">", "args": ["frac_h2osfc", 0.0]}, {"op": "*", "args": ["frac_h2osfc", "qsatgdT_h2osfc"]}, 0.0]}]}
    ]}}
   ],
   "tests": [
    {
     "id": "clm_qsat_snow_surfhum_step1_c1",
     "description": "Surface-humidity boundary against clm_run_imports.csv (surfhum stage, step 1, column 1) with the input temperatures reconstructed from clm_soiltemp.csv (entry stage, same step/column; the W2 dumps label the true layer indices, so the top snow layer is j = snl+1 = -8 with snl = -9): t_soisno(c,snl+1) = 247.894403551559776 K (= the entry-dump j = -8 value; the preflux t_grnd equals it to round-off on all 192 rows, so frac_sno_fluxes = 1, frac_h2osfc = 0 and snl < 0), the top soil layer is t_soisno(c,1) = 225.739714130635889 K (entry j = 1), and forc_pbot = 68134.1361002605699 Pa from clm_bareground.csv (step 1, column 1). Pins qg_snow = qsat_qs(T,p) (SurfaceHumidityMod.F90:194), dqgdT = qsatgdT_snow = qsat_qsdT(T,p) (:195,:201-202 — the qsat_qsdT template), qg = frac_sno_fluxes*qg_snow (:215-216), soilalpha = 1 (:139-141) and t_grnd = frac_sno_fluxes*t_soisno_top_snow (BiogeophysPreFluxCalcsMod.F90:334-339) — every asserted value reproduces the dump row to round-off (max rel err 3.1e-16 over all 192 surfhum rows).",
     "time_span": {"start": 0.0, "end": 0.0},
     "parameter_overrides": {
      "t_soisno_top_snow": [247.894403551559776],
      "t_soisno_top_soil": [225.739714130635889],
      "forc_pbot": [68134.1361002605699],
      "frac_sno_fluxes": [1.0],
      "frac_h2osfc": [0.0],
      "snl": [-1.0]
     },
     "tolerance": {"rel": 1e-12, "abs": 0.0},
     "assertions": [
      {"variable": "qg_snow", "time": 0.0, "expected": 0.000563376515116750017, "coords": {"column": 1}},
      {"variable": "dqgdT", "time": 0.0, "expected": 5.64097735739067221e-05, "coords": {"column": 1}},
      {"variable": "qg", "time": 0.0, "expected": 0.000563376515116750017, "coords": {"column": 1}},
      {"variable": "soilalpha", "time": 0.0, "expected": 1.0, "coords": {"column": 1}},
      {"variable": "t_grnd", "time": 0.0, "expected": 247.894403551559776, "coords": {"column": 1}}
