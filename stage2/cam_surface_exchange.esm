{
 "esm": "1.3.0",
 "metadata": {
  "name": "cam_surface_exchange",
  "description": "The surface-exchange slice of the CAM6 physics (stage 2 of the EqESM project): the cam_out export laws of cam_export (components/cam/src/control/camsrfexch.F90:405-577 of the instrumented cam6_4_212 fork) and the cam_in import surface. Model CamOutExport transcribes the bottom-level state exports (tbot, zbot, ubot, vbot, qbot, pbot, rho, thbot; camsrfexch.F90:495-507), the diagnostic sea-level pressure psl (cpslec, cam_diagnostics.F90:1080-1081 + cam_diagnostic_utils.F90:20-81), the precipitation split precc/precl/precsc/precsl from the eight pbuf PREC/Snow fields (camsrfexch.F90:537-575), the radiative exports netsw/flwds/soll/sols/solld/solsd (produced by radiation_tend, rrtmg/radiation.F90:1272-1316,1429, and passed through unchanged), and the trace-gas exports co2diag/co2prog/ozone (camsrfexch.F90:506-525). Model CamInImports documents the cam_in fields as pure coupler imports (camsrfexch.F90:86-125) with their physics consumption sites (physpkg.F90:1532-1536, 1547, 1572-1574, 1768-1769, 2493, 2742-2749, 2775-2779, 3086-3092) and transcribes the one CAM-side combination of coupler fluxes, the flx_net accumulation of tphysac (physpkg.F90:1533). Tests pin the export laws to the stage-1 dump rows (stage1/dumps/cam/cam_surface_exchange.csv and cam_phys_tend.csv, rows cited per test) at rel 1e-12. Constants are SHR_CONST_* (shr_const_mod.F90:24-55): RDAIR = 287.0423113650487 J/(kg K) = AVOGAD*BOLTZ/MWDAIR, CPDAIR = 1004.64 J/(kg K), GRAVIT = 9.80616 m/s^2, LATVAP = 2.501e6 J/kg, LATICE = 3.337e5 J/kg, RHOFW = 1e3 kg/m^3, and the cpslec local XLAPSE = 6.5e-3 K/m (cam_diagnostic_utils.F90:22)."
 },
 "models": {
  "CamOutExport": {
   "expression_template_imports": [
    {
     "ref": "./cam_templates.esm"
    }
   ],
   "variables": {
    "t_bot": {
     "type": "parameter",
     "units": "K",
     "default": 301.8637376908711,
     "description": "temperature at the bottom level pver when cam_export runs, state%t(pver) (camsrfexch.F90:495), after this step's physics updates, [K]. The dump pins reconstruct it from the radiation-site dump row as T + ptend_s*dt/cpairv (cpairv = cpair = 1004.64 J/(kg K) because dry_air_species = ''; verified bit-exact vs the dumped tbot)."
    },
    "u_bot": {
     "type": "parameter",
     "units": "m/s",
     "default": 1.418813430289268,
     "description": "zonal wind at pver, state%u(pver) (camsrfexch.F90:499), [m/s]; the radiation tendency leaves u unchanged, so the dumped ubot equals the pre-radiation state value."
    },
    "v_bot": {
     "type": "parameter",
     "units": "m/s",
     "default": 5.404623820236974,
     "description": "meridional wind at pver, state%v(pver) (camsrfexch.F90:500), [m/s]; unchanged by the radiation tendency."
    },
    "q_bot": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.011442792557680562,
     "description": "specific humidity at pver, state%q(pver,1) (camsrfexch.F90:507), [kg/kg]; unchanged by the radiation tendency (no radiation q rows exist in the dump)."
    },
    "pmid_bot": {
     "type": "parameter",
     "units": "Pa",
     "default": 92152.10177120629,
     "description": "midpoint pressure at pver, state%pmid(pver) (camsrfexch.F90:501), [Pa]."
    },
    "zm_bot": {
     "type": "parameter",
     "units": "m",
     "default": 67.28351083631732,
     "description": "geopotential height at pver at cam_export time, state%zm(pver) (camsrfexch.F90:497), [m]. Not directly dumped: physics_update recomputes zm after the temperature update (physics_types.F90:423-449), so the pre-radiation zm of the dump differs from the value cam_export sees; the dump pins set this input to the dumped zbot (bookkeeping pin only, see README-cam.md)."
    },
    "ps": {
     "type": "parameter",
     "units": "Pa",
     "default": 92848.96251956573,
     "description": "surface pressure, state%ps, [Pa]; the SE dycore surface interface pressure pint(pver+1) of dp_coupling.F90:693-695."
    },
    "phis": {
     "type": "parameter",
     "units": "m^2/s^2",
     "default": 8704.816911504207,
     "description": "surface geopotential, state%phis, [m^2/s^2]."
    },
    "t_psl": {
     "type": "parameter",
     "units": "K",
     "default": 302.4585882010374,
     "description": "temperature at pver at the time the PSL pbuf field is computed (diag_phys_writeout, cam_diagnostics.F90:1080-1081, which runs before this step's radiation update), [K]; cpslec uses only the bottom level. The dump pins set it to the pre-radiation state temperature."
    },
    "prec_dp": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "deep-convection precipitation, pbuf PREC_DP (produced by convect_deep), [m/s] (camsrfexch.F90:542-546). Not dumped; the default is nominal (this run: Zhang-McFarlane deep convection)."
    },
    "snow_dp": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "deep-convection snow, pbuf SNOW_DP, [m/s] (camsrfexch.F90:542-546). Not dumped."
    },
    "prec_sh": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "shallow-convection precipitation, pbuf PREC_SH (produced by the shallow convection scheme), [m/s] (camsrfexch.F90:538-541). Not dumped."
    },
    "snow_sh": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "shallow-convection snow, pbuf SNOW_SH, [m/s] (camsrfexch.F90:538-541). Not dumped."
    },
    "prec_sed": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "stratiform sedimentation precipitation, pbuf PREC_SED (produced by the microphysics), [m/s] (camsrfexch.F90:548-553). Not dumped."
    },
    "snow_sed": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "stratiform sedimentation snow, pbuf SNOW_SED, [m/s] (camsrfexch.F90:548-553). Not dumped."
    },
    "prec_pcw": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "stratiform condensation precipitation, pbuf PREC_PCW, [m/s] (camsrfexch.F90:548-553). Not dumped."
    },
    "snow_pcw": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "stratiform condensation snow, pbuf SNOW_PCW, [m/s] (camsrfexch.F90:548-553). Not dumped."
    },
    "netsw_rad": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 8.144525054376572e-10,
     "description": "net surface shortwave flux computed by the radiation component, cam_out%netsw = fsns (rrtmg/radiation.F90:1429), [W/m^2]; copied through unchanged by cam_export."
    },
    "flwds_rad": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 303.50578808378003,
     "description": "downwelling surface longwave flux from RRTMG (rrtmg/radiation.F90:1315), [W/m^2]; copied through unchanged."
    },
    "soll_rad": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 187.13785670985106,
     "description": "surface direct-beam visible downwelling flux (rrtmg/radiation.F90:1272), [W/m^2]; copied through unchanged."
    },
    "sols_rad": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 159.18446120267862,
     "description": "surface direct-beam near-IR downwelling flux (rrtmg/radiation.F90:1272), [W/m^2]; copied through unchanged."
    },
    "solld_rad": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 5.421589434476402,
     "description": "surface diffuse visible downwelling flux (rrtmg/radiation.F90:1273), [W/m^2]; copied through unchanged."
    },
    "solsd_rad": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 58.778936577866546,
     "description": "surface diffuse near-IR downwelling flux (rrtmg/radiation.F90:1273), [W/m^2]; copied through unchanged."
    },
    "ozone_srf": {
     "type": "parameter",
     "units": "mol/mol",
     "default": 4.657186972314521e-08,
     "description": "surface ozone from the pbuf SRFOZONE field (set by radiation, rrtmg/radiation.F90:1270), [mol/mol]; copied through unchanged (camsrfexch.F90:519-525)."
    },
    "co2vmr": {
     "type": "parameter",
     "units": "mol/mol",
     "default": 0.0,
     "description": "CO2 mole fraction from chem_surfvals_get('CO2VMR') (camsrfexch.F90:506-511), [mol/mol]. The run's value ~1.127e-6 (dumped co2diag/1e6) is prescribed data whose provenance is unresolved: the LBC climo file implies a global-mean CO2VMR of ~369e-6 and the IOP file has no co2vmr variable (see README-cam.md). The nominal default is 0."
    },
    "tbot": {
     "type": "unknown",
     "units": "K",
     "description": "bottom-level temperature export, cam_out%tbot (camsrfexch.F90:495), [K]; dump column tbot."
    },
    "zbot": {
     "type": "unknown",
     "units": "m",
     "description": "bottom-level geopotential height export, cam_out%zbot (camsrfexch.F90:497), [m]; dump column zbot."
    },
    "ubot": {
     "type": "unknown",
     "units": "m/s",
     "description": "bottom-level zonal wind export, cam_out%ubot (camsrfexch.F90:499), [m/s]; dump column ubot."
    },
    "vbot": {
     "type": "unknown",
     "units": "m/s",
     "description": "bottom-level meridional wind export, cam_out%vbot (camsrfexch.F90:500), [m/s]; dump column vbot."
    },
