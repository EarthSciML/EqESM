    },
    "ocnfrac": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "ocean fraction, from the coupler, [1]."
    },
    "cflx_Q": {
     "type": "parameter",
     "units": "kg/m^2/s",
     "default": 1.4971569113310615e-05,
     "description": "surface constituent flux of water vapor, cam_in%cflx(:,1), from the coupler, [kg/m^2/s]; the energy checks use cflx(:,1) with LATVAP (physpkg.F90:1768-1769, 2775-2779) and qneg4 clamps the (shf, lhf, cflx) triple (1572-1574). The full per-constituent cflx array (34 constituents) is dumped in cam_surface_cflx.csv; all entries are coupler-provided."
    },
    "precc": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "convective precipitation export of cam_out at this step (CamOutExport.precc), [m/s]; enters the flx_net accumulation (physpkg.F90:1533)."
    },
