    },
    "co2prog": {
     "type": "unknown",
     "units": "mol/mol",
     "description": "prognostic CO2 mixing ratio export, cam_out%co2prog (camsrfexch.F90:512-516), [mol/mol]; identically 0 because co2_transport() is false in this configuration; dump column co2prog."
    },
    "ozone": {
     "type": "unknown",
     "units": "mol/mol",
     "description": "surface ozone export, cam_out%ozone = pbuf SRFOZONE (camsrfexch.F90:519-525), [mol/mol]; dump column ozone."
    },
