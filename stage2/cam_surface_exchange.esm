       "time": 0.0,
       "expected": 887.6886479013403,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "psl",
       "time": 0.0,
       "expected": 102841.17870757317,
       "tolerance": {
        "rel": 1e-12
       }
      }
     ]
    },
    {
