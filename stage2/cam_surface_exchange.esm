     "type": "unknown",
     "units": "1",
     "description": "cpslec lapse-rate parameter alpha = rair*xlapse/gravit (cam_diagnostic_utils.F90:49), dimensionless."
    },
    "psl_tstar": {
     "type": "unknown",
     "units": "K",
     "description": "cpslec sea-level temperature Tstar = t(pver)*(1 + alpha*(ps/pmid - 1)) before branch adjustment (cam_diagnostic_utils.F90:52-53), [K]."
    },
    "psl_tt0": {
     "type": "unknown",
     "units": "K",
     "description": "cpslec test temperature TT0 = Tstar + xlapse*phis/gravit (cam_diagnostic_utils.F90:54-55), [K]."
    },
    "psl_alph": {
     "type": "unknown",
     "units": "1",
     "description": "cpslec branch-adjusted lapse-rate parameter alph (cam_diagnostic_utils.F90:56-66), dimensionless."
    },
    "psl_tstar_final": {
     "type": "unknown",
     "units": "K",
     "description": "cpslec Tstar after the branch adjustment of cam_diagnostic_utils.F90:56-66 (the Fortran overwrites Tstar in branches 2 and 3), [K]."
    },
    "psl_beta": {
     "type": "unknown",
     "units": "1",
     "description": "cpslec exponent beta = phis/(rair*Tstar) (cam_diagnostic_utils.F90:67), dimensionless."
    }
