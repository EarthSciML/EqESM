  "CamInImports": {
   "variables": {
    "asdir": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "surface albedo, direct visible, from the coupler via cam_in (camsrfexch.F90:86-125), [1]; consumed by the SW radiation (physpkg.F90:3086-3087 radiation_tend(cam_out, cam_in), rrtmg/radiation.F90:1268-1273). This run's coupler delivers 1.0 (all-ocean SCAM column, no albedo model), so the RRTMG net surface SW is ~0 despite ~410 W/m^2 downwelling (see README-cam.md)."
    },
    "asdif": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "surface albedo, diffuse visible, from the coupler, [1]; consumed by the SW radiation (physpkg.F90:3086-3087, rrtmg/radiation.F90:1268-1273)."
    },
    "aldir": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "surface albedo, direct near-IR, from the coupler, [1]; consumed by the SW radiation (physpkg.F90:3086-3087, rrtmg/radiation.F90:1268-1273)."
    },
    "aldif": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "surface albedo, diffuse near-IR, from the coupler, [1]; consumed by the SW radiation (physpkg.F90:3086-3087, rrtmg/radiation.F90:1268-1273)."
    },
    "lwup": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 452.09518167857084,
     "description": "upwelling surface longwave flux, from the coupler, [W/m^2]; the LW radiation derives the surface skin temperature from it (rrtmg_state.F90:115)."
    },
    "lhf": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 37.44389435238985,
     "description": "latent heat flux, from the coupler, [W/m^2]; consumed by qneg4 (physpkg.F90:1572-1574). CAM has no law relating lhf to cflx: the coupler computes both consistently (the dump shows lhf/cflx_Q = LATVAP; see README-cam.md)."
    },
    "shf": {
     "type": "parameter",
     "units": "W/m^2",
     "default": -5.392309114356713,
     "description": "sensible heat flux, from the coupler, [W/m^2]; enters flx_net (physpkg.F90:1533), flx_heat (physpkg.F90:2749), the vdiff and CLUBB energy checks (physpkg.F90:1768-1769, 2775-2779) and qneg4 (1572-1574)."
    },
    "wsx": {
     "type": "parameter",
     "units": "N/m^2",
     "default": -0.002622286182182339,
     "description": "zonal surface wind stress, from the coupler, [N/m^2]; CLUBB surface momentum flux and friction velocity (clubb_intr.F90:3902, 3916-3917, 5611)."
    },
    "wsy": {
     "type": "parameter",
     "units": "N/m^2",
     "default": -0.00999645990606174,
     "description": "meridional surface wind stress, from the coupler, [N/m^2]; CLUBB surface momentum flux (clubb_intr.F90:3902, 3916-3917, 5611)."
    },
    "tref": {
     "type": "parameter",
     "units": "K",
     "default": 301.43990760812324,
     "description": "2-m reference temperature, from the coupler, [K]; diagnostics only (cam_diagnostics.F90:1801-1803, TREFHT/TREFHTMX/TREFHTMN history fields)."
    },
    "qref": {
     "type": "parameter",
     "units": "kg/kg",
     "default": 0.016094024517984952,
     "description": "2-m reference specific humidity, from the coupler, [kg/kg]; diagnostics only (cam_diagnostics.F90:1804-1811, QREFHT)."
    },
    "u10": {
     "type": "parameter",
     "units": "m/s",
     "default": 2.7070994452744213,
     "description": "10-m wind speed, from the coupler, [m/s]; consumed only by the CARMA dust/sea-salt emission models (carma_model_mod.F90), not active in this run."
    },
    "ts": {
     "type": "parameter",
     "units": "K",
     "default": 298.8214060350357,
     "description": "surface temperature, from the coupler, [K]; CLUBB surface theta (clubb_intr.F90:5907 via clubb_tend_cam, physpkg.F90:2742-2744)."
    },
    "sst": {
     "type": "parameter",
     "units": "K",
     "default": 298.8214060350357,
     "description": "sea surface temperature, from the coupler, [K]; CLUBB (physpkg.F90:2637, 2698)."
    },
    "snowhland": {
     "type": "parameter",
     "units": "m",
     "default": 0.0,
     "description": "snow depth on land, from the coupler, [m]; CARMA cloud fraction (carma_cloudfraction.F90:117), not active in this run."
    },
    "snowhice": {
     "type": "parameter",
     "units": "m",
     "default": 0.2,
     "description": "snow depth on sea ice, from the coupler, [m]."
    },
    "landfrac": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "land fraction, from the coupler, [1]; the land/sea mask of convect_deep (physpkg.F90:2493)."
    },
    "icefrac": {
     "type": "parameter",
     "units": "1",
     "default": 0.0,
     "description": "sea-ice fraction, from the coupler, [1]."
    },
    "ocnfrac": {
     "type": "parameter",
     "units": "1",
     "default": 1.0,
     "description": "ocean fraction, from the coupler, [1]."
    },
    "cflx_Q": {
     "type": "parameter",
     "units": "kg/m^2/s",
     "default": 1.4971569113310615e-05,
     "description": "surface constituent flux of water vapor, cam_in%cflx(:,1), from the coupler, [kg/m^2/s]; the energy checks use cflx(:,1) with LATVAP (physpkg.F90:1768-1769, 2775-2779) and qneg4 clamps the (shf, lhf, cflx) triple (1572-1574). The full per-constituent cflx array (34 constituents) is dumped in cam_surface_cflx.csv; all entries are coupler-provided."
    },
    "precc": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "convective precipitation export of cam_out at this step (CamOutExport.precc), [m/s]; enters the flx_net accumulation (physpkg.F90:1533)."
    },
    "precl": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "large-scale precipitation export of cam_out at this step (CamOutExport.precl), [m/s]; enters the flx_net accumulation (physpkg.F90:1533)."
    },
    "precsc": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "convective snow export of cam_out at this step (CamOutExport.precsc), [m/s]; enters the flx_net accumulation (physpkg.F90:1533)."
    },
    "precsl": {
     "type": "parameter",
     "units": "m/s",
     "default": 0.0,
     "description": "large-scale snow export of cam_out at this step (CamOutExport.precsl), [m/s]; enters the flx_net accumulation (physpkg.F90:1533)."
    },
    "net_flx_rad": {
     "type": "parameter",
     "units": "W/m^2",
     "default": 0.0,
     "description": "radiation-side net surface flux, net_flx of radiation_tend (physpkg.F90:3090-3092, radheat.F90:348-364 calculate_net_heating_run), [W/m^2]; the leading term of the flx_net accumulation. Not dumped."
    },
    "latvap": {
     "type": "parameter",
     "units": "J/kg",
     "default": 2501000.0,
     "description": "latent heat of vaporization latvap = SHR_CONST_LATVAP (shr_const_mod.F90:52-55), [J/kg]; the water-vapor latent-heat factor of the flx_net accumulation (physpkg.F90:1533)."
    },
    "latice": {
     "type": "parameter",
     "units": "J/kg",
     "default": 333700.0,
     "description": "latent heat of fusion latice = SHR_CONST_LATICE (shr_const_mod.F90:52-55), [J/kg]; the frozen-precipitation latent-heat factor of the flx_net accumulation (physpkg.F90:1533)."
    },
    "rhoh2o": {
     "type": "parameter",
     "units": "kg/m^3",
     "default": 1000.0,
     "description": "density of liquid water rhoh2o = SHR_CONST_RHOFW (shr_const_mod.F90:52-55), [kg/m^3]; converts the m/s precipitation rates to kg/m^2/s in the flx_net accumulation (physpkg.F90:1533)."
    },
    "flx_net": {
     "type": "unknown",
     "units": "W/m^2",
     "description": "surface flux convergence accumulated by tphysac (physpkg.F90:1533): the radiation net surface flux plus the sensible heat flux plus the latent heat of the total and frozen precipitation, tend%flx_net, [W/m^2]. Not dumped (tend%flx_net is not in the stage-1 dump); coverage gap (see README-cam.md)."
    }
   },
   "equations": [
