   "tests": [
    {
     "id": "export_state_laws_step1",
     "description": "cam_surface_exchange.csv row (step 1, phase bc_out) and cam_phys_tend.csv row (step 1, site radiation, lev 32): the cam_export laws at the first step. tbot is reconstructed as T + ptend_s*dt/cpairv (cpairv = cpair because dry_air_species = ''), t_psl is the pre-radiation state temperature (the PSL pbuf is computed before the radiation update). rho/thbot/psl expected = dumped cam_out values; topo expected = phis/gravit with the dumped phis (derived, not a dump column: cam_out%topo is not in the stage-1 dump).",
     "time_span": {
      "start": 0.0,
      "end": 0.0
     },
     "parameter_overrides": {
      "tbot": 301.8637376908711,
      "pbot": 92152.10177120629,
      "ps": 92848.96251956573,
      "phis": 8704.816911504207,
      "t_psl": 302.4585882010374
     },
     "assertions": [
      {
       "variable": "rho",
       "time": 0.0,
       "expected": 1.0635266603911044,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
       "variable": "thbot",
       "time": 0.0,
       "expected": 302.5141933745016,
       "tolerance": {
        "rel": 1e-12
       }
      },
      {
