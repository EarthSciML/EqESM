    "Tair": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "K",
     "default": 273.15,
     "description": "air temperature (cap Sa_tbot; the pond freeze-up Stefan law consumes Tair, icepack_meltpond_sealvl.F90:173), [K]"
