    "alvdfn": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "1",
     "default": 0.0,
     "description": "combined visible diffuse albedo of the dEdd scheme (see alvdrn for the deferred-solve note), [-]"
    },
    "alidfn": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "1",
     "default": 0.0,
     "description": "combined near-IR diffuse albedo of the dEdd scheme (see alvdrn for the deferred-solve note), [-]"
    },
    "fswsfc": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "W/m^2",
     "default": 0.0,
     "description": "shortwave absorbed at the ice/snow surface fswsfc, the dEdd surface absorption of compute_dEdd_3bd (deferred; carried as a parameter), [W/m2]"
