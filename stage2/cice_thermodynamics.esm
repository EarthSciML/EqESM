     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "W/m^2/K",
     "default": 0.0,
     "description": "transfer coefficient for sensible heat (atmo_boundary_const, icepack_atmo.F90:493; wired from the assembly's atmo scheme), [W/m2/K]"
    },
    "lhcoef": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "W/m^2",
     "default": 0.0,
     "description": "transfer coefficient for latent heat, per unit specific-humidity difference: lhcoef = latncoef*Lheat*rhoa*wind (atmo_boundary_const, icepack_atmo.F90:494), so flatn = lhcoef*(Qa - Qsfc) is W/m2; wired from the assembly's atmo scheme, [W/m2]"
    },
    "sst": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "degC",
     "default": -1.8,
