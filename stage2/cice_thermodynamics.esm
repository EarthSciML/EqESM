        "ncat",
        "N_ILYR"
       ]
      },
      "args": [
       "kilyr"
      ]
     }
    },
    {
     "lhs": "zTin_top",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "ncat"
      ],
      "ranges": {
       "ncat": {
        "from": "ncat"
       }
      },
