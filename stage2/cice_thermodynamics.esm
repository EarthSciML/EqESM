        1
       ]
      },
      "args": [
       "kilyr"
      ]
     }
    },
    {
     "lhs": "kilyr_bot",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "ncat"
      ],
      "ranges": {
       "ncat": {
        "from": "ncat"
       }
      },
