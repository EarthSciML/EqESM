     "default": 0.0,
     "description": "snow depth difference between sea ice and pond ice, the persistent tracer of shortwave_dEdd_set_eff (dhsn = dhs, icepack_shortwave.F90:3591, 'constant until reset to 0'); carried as a parameter fed by the coupling (stage 3), [m]"
    },
    "ffracn": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "1",
     "default": 0.0,
     "description": "fraction of fsurfn used to melt the refrozen pond lid, the ffrac output of compute_ponds_sealvl (icepack_meltpond_sealvl.F90:188-193) consumed by set_eff; carried as a parameter fed by the coupling (stage 3), unpinnable from the stage-1 dumps, [-]"
    },
    "ipnd": {
     "type": "parameter",
     "shape": [
      "ncat"
     ],
     "units": "m",
     "default": 0.0,
     "description": "melt pond refrozen lid thickness (the ipnd tracer; ipnd = hlid under frzpnd = 'hlid', icepack_meltpond_sealvl.F90:261), carried as a parameter fed by the coupling (stage 3), [m]"
