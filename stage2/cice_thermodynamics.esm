       "zTin"
      ]
     }
    },
    {
     "lhs": "zTin_bot",
     "rhs": {
      "op": "faq",
      "output_idx": [
       "ncat"
      ],
      "ranges": {
       "ncat": {
        "from": "ncat"
       }
      },
