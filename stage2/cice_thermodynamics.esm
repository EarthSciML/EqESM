      "args": [],
      "name": "ice_conductivity_mush",
      "bindings": {
       "T": "zTin",
       "S": "zSin"
      }
     }
    },
    {
     "lhs": "kslyr",
     "rhs": {"op": "const", "args": [], "value": 0.3, "units": "W/m/K"}
    },
    {
     "lhs": "kilyr_top",
     "rhs": {
